.package-detail-page {
  min-height: 100vh;
  padding: var(--page-padding, 32rpx) 28rpx 180rpx;
  background: var(--bg-light);
  box-sizing: border-box;
}

.detail-hero,
.detail-section,
.empty-card {
  background: #fff;
  border: 2rpx solid var(--card-border, #f5f5f4);
  border-radius: var(--card-radius, 24rpx);
  padding: var(--card-padding, 32rpx);
  box-shadow: var(--card-shadow, 0 8rpx 24rpx rgba(0,0,0,0.03));
}

.detail-hero {
  margin-bottom: 24rpx;
}

.hero-kicker {
  color: var(--primary);
  font-size: 22rpx;
  font-weight: bold;
  letter-spacing: 0;
  margin-bottom: 10rpx;
}

.hero-title {
  font-size: 46rpx;
  font-weight: bold;
  color: var(--text-main);
  line-height: 1.2;
}

.hero-price {
  margin-top: 18rpx;
  color: var(--primary);
  font-size: 42rpx;
  font-weight: bold;
}

.hero-desc {
  margin-top: 14rpx;
  color: var(--text-muted);
  font-size: 26rpx;
  line-height: 1.7;
}

.hero-consult-btn,
.bottom-consult-btn {
  width: 100%;
  height: 94rpx;
  border: none;
  border-radius: var(--button-radius, 22rpx);
  background: var(--primary);
  color: #fff;
  font-size: 30rpx;
  font-weight: bold;
}

.hero-consult-btn {
  margin-top: 28rpx;
}

.hero-consult-btn::after,
.bottom-consult-btn::after {
  border: none;
}

.detail-section {
  margin-bottom: 24rpx;
}

.section-title,
.empty-title {
  color: var(--text-main);
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.empty-desc {
  color: var(--text-muted);
  font-size: 26rpx;
  line-height: 1.7;
}

.meta-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.meta-item {
  padding: 22rpx;
  border-radius: var(--card-radius, 18rpx);
  background: #fafaf9;
}

.meta-label {
  color: var(--text-muted);
  font-size: 22rpx;
  margin-bottom: 8rpx;
}

.meta-value {
  color: var(--text-main);
  font-size: 26rpx;
  font-weight: bold;
  line-height: 1.5;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #f5f5f4;
  color: #57534e;
  font-size: 23rpx;
}

.include-list,
.flow-item-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.include-item {
  color: #57534e;
  font-size: 26rpx;
  line-height: 1.7;
}

.include-item::before {
  content: "✓ ";
  color: var(--primary);
  font-weight: bold;
}

.series-row {
  display: inline-flex;
  gap: 20rpx;
}

.series-card {
  width: 360rpx;
  border-radius: var(--card-radius, 20rpx);
  background: #fafaf9;
  overflow: hidden;
}

.series-cover {
  width: 360rpx;
  height: 260rpx;
  background: #e7e5e4;
  border-radius: var(--image-radius, 0);
}

.series-info {
  padding: 18rpx;
}

.series-title {
  color: var(--text-main);
  font-size: 26rpx;
  font-weight: bold;
  margin-bottom: 6rpx;
}

.series-meta,
.testimonial-meta,
.flow-desc,
.faq-answer {
  color: var(--text-muted);
  font-size: 24rpx;
  line-height: 1.7;
}

.testimonial-card,
.faq-item,
.photographer-card {
  padding: 22rpx;
  border-radius: var(--card-radius, 18rpx);
  background: #fafaf9;
  margin-bottom: 16rpx;
}

.photographer-card {
  display: flex;
  gap: 18rpx;
}

.photographer-avatar {
  width: 92rpx;
  height: 92rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: #e7e5e4;
}

.photographer-info {
  flex: 1;
}

.photographer-name {
  color: var(--text-main);
  font-size: 27rpx;
  font-weight: bold;
  margin-bottom: 6rpx;
}

.photographer-title,
.photographer-bio {
  color: var(--text-muted);
  font-size: 24rpx;
  line-height: 1.65;
}

.testimonial-content {
  color: var(--text-main);
  font-size: 26rpx;
  line-height: 1.8;
  margin-bottom: 10rpx;
}

.flow-item {
  display: flex;
  gap: 18rpx;
  margin-bottom: 22rpx;
}

.flow-number {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(124,106,93,0.12);
  color: var(--primary);
  font-size: 22rpx;
  font-weight: bold;
}

.flow-title,
.faq-question {
  color: var(--text-main);
  font-size: 27rpx;
  font-weight: bold;
  margin-bottom: 6rpx;
}

.bottom-consult-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(255,255,255,0.96);
  box-shadow: 0 -8rpx 32rpx rgba(0,0,0,0.05);
  z-index: 20;
}
