.package-detail-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 var(--page-padding) 100rpx;
  background: var(--bg-light);
  color: var(--text-main);
  font-family: var(--font-family);
}

.empty-state {
  display: flex;
  min-height: 720rpx;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  text-align: center;
}

.empty-title {
  margin-top: 20rpx;
  font-size: 32rpx;
  font-weight: var(--title-weight);
}

.empty-desc {
  margin-top: 10rpx;
  color: var(--text-muted);
  font-size: 25rpx;
}

.detail-hero {
  padding: 56rpx 0 44rpx;
  border-bottom: 1rpx solid var(--divider);
}

.hero-label {
  color: var(--secondary);
  font-size: 23rpx;
  font-weight: 600;
}

.hero-title {
  margin-top: 10rpx;
  font-family: var(--title-font-family);
  font-size: 46rpx;
  font-weight: var(--title-weight);
  line-height: 1.2;
}

.hero-price {
  margin-top: 20rpx;
  color: var(--primary);
  font-size: 40rpx;
  font-weight: 650;
}

.hero-desc {
  max-width: 620rpx;
  margin-top: 12rpx;
  color: var(--text-muted);
  font-size: 26rpx;
  line-height: 1.65;
}

.hero-action {
  gap: 10rpx;
  width: fit-content;
  min-width: 280rpx;
  max-width: 100%;
  margin-top: 30rpx;
}

.detail-section {
  padding: 38rpx 0;
  border-bottom: 1rpx solid var(--divider);
}

.detail-section:last-of-type {
  border-bottom: 0;
}

.section-title {
  margin-bottom: 22rpx;
  font-size: 31rpx;
}

.meta-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 22rpx 24rpx;
}

.meta-item {
  display: flex;
  min-width: 0;
  align-items: flex-start;
  gap: 12rpx;
}

.meta-label {
  color: var(--text-muted);
  font-size: 22rpx;
}

.meta-value {
  margin-top: 4rpx;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.45;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.tag {
  padding: 8rpx 14rpx;
  border-radius: 6rpx;
  background: var(--surface-muted);
  color: var(--text-muted);
  font-size: 23rpx;
}

.include-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx 22rpx;
}

.include-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: var(--text-muted);
  font-size: 25rpx;
  line-height: 1.55;
}

.series-row {
  display: inline-flex;
  gap: 16rpx;
  padding-right: 8rpx;
}

.series-card {
  width: 330rpx;
  overflow: hidden;
  background: var(--surface);
  border: 1rpx solid var(--divider);
  border-radius: var(--card-radius);
}

.series-cover {
  width: 330rpx;
  height: 238rpx;
  background: var(--surface-muted);
}

.series-info {
  padding: 16rpx;
}

.series-title,
.person-name,
.flow-title,
.faq-question {
  font-size: 27rpx;
  font-weight: 600;
}

.series-meta,
.person-title,
.person-bio,
.testimonial-meta,
.flow-desc,
.faq-answer {
  margin-top: 5rpx;
  color: var(--text-muted);
  font-size: 24rpx;
  line-height: 1.6;
}

.person-item,
.testimonial-item,
.flow-item,
.faq-item {
  padding: 20rpx 0;
  border-top: 1rpx solid var(--divider);
}

.person-item:first-of-type,
.testimonial-item:first-of-type,
.flow-item:first-of-type,
.faq-item:first-of-type {
  padding-top: 0;
  border-top: 0;
}

.person-item {
  display: flex;
  gap: 18rpx;
}

.person-avatar {
  width: 92rpx;
  height: 92rpx;
  flex: 0 0 92rpx;
  border-radius: 50%;
  background: var(--surface-muted);
}

.person-info,
.flow-copy {
  min-width: 0;
}

.testimonial-content {
  font-family: var(--title-font-family);
  font-size: 27rpx;
  line-height: 1.75;
}

.flow-item {
  display: flex;
  gap: 16rpx;
}

.flow-number {
  display: flex;
  width: 36rpx;
  height: 36rpx;
  flex: 0 0 36rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--secondary);
  border-radius: 50%;
  color: var(--secondary);
  font-size: 21rpx;
  font-weight: 600;
}

.layout-compact .detail-hero {
  padding: 36rpx 0 30rpx;
}

.layout-compact .hero-title {
  font-size: 39rpx;
}

.layout-compact .hero-price {
  margin-top: 14rpx;
  font-size: 34rpx;
}

.layout-compact .hero-action {
  width: 100%;
  margin-top: 22rpx;
}

.layout-compact .detail-section {
  padding: 28rpx 0;
}

.layout-compact .section-title {
  margin-bottom: 16rpx;
  font-size: 28rpx;
}

/* V3 page skeletons */
.skeleton-editorial-detail .detail-hero {
  min-height: 470rpx;
  padding-top: 92rpx;
}

.skeleton-editorial-detail .hero-title {
  max-width: 580rpx;
  font-size: 58rpx;
}

.skeleton-editorial-detail .detail-section:nth-child(2n) {
  margin-right: calc(-1 * var(--page-padding));
  margin-left: calc(-1 * var(--page-padding));
  padding-right: var(--page-padding);
  padding-left: var(--page-padding);
  background: var(--surface);
}

.skeleton-compact-conversion .detail-hero {
  position: sticky;
  top: 0;
  z-index: 2;
  background: var(--bg-light);
}

.skeleton-compact-conversion .hero-action {
  width: 100%;
}
