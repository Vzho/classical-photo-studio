<view class="package-detail-page theme-{{themePreset}} layout-{{decoration.layoutVariant}}" style="{{themeStyle}}">
  <view class="empty-state" wx:if="{{!packageItem}}">
    <app-icon name="briefcase-business" size="44" tone="muted" />
    <view class="empty-title">这个{{terminology.packageLabel}}暂时无法查看</view>
    <view class="empty-desc">{{terminology.packageLabel}}可能已调整或下架，请返回重新选择。</view>
  </view>

  <block wx:else>
    <block wx:for="{{decoration.sections}}" wx:key="id" wx:for-item="section">
      <block wx:if="{{section.enabled}}">
        <view class="detail-hero" wx:if="{{section.type === 'hero'}}">
          <view class="section-title-row"><app-icon wx:if="{{section.icon}}" name="{{section.icon}}" size="26" tone="primary" /><view class="hero-label">{{section.title}}</view></view>
          <view class="hero-title">{{packageItem.name}}</view>
          <view class="hero-price">{{packageItem.priceText}}</view>
          <view class="hero-desc">{{packageItem.subtitle}}</view>
          <view wx:if="{{consultButtonVisible}}" class="btn-primary hero-action" bindtap="consultPackage">
            <app-icon name="message-circle" size="30" tone="inverse" />
            <text>{{consultButton.text || terminology.consultationLabel}}</text>
          </view>
        </view>

        <view class="detail-section" wx:if="{{section.type === 'info'}}">
          <view class="section-title-row"><app-icon wx:if="{{section.icon}}" name="{{section.icon}}" size="30" tone="primary" /><view class="section-title">{{section.title}}</view></view>
          <view class="section-subtitle" wx:if="{{section.subtitle}}">{{section.subtitle}}</view>
          <view class="meta-list">
            <view class="meta-item" wx:if="{{packageItem.duration}}">
              <app-icon name="clock-3" size="30" tone="muted" />
              <view><view class="meta-label">服务时长</view><view class="meta-value">{{packageItem.duration}}</view></view>
            </view>
            <view class="meta-item" wx:if="{{packageItem.retouchCount}}">
              <app-icon name="image" size="30" tone="muted" />
              <view><view class="meta-label">精修数量</view><view class="meta-value">{{packageItem.retouchCount}}</view></view>
            </view>
            <view class="meta-item" wx:if="{{packageItem.originalPhotos}}">
              <app-icon name="images" size="30" tone="muted" />
              <view><view class="meta-label">底片说明</view><view class="meta-value">{{packageItem.originalPhotos}}</view></view>
            </view>
            <view class="meta-item" wx:if="{{packageItem.makeupText}}">
              <app-icon name="sparkles" size="30" tone="muted" />
              <view><view class="meta-label">妆造说明</view><view class="meta-value">{{packageItem.makeupText}}</view></view>
            </view>
          </view>
        </view>

        <view class="detail-section" wx:if="{{section.type === 'suitable' && packageItem.suitableFor.length}}">
          <view class="section-title-row"><app-icon wx:if="{{section.icon}}" name="{{section.icon}}" size="30" tone="primary" /><view class="section-title">{{section.title}}</view></view>
          <view class="section-subtitle" wx:if="{{section.subtitle}}">{{section.subtitle}}</view>
          <view class="tag-list">
            <view class="tag" wx:for="{{packageItem.suitableFor}}" wx:key="*this" wx:for-item="tagItem">{{tagItem}}</view>
          </view>
        </view>

        <view class="detail-section" wx:if="{{section.type === 'includes' && packageItem.includes.length}}">
          <view class="section-title-row"><app-icon wx:if="{{section.icon}}" name="{{section.icon}}" size="30" tone="primary" /><view class="section-title">{{section.title}}</view></view>
          <view class="section-subtitle" wx:if="{{section.subtitle}}">{{section.subtitle}}</view>
          <view class="include-list">
            <view class="include-item" wx:for="{{packageItem.includes}}" wx:key="*this" wx:for-item="includeItem">
              <app-icon name="circle-check" size="28" tone="primary" />
              <text>{{includeItem}}</text>
            </view>
          </view>
        </view>

        <view class="detail-section" wx:if="{{section.type === 'relatedSeries' && relatedSeries.length}}">
          <view class="section-title-row"><app-icon wx:if="{{section.icon}}" name="{{section.icon}}" size="30" tone="primary" /><view class="section-title">{{section.title}}</view></view>
          <view class="section-subtitle" wx:if="{{section.subtitle}}">{{section.subtitle}}</view>
          <scroll-view scroll-x enhanced show-scrollbar="{{false}}">
            <view class="series-row">
              <view class="series-card" wx:for="{{relatedSeries}}" wx:key="id" wx:for-item="seriesItem" bindtap="openSeries" data-item="{{seriesItem}}">
                <image class="series-cover" src="{{seriesItem.imageUrl}}" mode="aspectFill" />
                <view class="series-info">
                  <view class="series-title">{{seriesItem.title}}</view>
                  <view class="series-meta">{{seriesItem.category}} · {{seriesItem.photoCount}} 张</view>
                </view>
              </view>
            </view>
          </scroll-view>
        </view>

        <view class="detail-section" wx:if="{{section.type === 'team' && photographers.length}}">
          <view class="section-title-row"><app-icon wx:if="{{section.icon}}" name="{{section.icon}}" size="30" tone="primary" /><view class="section-title">{{section.title}}</view></view>
          <view class="section-subtitle" wx:if="{{section.subtitle}}">{{section.subtitle}}</view>
          <view class="person-item" wx:for="{{photographers}}" wx:key="id">
            <image wx:if="{{item.avatar}}" class="person-avatar" src="{{item.avatar}}" mode="aspectFill" />
            <view class="person-info">
              <view class="person-name">{{item.name}}</view>
              <view class="person-title">{{item.title}}</view>
              <view class="person-bio">{{item.bio}}</view>
            </view>
          </view>
        </view>

        <view class="detail-section" wx:if="{{section.type === 'testimonials' && testimonials.length}}">
          <view class="section-title-row"><app-icon wx:if="{{section.icon}}" name="{{section.icon}}" size="30" tone="primary" /><view class="section-title">{{section.title}}</view></view>
          <view class="section-subtitle" wx:if="{{section.subtitle}}">{{section.subtitle}}</view>
          <view class="testimonial-item" wx:for="{{testimonials}}" wx:key="id">
            <view class="testimonial-content">“{{item.content}}”</view>
            <view class="testimonial-meta">{{item.name}} · {{item.shootType}} {{item.dateText}}</view>
          </view>
        </view>

        <view class="detail-section" wx:if="{{section.type === 'serviceFlow' && serviceFlow.enabled && serviceFlow.steps.length}}">
          <view class="section-title-row"><app-icon wx:if="{{section.icon}}" name="{{section.icon}}" size="30" tone="primary" /><view class="section-title">{{section.title}}</view></view>
          <view class="section-subtitle" wx:if="{{section.subtitle}}">{{section.subtitle}}</view>
          <view class="flow-item" wx:for="{{serviceFlow.steps}}" wx:key="title">
            <view class="flow-number">{{index + 1}}</view>
            <view class="flow-copy"><view class="flow-title">{{item.title}}</view><view class="flow-desc">{{item.description}}</view></view>
          </view>
        </view>

        <view class="detail-section" wx:if="{{section.type === 'faq' && faq.enabled && faq.items.length}}">
          <view class="section-title-row"><app-icon wx:if="{{section.icon}}" name="{{section.icon}}" size="30" tone="primary" /><view class="section-title">{{section.title}}</view></view>
          <view class="section-subtitle" wx:if="{{section.subtitle}}">{{section.subtitle}}</view>
          <view class="faq-item" wx:for="{{faq.items}}" wx:key="question">
            <view class="faq-question">{{item.question}}</view>
            <view class="faq-answer">{{item.answer}}</view>
          </view>
        </view>
      </block>
    </block>
  </block>

  <quick-jump wx:if="{{quickJumpVisible}}" current="package-detail" booking-text="{{quickJump.bookingText}}" portfolio-text="{{quickJump.portfolioText}}" appearance="{{quickJump.appearance}}" trigger-icon="{{quickJump.triggerIcon}}" booking-icon="{{quickJump.bookingIcon}}" portfolio-icon="{{quickJump.portfolioIcon}}" />
</view>
