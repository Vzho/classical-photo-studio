.stores-page {
  min-height: 100vh;
  padding-bottom: calc(var(--tab-bar-height, 108rpx) + env(safe-area-inset-bottom) + 52rpx);
  background: var(--bg-light);
  color: var(--text-main);
  font-family: var(--font-family);
}

.stores-hero {
  position: relative;
  height: 380rpx;
  overflow: hidden;
  background: var(--secondary);
}

.stores-hero-image {
  width: 100%;
  height: 100%;
}

.stores-hero-shade {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(15, 14, 13, 0.08), rgba(15, 14, 13, 0.76));
}

.stores-hero-copy {
  position: absolute;
  right: var(--page-padding);
  bottom: 46rpx;
  left: var(--page-padding);
  color: var(--on-media);
}

.stores-kicker {
  margin-bottom: 12rpx;
  color: var(--accent);
  font-size: 22rpx;
  font-weight: 700;
}

.stores-title {
  font-family: var(--title-font-family);
  font-size: 48rpx;
  font-weight: var(--title-weight);
  line-height: 1.2;
}

.stores-subtitle {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 24rpx;
}

.stores-list {
  padding: 34rpx var(--page-padding) 0;
}

.stores-module {
  padding-bottom: 28rpx;
}

.stores-section-heading {
  padding: 38rpx var(--page-padding) 0;
}

.stores-section-title,
.stores-contact-title {
  font-family: var(--title-font-family);
  font-size: 34rpx;
  font-weight: var(--title-weight);
}

.stores-section-subtitle,
.stores-contact text {
  display: block;
  margin-top: 8rpx;
  color: var(--text-muted);
  font-size: 24rpx;
  line-height: 1.6;
}

.store-card {
  margin-bottom: 24rpx;
  padding: 30rpx;
  border: 1rpx solid var(--divider);
  border-radius: var(--card-radius);
  background: var(--surface);
  box-shadow: var(--card-shadow);
}

.store-card-head {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.store-index {
  color: var(--accent);
  font-size: 22rpx;
  font-weight: 700;
}

.store-heading {
  min-width: 0;
  flex: 1;
}

.store-name {
  font-family: var(--title-font-family);
  font-size: 34rpx;
  font-weight: var(--title-weight);
  line-height: 1.3;
}

.store-hours {
  margin-top: 8rpx;
  color: var(--text-muted);
  font-size: 23rpx;
}

.store-row {
  display: grid;
  min-width: 0;
  padding: 26rpx 0;
  grid-template-columns: 36rpx minmax(0, 1fr) 28rpx;
  align-items: center;
  gap: 16rpx;
  border-bottom: 1rpx solid var(--divider);
}

.store-transport {
  grid-template-columns: 36rpx minmax(0, 1fr);
}

.store-row-copy {
  min-width: 0;
}

.store-row-copy text {
  display: block;
  margin-bottom: 5rpx;
  color: var(--text-muted);
  font-size: 21rpx;
}

.store-row-copy view {
  overflow-wrap: anywhere;
  font-size: 25rpx;
  line-height: 1.55;
}

.store-actions {
  display: flex;
  margin-top: 26rpx;
  flex-wrap: wrap;
  gap: 14rpx;
}

.store-action {
  display: flex;
  min-width: 0;
  height: var(--button-small-height);
  margin: 0;
  padding: 0 22rpx;
  flex: 1 1 180rpx;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border-radius: var(--button-radius);
  font-size: 24rpx;
  font-weight: var(--button-font-weight);
  line-height: 1;
}

.store-action::after {
  display: none;
}

.store-action.secondary {
  border: var(--button-border);
  background: var(--button-secondary-bg);
  color: var(--button-secondary-text);
}

.store-action.primary {
  border: 1rpx solid var(--button-bg);
  background: var(--button-bg);
  color: var(--button-text);
}

.stores-empty {
  display: flex;
  min-height: 420rpx;
  padding: 80rpx var(--page-padding);
  align-items: center;
  justify-content: center;
  flex-direction: column;
  color: var(--text-main);
}

.stores-empty view {
  margin-top: 18rpx;
  font-size: 30rpx;
  font-weight: 650;
}

.stores-empty text {
  margin-top: 8rpx;
  color: var(--text-muted);
  font-size: 24rpx;
}

.stores-contact {
  display: flex;
  margin: 24rpx var(--page-padding);
  padding: 30rpx;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  border-top: 1rpx solid var(--divider);
  border-bottom: 1rpx solid var(--divider);
}

.stores-contact-action {
  min-width: 190rpx;
  height: var(--button-small-height);
  margin: 0;
  padding: 0 24rpx;
  border-radius: var(--button-radius);
  background: var(--button-bg);
  color: var(--button-text);
  font-size: 24rpx;
  line-height: var(--button-small-height);
}

.stores-contact-action::after {
  display: none;
}

.skeleton-studio-profile .stores-hero {
  height: 680rpx;
}

.skeleton-studio-profile .stores-hero-copy {
  bottom: 72rpx;
}

.skeleton-studio-profile .stores-title {
  font-size: 58rpx;
}

.skeleton-studio-profile .store-card {
  padding: 0 0 34rpx;
  border-width: 0 0 1rpx;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}
