.dark-gallery-page {
  min-height: 100vh;
  padding-bottom: calc(112rpx + env(safe-area-inset-bottom));
  color: #f5f5f2;
  background: var(--bg-light, #111111);
  box-sizing: border-box;
}

.gallery-body {
  display: flex;
  min-height: calc(100vh - 200rpx - env(safe-area-inset-top) - env(safe-area-inset-bottom));
}

.gallery-categories {
  position: sticky;
  top: calc(88rpx + env(safe-area-inset-top));
  flex: none;
  width: 156rpx;
  height: calc(100vh - 200rpx - env(safe-area-inset-top) - env(safe-area-inset-bottom));
  background: #4a5054;
}

.gallery-category-track {
  padding: 10rpx 0 40rpx;
}

.gallery-category {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  min-height: 84rpx;
  padding: 24rpx 20rpx;
  overflow: hidden;
  color: #f1f1f1;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.gallery-category.active {
  color: var(--primary, #69d7d8);
  background: rgba(255, 255, 255, 0.04);
}

.gallery-category.active::after {
  position: absolute;
  top: 22rpx;
  right: 0;
  bottom: 22rpx;
  width: 4rpx;
  background: var(--primary, #69d7d8);
  content: '';
}

.gallery-content {
  flex: 1;
  min-width: 0;
  padding: 0 10rpx 36rpx;
}

.gallery-toolbar {
  display: flex;
  height: 86rpx;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.gallery-current {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 12rpx;
  overflow: hidden;
  font-size: 29rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.gallery-current-line {
  flex: 0 0 auto;
  width: 4rpx;
  height: 40rpx;
  background: var(--primary, #69d7d8);
}

.gallery-tools {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
}

.gallery-tool {
  position: relative;
  display: flex;
  width: 68rpx;
  height: 52rpx;
  align-items: center;
  justify-content: center;
}

.gallery-tool + .gallery-tool::before {
  position: absolute;
  top: 8rpx;
  bottom: 8rpx;
  left: 0;
  width: 1rpx;
  background: #d8d8d8;
  content: '';
}

.gallery-tool.active {
  color: var(--primary, #69d7d8);
}

.gallery-tool.active app-icon,
.gallery-nav-item.active app-icon {
  filter: brightness(0) saturate(100%) invert(90%) sepia(18%) saturate(1127%) hue-rotate(129deg) brightness(94%);
}

.gallery-search {
  display: flex;
  height: 68rpx;
  margin: 0 0 12rpx;
  padding: 0 18rpx;
  align-items: center;
  gap: 12rpx;
  border: 1rpx solid #343434;
  background: #181818;
}

.gallery-search input {
  flex: 1;
  color: #f5f5f2;
  font-size: 25rpx;
}

.gallery-search-placeholder {
  color: #747474;
}

.gallery-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx 10rpx;
}

.columns-3 .gallery-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx 7rpx;
}

.gallery-card {
  min-width: 0;
  overflow: hidden;
  background: #111111;
}

.gallery-card-media {
  width: 100%;
  height: 420rpx;
  overflow: hidden;
  background: #202020;
}

.columns-3 .gallery-card-media {
  height: 300rpx;
}

.gallery-image {
  width: 100%;
  height: 100%;
}

.gallery-card-copy {
  position: relative;
  min-height: 100rpx;
  padding: 15rpx 42rpx 12rpx 12rpx;
}

.gallery-card-copy app-icon {
  position: absolute;
  top: 13rpx;
  right: 8rpx;
}

.gallery-card-title {
  overflow: hidden;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.gallery-card-tags {
  display: flex;
  margin-top: 8rpx;
  gap: 8rpx;
  overflow: hidden;
  color: #b9b9b9;
  font-size: 20rpx;
  white-space: nowrap;
}

.gallery-empty {
  padding: 120rpx 20rpx;
  color: #777777;
  text-align: center;
}

.mode-top .gallery-body {
  display: block;
}

.mode-top .gallery-categories {
  position: static;
  width: 100%;
  height: auto;
  background: #111111;
}

.mode-top .gallery-category-track {
  display: flex;
  width: max-content;
  padding: 12rpx 16rpx;
}

.mode-top .gallery-category {
  width: auto;
  min-width: 120rpx;
  min-height: 58rpx;
  padding: 12rpx 22rpx;
  text-align: center;
}

.mode-top .gallery-category.active {
  color: #111111;
  background: var(--primary, #69d7d8);
}

.mode-top .gallery-category.active::after {
  display: none;
}

.mode-top .gallery-content {
  padding: 0 16rpx 36rpx;
}

.gallery-bottom-nav {
  position: fixed;
  z-index: 900;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  height: calc(112rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  color: #8d8d8d;
  background: rgba(15, 15, 15, 0.99);
  border-top: 1rpx solid #343434;
}

.gallery-nav-item {
  position: relative;
  display: flex;
  min-width: 0;
  flex: 1;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 4rpx;
  font-size: 22rpx;
}

.gallery-nav-item text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.gallery-nav-item.active {
  color: var(--primary, #69d7d8);
}
