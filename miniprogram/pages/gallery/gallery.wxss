.dark-gallery-page {
  min-height: 100vh;
  padding: 44rpx 0 calc(150rpx + env(safe-area-inset-bottom));
  color: #f5f5f2;
  background: #111;
  box-sizing: border-box;
}

.gallery-heading {
  padding: 10rpx 30rpx 34rpx;
  text-align: center;
}

.gallery-title { font-size: 42rpx; font-weight: 600; }
.gallery-subtitle { margin-top: 8rpx; color: #727272; font-size: 25rpx; letter-spacing: 0; }

.gallery-search {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 0 30rpx 28rpx;
  padding: 0 24rpx;
  height: 76rpx;
  border: 1rpx solid #343434;
  background: #181818;
}

.gallery-search input { flex: 1; color: #f5f5f2; font-size: 27rpx; }
.gallery-search-placeholder { color: #727272; }
.gallery-body { display: flex; min-height: 850rpx; }

.gallery-categories {
  flex: none;
  width: 164rpx;
  max-height: calc(100vh - 320rpx);
  background: #2b3032;
}

.gallery-category-track { padding: 10rpx 0 30rpx; }
.gallery-category {
  position: relative;
  padding: 27rpx 20rpx;
  color: #dadada;
  font-size: 27rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.gallery-category.active { color: #7de3e1; font-weight: 600; }
.gallery-category.active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 24rpx;
  bottom: 24rpx;
  width: 5rpx;
  background: #7de3e1;
}

.gallery-content { flex: 1; min-width: 0; padding: 0 18rpx 30rpx; }
.gallery-current {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 3rpx 0 24rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.gallery-current-line { width: 4rpx; height: 36rpx; background: #7de3e1; }
.gallery-current text { margin-left: auto; color: #747474; font-size: 22rpx; font-weight: 400; }
.gallery-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; }
.columns-3 .gallery-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8rpx; }
.gallery-card { position: relative; height: 470rpx; overflow: hidden; background: #1d1d1d; }
.columns-3 .gallery-card { height: 300rpx; }
.gallery-image { width: 100%; height: 100%; }
.gallery-card-shade { position: absolute; inset: 45% 0 0; background: linear-gradient(transparent, rgba(0,0,0,.86)); }
.gallery-card-copy { position: absolute; left: 18rpx; right: 18rpx; bottom: 20rpx; }
.gallery-card-title { color: #fff; font-size: 27rpx; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.gallery-card-tags { margin-top: 8rpx; color: #b9c0c0; font-size: 21rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.gallery-empty { padding: 120rpx 20rpx; color: #777; text-align: center; }

.mode-top .gallery-body { display: block; }
.mode-top .gallery-categories { width: 100%; max-height: none; background: transparent; }
.mode-top .gallery-category-track { display: flex; gap: 12rpx; padding: 0 30rpx 28rpx; }
.mode-top .gallery-category { padding: 18rpx 24rpx; border: 1rpx solid #303030; }
.mode-top .gallery-category.active { color: #111; background: #7de3e1; border-color: #7de3e1; }
.mode-top .gallery-category.active::before { display: none; }
.mode-top .gallery-content { padding: 0 30rpx 30rpx; }

.gallery-bottom-nav {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  display: flex;
  height: calc(112rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  color: #8d8d8d;
  background: rgba(15,15,15,.98);
  border-top: 1rpx solid #2b2b2b;
}

.gallery-nav-item { position: relative; flex: 1; display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 5rpx; font-size: 22rpx; }
.gallery-nav-item.active { color: #7de3e1; }
.nav-style-line .gallery-nav-item.active::before { content: ''; position: absolute; top: 0; width: 42rpx; height: 4rpx; background: #7de3e1; }
