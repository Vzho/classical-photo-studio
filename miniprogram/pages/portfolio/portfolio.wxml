<view wx:if="{{siteTemplate === 'dark-gallery'}}" class="dark-showcase-home {{decorationClass}} skeleton-{{homeDecoration.skeleton}}" style="{{themeStyle}} {{decorationStyle}}">
  <dark-site-header title="{{homeBanner.logoText}}" />
  <view class="dark-home-modules">
    <block wx:for="{{homeSections}}" wx:key="id" wx:for-item="section">
      <block wx:if="{{section.enabled && section.type === 'hero'}}">
        <swiper wx:if="{{bannerItems.length}}" class="dark-home-swiper" circular autoplay interval="5600" duration="900" indicator-dots="{{false}}">
          <swiper-item wx:for="{{bannerItems}}" wx:key="id" wx:for-item="bannerItem" bindtap="onBannerTap" data-item="{{bannerItem}}">
            <image class="dark-home-image" style="{{section.mediaStyle}}" src="{{bannerItem.imageUrl}}" mode="aspectFill" binderror="onBannerImageError" data-id="{{bannerItem.id}}" />
            <view class="dark-home-shade" style="{{section.overlayStyle}}"></view>
            <view class="dark-home-copy"><view class="dark-home-title">{{section.content.title || homeBanner.logoText}}</view><view class="dark-home-title-line"></view><view class="dark-home-description">{{section.content.subtitle || homeBanner.description || bannerItem.title}}</view></view>
            <view class="dark-home-action" catchtap="onShowcaseAction">{{section.content.actionText || showcase.heroActionText}}</view>
            <view class="dark-home-scroll-cue" catchtap="scrollToFeatured"><app-icon name="chevron-down" size="40" tone="inverse" /><app-icon name="chevron-down" size="40" tone="inverse" /></view>
          </swiper-item>
        </swiper>
        <view wx:else class="dark-home-empty"><view class="dark-home-copy"><view class="dark-home-title">{{section.content.title || homeBanner.logoText}}</view><view class="dark-home-title-line"></view><view class="dark-home-description">{{section.content.subtitle || homeBanner.description}}</view></view><view class="dark-home-action" bindtap="onShowcaseAction">{{section.content.actionText || showcase.heroActionText}}</view></view>
      </block>

      <view wx:elif="{{section.enabled && section.type === 'categories'}}" class="dark-home-featured dark-home-categories-section">
        <view class="dark-home-gallery-head"><text>{{section.content.title || showcase.galleryTitle}}</text><view class="dark-home-gallery-subtitle">{{section.content.subtitle || showcase.gallerySubtitle}}</view></view>
        <scroll-view class="dark-home-category-scroll" scroll-x enhanced show-scrollbar="{{false}}"><view class="dark-home-categories"><view wx:for="{{categories}}" wx:key="*this" class="dark-home-category-item {{activeCategory === item ? 'active' : ''}}" bindtap="onCategoryTap" data-category="{{item}}">{{item}}</view></view></scroll-view>
      </view>

      <view wx:elif="{{section.enabled && section.type === 'portfolio'}}" id="dark-home-featured" class="dark-home-featured dark-home-portfolio-section {{section.layoutClass}}">
        <view class="dark-home-grid">
          <view class="dark-home-card" wx:for="{{section.source.mode === 'auto' ? filteredItems : section.resolvedItems}}" wx:key="id" wx:for-item="portfolioItem" wx:if="{{index < section.source.limit}}" bindtap="onItemTap" data-item="{{portfolioItem}}">
            <image src="{{portfolioItem.imageUrl}}" style="{{section.mediaStyle}}" mode="aspectFill" lazy-load binderror="onItemImageError" data-id="{{portfolioItem.id}}" />
            <view class="dark-home-card-shade"></view><view wx:if="{{section.layout.showText}}" class="dark-home-card-title">{{portfolioItem.title}}</view>
          </view>
        </view>
        <view class="dark-home-gallery-action" bindtap="goGallery">{{section.content.actionText || '查看全部'}}{{terminology.workLabel}}</view>
      </view>

      <view wx:elif="{{section.enabled && section.type === 'packages' && packages.length}}" class="dark-home-summary-module"><view class="dark-home-summary-title">{{section.content.title}}</view><view wx:for="{{packages}}" wx:key="id" class="dark-home-summary-row"><text>{{item.name}}</text><text>{{item.priceText}}</text></view></view>
      <view wx:elif="{{section.enabled && section.type === 'schedule' && schedule.enabled}}" class="dark-home-summary-module"><view class="dark-home-summary-title">{{section.content.title || schedule.title}}</view><view class="dark-home-summary-copy">{{schedule.availableText}}</view></view>
      <view wx:elif="{{section.enabled && section.type === 'testimonials' && testimonials.length}}" class="dark-home-summary-module"><view class="dark-home-summary-title">{{section.content.title}}</view><view class="dark-home-summary-quote">“{{testimonials[0].content}}”</view></view>
      <decoration-block wx:elif="{{section.enabled && (section.type === 'richText' || section.type === 'image' || section.type === 'gallery' || section.type === 'action' || section.type === 'divider' || section.type === 'spacer')}}" module="{{section}}" />
    </block>
  </view>

  <dark-floating-actions wx:if="{{consultButtonVisible}}" contact-text="{{terminology.consultationLabel}}" bindcontact="goBooking" />
</view>

<view wx:else
  class="portfolio-page theme-{{themePreset}} {{decorationClass}} skeleton-{{homeDecoration.skeleton}} template-{{homeDecoration.template}} hero-{{homeDecoration.heroVariant}} gallery-{{homeDecoration.galleryVariant}} columns-{{homeDecoration.galleryColumns}} ratio-{{homeDecoration.imageRatio}} content-{{homeDecoration.cardContent}} gap-{{homeDecoration.galleryGap}}"
  style="{{themeStyle}} {{decorationStyle}}"
>
  <block wx:for="{{homeSections}}" wx:for-item="section" wx:key="id">
    <view wx:if="{{section.enabled && section.type === 'hero'}}" class="hero-section">
      <swiper
        wx:if="{{bannerItems.length}}"
        class="hero-swiper"
        circular
        autoplay
        interval="5000"
        duration="700"
        indicator-dots="{{bannerItems.length > 1}}"
        indicator-color="rgba(255,255,255,0.4)"
        indicator-active-color="#ffffff"
      >
        <swiper-item
          class="hero-slide"
          wx:for="{{bannerItems}}"
          wx:for-item="bannerItem"
          wx:key="id"
          bindtap="onBannerTap"
          data-item="{{bannerItem}}"
        >
          <image
            class="hero-image"
            style="{{section.mediaStyle}}"
            src="{{bannerItem.imageUrl}}"
            mode="aspectFill"
            binderror="onBannerImageError"
            data-id="{{bannerItem.id}}"
          />
          <view class="hero-shade" style="{{section.overlayStyle}}"></view>
          <view class="hero-brand">{{homeBanner.logoText}}</view>
          <view class="hero-content">
            <view class="hero-kicker">
              <view class="hero-kicker-line"></view>
              <text>{{homeBanner.tagText}}</text>
            </view>
            <view class="hero-title">{{bannerItem.title}}</view>
            <view class="hero-meta">{{bannerItem.category}}</view>
            <view wx:if="{{bannerItem.bannerDescription || homeBanner.description}}" class="hero-description">{{bannerItem.bannerDescription || homeBanner.description}}</view>
          </view>
        </swiper-item>
      </swiper>

      <view wx:else class="hero-fallback">
        <image wx:if="{{bannerUrl}}" class="hero-image" style="{{section.mediaStyle}}" src="{{bannerUrl}}" mode="aspectFill" binderror="onBannerError" />
        <view class="hero-shade" style="{{section.overlayStyle}}"></view>
        <view class="hero-brand">{{homeBanner.logoText}}</view>
        <view class="hero-content">
          <view class="hero-kicker">
            <view class="hero-kicker-line"></view>
            <text>{{homeBanner.tagText}}</text>
          </view>
          <view class="hero-title">{{homeBanner.logoText}}</view>
          <view wx:if="{{homeBanner.description}}" class="hero-description">{{homeBanner.description}}</view>
        </view>
      </view>
    </view>

    <scroll-view
      wx:elif="{{section.enabled && section.type === 'categories' && categories.length > 1}}"
      class="category-scroll"
      scroll-x
      enhanced
      show-scrollbar="{{false}}"
    >
      <view class="category-list">
        <view
          wx:for="{{categories}}"
          wx:for-item="categoryItem"
          wx:key="*this"
          class="category-item {{activeCategory === categoryItem ? 'active' : ''}}"
          bindtap="onCategoryTap"
          data-category="{{categoryItem}}"
        >
          <text class="category-index">0{{index + 1}}</text>
          <text>{{categoryItem}}</text>
        </view>
      </view>
    </scroll-view>

    <view wx:elif="{{section.enabled && section.type === 'shortcuts' && homeShortcuts.length}}" class="home-shortcuts" aria-label="常用入口">
      <view
        class="home-shortcut-item"
        wx:for="{{homeShortcuts}}"
        wx:for-item="shortcutItem"
        wx:key="key"
        bindtap="onHomeShortcutTap"
        data-key="{{shortcutItem.key}}"
      >
        <app-icon name="{{shortcutItem.icon}}" size="30" tone="primary" />
        <text>{{shortcutItem.text}}</text>
        <app-icon name="chevron-right" size="24" tone="muted" />
      </view>
    </view>

    <view wx:elif="{{section.enabled && section.type === 'portfolio'}}" class="page-section portfolio-section {{section.layoutClass}}">
      <view class="section-heading" wx:if="{{section.title || section.subtitle}}">
        <view class="section-heading-main">
          <view class="section-title-row" wx:if="{{section.title}}">
            <app-icon wx:if="{{section.icon}}" name="{{section.icon}}" size="30" tone="primary" />
            <view class="section-title">{{section.title}}</view>
          </view>
          <view class="section-subtitle" wx:if="{{section.subtitle}}">{{section.subtitle}}</view>
        </view>
        <view class="section-count">{{section.source.mode === 'auto' ? filteredItems.length : section.resolvedItems.length}} 组</view>
      </view>

      <view class="portfolio-grid">
        <view
          wx:for="{{section.source.mode === 'auto' ? filteredItems : section.resolvedItems}}"
          wx:for-item="portfolioItem"
          wx:key="id"
          class="portfolio-item"
          bindtap="onItemTap"
          data-item="{{portfolioItem}}"
        >
          <view class="item-image-wrap">
            <image
              class="item-image"
              style="{{section.mediaStyle}}"
              src="{{portfolioItem.imageUrl}}"
              mode="{{homeDecoration.imageRatio === 'natural' ? 'widthFix' : 'aspectFill'}}"
              lazy-load
              bindload="onImageLoad"
              binderror="onItemImageError"
              data-id="{{portfolioItem.id}}"
            />
            <view wx:if="{{portfolioItem.seriesId}}" class="series-badge">
              <app-icon name="images" size="22" tone="inverse" />
              <text>{{terminology.workLabel}}集</text>
            </view>
          </view>
          <view wx:if="{{homeDecoration.showTitle || homeDecoration.showCategory || homeDecoration.showDescription}}" class="item-info">
            <view wx:if="{{homeDecoration.showTitle}}" class="item-index">0{{index + 1}}</view>
            <view wx:if="{{homeDecoration.showTitle}}" class="item-title">{{portfolioItem.title}}</view>
            <view wx:if="{{homeDecoration.showCategory}}" class="item-meta">
              <text class="item-category">{{portfolioItem.category}}</text>
            </view>
            <view wx:if="{{homeDecoration.cardContent === 'full' && homePortfolioCard.showPhotoCount && portfolioItem.photoCount}}" class="photo-count">
              <app-icon name="images" size="20" tone="muted" />
              <text>{{portfolioItem.photoCount}} 张</text>
            </view>
            <view wx:if="{{homeDecoration.showDescription && portfolioItem.description}}" class="item-description">{{portfolioItem.description}}</view>
            <view wx:if="{{homeDecoration.cardContent === 'full' && homePortfolioCard.showTags && portfolioItem.tags && portfolioItem.tags.length}}" class="item-tags">
              <text wx:for="{{portfolioItem.tags}}" wx:for-item="tag" wx:key="*this" class="item-tag">{{tag}}</text>
            </view>
          </view>
        </view>
      </view>

      <view wx:if="{{!(section.source.mode === 'auto' ? filteredItems.length : section.resolvedItems.length)}}" class="empty-gallery">
        <app-icon name="images" size="44" tone="muted" />
        <text>当前分类还没有{{terminology.workLabel}}</text>
      </view>
    </view>

    <view wx:elif="{{section.enabled && section.type === 'packages' && packages.length}}" class="page-section package-section">
      <view class="section-heading">
        <view class="section-heading-main">
          <view class="section-title-row">
            <app-icon wx:if="{{section.icon}}" name="{{section.icon}}" size="30" tone="primary" />
            <view class="section-title">{{section.title}}</view>
          </view>
          <view class="section-subtitle" wx:if="{{section.subtitle}}">{{section.subtitle}}</view>
        </view>
        <view class="section-link" bindtap="goPackages" wx:if="{{section.actionText}}">
          <text>{{section.actionText}}</text>
          <app-icon name="chevron-right" size="24" tone="primary" />
        </view>
      </view>
      <scroll-view class="package-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="package-track">
          <view class="package-card" wx:for="{{packages}}" wx:for-item="packageItem" wx:key="id">
            <view class="package-card-head">
              <view class="package-name">{{packageItem.name}}</view>
              <view class="package-price">{{packageItem.priceText}}</view>
            </view>
            <view class="package-subtitle">{{packageItem.subtitle}}</view>
            <view class="package-action" bindtap="consultPackage" data-id="{{packageItem.id}}">
              <text>{{terminology.consultationLabel}}方案</text>
              <app-icon name="arrow-right" size="25" tone="primary" />
            </view>
          </view>
        </view>
      </scroll-view>
    </view>

    <view id="home-section-schedule" wx:elif="{{section.enabled && section.type === 'schedule' && schedule.enabled}}" class="page-section schedule-section">
      <view class="section-title-row">
        <app-icon wx:if="{{section.icon}}" name="{{section.icon}}" size="28" tone="primary" />
        <view class="schedule-label">{{section.title || schedule.title}}</view>
      </view>
      <view class="schedule-main">{{schedule.availableText}}</view>
      <view class="schedule-notice">{{schedule.notice}}</view>
      <view class="schedule-action" bindtap="goBooking">
        <text>{{section.actionText}}</text>
        <app-icon name="arrow-right" size="26" tone="primary" />
      </view>
    </view>

    <view id="home-section-testimonials" wx:elif="{{section.enabled && section.type === 'testimonials' && testimonials.length}}" class="page-section testimonial-section">
      <view class="section-heading">
        <view class="section-heading-main">
          <view class="section-title-row">
            <app-icon wx:if="{{section.icon}}" name="{{section.icon}}" size="30" tone="primary" />
            <view class="section-title">{{section.title}}</view>
          </view>
          <view class="section-subtitle" wx:if="{{section.subtitle}}">{{section.subtitle}}</view>
        </view>
      </view>
      <view class="testimonial-list">
        <view class="testimonial-item" wx:for="{{testimonials}}" wx:for-item="reviewItem" wx:key="id">
          <view class="testimonial-mark">“</view>
          <view class="testimonial-body">
            <view class="testimonial-content">{{reviewItem.content}}</view>
            <view class="testimonial-meta">{{reviewItem.name}} · {{reviewItem.shootType}} {{reviewItem.dateText}}</view>
          </view>
        </view>
      </view>
    </view>

    <view wx:elif="{{section.enabled && section.type === 'serviceFlow' && serviceFlow.enabled && serviceFlow.steps.length}}" class="page-section flow-section">
      <view class="section-heading">
        <view class="section-heading-main">
          <view class="section-title-row">
            <app-icon wx:if="{{section.icon}}" name="{{section.icon}}" size="30" tone="primary" />
            <view class="section-title">{{section.title}}</view>
          </view>
          <view class="section-subtitle" wx:if="{{section.subtitle}}">{{section.subtitle}}</view>
        </view>
      </view>
      <view class="flow-list">
        <view class="flow-item" wx:for="{{serviceFlow.steps}}" wx:for-item="flowItem" wx:key="title">
          <view class="flow-index">0{{index + 1}}</view>
          <view class="flow-copy">
            <view class="flow-title">{{flowItem.title}}</view>
            <view class="flow-description">{{flowItem.description}}</view>
          </view>
        </view>
      </view>
    </view>

    <decoration-block wx:elif="{{section.enabled && (section.type === 'richText' || section.type === 'image' || section.type === 'gallery' || section.type === 'action' || section.type === 'divider' || section.type === 'spacer')}}" module="{{section}}" />
  </block>

  <quick-jump
    wx:if="{{quickJumpVisible}}"
    current="portfolio"
    booking-text="{{quickJump.bookingText}}"
    portfolio-text="{{quickJump.portfolioText}}"
    appearance="{{quickJump.appearance}}"
    trigger-icon="{{quickJump.triggerIcon}}"
    booking-icon="{{quickJump.bookingIcon}}"
    portfolio-icon="{{quickJump.portfolioIcon}}"
  />
</view>
