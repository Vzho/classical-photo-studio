<!-- 作品集页面 -->
<view class="portfolio-page" style="{{themeStyle}}">
  <!-- Hero Banner Swiper -->
  <view class="hero-banner">
    <swiper 
      class="banner-swiper" 
      circular 
      autoplay 
      interval="5000" 
      duration="800"
      indicator-dots
      indicator-color="rgba(255,255,255,0.4)"
      indicator-active-color="#fff"
    >
      <swiper-item wx:for="{{bannerItems}}" wx:key="id" bindtap="onBannerTap" data-item="{{item}}">
        <image class="banner-image" src="{{item.imageUrl}}" mode="aspectFill" binderror="onBannerImageError" data-id="{{item.id}}" />
        <view class="banner-overlay">
          <view class="banner-header">
            <view class="logo">
              <text class="logo-text">{{homeBanner.logoText}}</text>
            </view>
          </view>
          <view class="banner-content">
            <view class="banner-tag">{{homeBanner.tagText}}</view>
            <text class="banner-season">{{item.category}}</text>
            <view class="banner-title">{{item.title}}</view>
            <view class="banner-desc">{{item.bannerDescription || homeBanner.description}}</view>
          </view>
        </view>
      </swiper-item>
    </swiper>
  </view>

  <!-- 分类筛选 -->
  <scroll-view class="category-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="category-list">
      <view 
        wx:for="{{categories}}" 
        wx:key="*this"
        class="category-item {{activeCategory === item ? 'active' : ''}}"
        bindtap="onCategoryTap"
        data-category="{{item}}"
      >
        {{item}}
      </view>
    </view>
  </scroll-view>

  <view class="home-module" wx:if="{{packages.length}}">
    <view class="module-header">
      <view>
        <view class="module-title">推荐套餐</view>
        <view class="module-desc">先了解价格范围，再发起拍摄咨询</view>
      </view>
      <view class="module-link" bindtap="goPackages">查看全部</view>
    </view>
    <scroll-view scroll-x enhanced show-scrollbar="{{false}}">
      <view class="package-row">
        <view class="package-card" wx:for="{{packages}}" wx:key="id">
          <view class="package-name">{{item.name}}</view>
          <view class="package-price">{{item.priceText}}</view>
          <view class="package-subtitle">{{item.subtitle}}</view>
          <button class="package-consult" bindtap="consultPackage" data-id="{{item.id}}">咨询此套餐</button>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="home-module" wx:if="{{schedule.enabled}}">
    <view class="module-title">{{schedule.title || '近期档期'}}</view>
    <view class="schedule-card">
      <view class="schedule-main">{{schedule.availableText}}</view>
      <view class="schedule-notice">{{schedule.notice || '档期仅供参考，具体拍摄时间请与摄影师确认。'}}</view>
      <button class="schedule-consult" bindtap="goBooking">咨询档期</button>
    </view>
  </view>

  <view class="home-module" wx:if="{{testimonials.length}}">
    <view class="module-header">
      <view>
        <view class="module-title">精选评价</view>
        <view class="module-desc">由摄影师在 CMS 中维护展示</view>
      </view>
    </view>
    <view class="testimonial-list">
      <view class="testimonial-card" wx:for="{{testimonials}}" wx:key="id">
        <view class="testimonial-content">“{{item.content}}”</view>
        <view class="testimonial-meta">{{item.name}} · {{item.shootType}} {{item.dateText}}</view>
      </view>
    </view>
  </view>

  <view class="portfolio-grid">
    <view 
      wx:for="{{filteredItems}}" 
      wx:key="id" 
      class="portfolio-item"
      bindtap="onItemTap"
      data-item="{{item}}"
    >
      <view class="item-image-wrap">
        <image 
          class="item-image" 
          src="{{item.imageUrl}}" 
          mode="widthFix" 
          lazy-load 
          bindload="onImageLoad"
          binderror="onItemImageError"
          data-id="{{item.id}}"
        />
        <view class="item-overlay">
          <text class="item-category-tag">{{item.category}}</text>
        </view>
        <!-- 系列标识 -->
        <view wx:if="{{item.seriesId}}" class="series-badge">
          <text class="series-icon">📷</text>
          <text class="series-text">系列</text>
        </view>
      </view>
      <view class="item-info">
        <view class="item-title">{{item.title}}</view>
        <view class="item-meta">
          <text class="item-category">{{item.category}}</text>
          <view class="item-likes">
            <text class="like-icon">♥</text>
            <text class="like-count">{{item.likes}}</text>
          </view>
        </view>
        <!-- 系列照片数量 -->
        <view wx:if="{{item.photoCount}}" class="photo-count">
          <text class="count-icon">📷</text>
          <text class="count-text">{{item.photoCount}}张</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 悬浮预约按钮 -->
  <view class="floating-booking-btn {{showFloatingBtn ? 'show' : ''}}" bindtap="goBooking">
    <text class="btn-icon">📅</text>
    <text class="btn-text">{{consultButton.text || '咨询拍摄'}}</text>
  </view>
</view>
