}

.portfolio-page.template-editorial-cover .hero-title {
  font-size: 58rpx;
}

.portfolio-page.template-split-catalog .hero-section,
.portfolio-page.template-split-catalog .hero-swiper,
.portfolio-page.template-split-catalog .hero-fallback {
  height: 610rpx;
  background: var(--surface);
}

.portfolio-page.template-split-catalog.hero-compact .hero-section,
.portfolio-page.template-split-catalog.hero-compact .hero-swiper,
.portfolio-page.template-split-catalog.hero-compact .hero-fallback {
  height: 520rpx;
}

.portfolio-page.template-split-catalog.hero-immersive .hero-section,
.portfolio-page.template-split-catalog.hero-immersive .hero-swiper,
.portfolio-page.template-split-catalog.hero-immersive .hero-fallback {
