}

.portfolio-page.template-gallery-wall.hero-compact .hero-section,
.portfolio-page.template-gallery-wall.hero-compact .hero-swiper,
.portfolio-page.template-gallery-wall.hero-compact .hero-fallback {
  height: 470rpx;
}

.portfolio-page.template-gallery-wall.hero-immersive .hero-section,
.portfolio-page.template-gallery-wall.hero-immersive .hero-swiper,
.portfolio-page.template-gallery-wall.hero-immersive .hero-fallback {
