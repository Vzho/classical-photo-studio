}

.portfolio-page.template-gallery-wall .portfolio-section {
  padding-right: 14rpx;
  padding-left: 14rpx;
}

.portfolio-page.template-service-led .hero-section,
.portfolio-page.template-service-led .hero-swiper,
.portfolio-page.template-service-led .hero-fallback {
  height: 590rpx;
  background: var(--surface);
}

.portfolio-page.template-service-led.hero-compact .hero-section,
.portfolio-page.template-service-led.hero-compact .hero-swiper,
.portfolio-page.template-service-led.hero-compact .hero-fallback {
  height: 510rpx;
}

.portfolio-page.template-service-led.hero-immersive .hero-section,
.portfolio-page.template-service-led.hero-immersive .hero-swiper,
.portfolio-page.template-service-led.hero-immersive .hero-fallback {
  height: 680rpx;
}

