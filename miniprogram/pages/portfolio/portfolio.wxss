.portfolio-page {
  min-height: 100vh;
  padding-bottom: calc(var(--tab-bar-height, 108rpx) + env(safe-area-inset-bottom) + 48rpx);
  overflow-x: hidden;
  background: var(--bg-light);
  color: var(--text-main);
  font-family: var(--font-family);
}

.hero-section,
.hero-swiper,
.hero-fallback {
  position: relative;
  width: 100%;
  height: 720rpx;
  overflow: hidden;
  background: var(--surface-muted);
}

.hero-immersive .hero-section,
.hero-immersive .hero-swiper,
.hero-immersive .hero-fallback {
  height: 800rpx;
}

.hero-compact .hero-section,
.hero-compact .hero-swiper,
.hero-compact .hero-fallback {
  height: 520rpx;
}

.hero-image {
  width: 100%;
  height: 100%;
}

.hero-shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: linear-gradient(180deg, rgba(15, 14, 13, 0.16) 0%, rgba(15, 14, 13, 0.08) 36%, rgba(15, 14, 13, 0.78) 100%);
}

.hero-brand {
  position: absolute;
  z-index: 2;
  top: calc(env(safe-area-inset-top) + 34rpx);
  left: var(--page-padding);
  max-width: 430rpx;
  overflow: hidden;
  color: var(--on-media);
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-content {
  position: absolute;
  z-index: 2;
  right: var(--page-padding);
  bottom: 64rpx;
  left: var(--page-padding);
  color: var(--on-media);
}

.hero-kicker {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 18rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.hero-kicker-line {
  width: 42rpx;
  height: 2rpx;
  background: var(--accent);
}

.hero-title {
  max-width: 620rpx;
  font-family: var(--title-font-family);
  font-size: 52rpx;
  font-weight: var(--title-weight);
  line-height: 1.12;
}

.hero-meta {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
}

.hero-description {
  max-width: 620rpx;
  margin-top: 16rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
  line-height: 1.55;
}

.hero-compact .hero-description,
.hero-compact .hero-meta {
  display: none;
}

.hero-compact .hero-content {
  bottom: 52rpx;
}

.hero-compact .hero-title {
  font-size: 48rpx;
}

.category-scroll {
  width: 100%;
  background: var(--bg-light);
  border-bottom: 1rpx solid var(--divider);
  white-space: nowrap;
}

.category-list {
  display: flex;
  gap: 34rpx;
  min-width: max-content;
  padding: 0 var(--page-padding);
}

.category-item {
  position: relative;
  flex: 0 0 auto;
  min-height: 82rpx;
  padding: 27rpx 0 21rpx;
  color: var(--text-muted);
  font-size: 25rpx;
  line-height: 1.3;
}

.category-item::after {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 3rpx;
  background: transparent;
  content: '';
}

.category-item.active {
  color: var(--text-main);
  font-weight: 600;
}

.category-item.active::after {
  background: var(--primary);
}

.page-section {
  box-sizing: border-box;
  width: 100%;
  padding: 52rpx var(--page-padding) 24rpx;
}

.section-count {
  flex: 0 0 auto;
  padding-bottom: 4rpx;
  color: var(--text-muted);
  font-size: 22rpx;
}

.portfolio-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 36rpx 18rpx;
}

.columns-1 .portfolio-grid {
  grid-template-columns: minmax(0, 1fr);
  gap: 48rpx;
}

.gallery-masonry .portfolio-grid {
  display: block;
  column-count: 2;
  column-gap: 18rpx;
}

.gallery-masonry.columns-1 .portfolio-grid {
  column-count: 1;
}

.portfolio-item {
  display: inline-block;
  box-sizing: border-box;
  width: 100%;
  margin-bottom: 34rpx;
  overflow: hidden;
  vertical-align: top;
  break-inside: avoid;
}

.gallery-editorial .portfolio-item,
.gallery-cards .portfolio-item {
  display: block;
  margin-bottom: 0;
}

.gallery-cards .portfolio-item {
  background: var(--surface);
  border: 1rpx solid var(--divider);
  border-radius: var(--card-radius);
}

.item-image-wrap {
  position: relative;
  width: 100%;
  height: 452rpx;
  overflow: hidden;
  background: var(--surface-muted);
  border-radius: var(--image-radius);
}

.columns-1 .item-image-wrap {
  height: 770rpx;
}

.ratio-square .item-image-wrap {
  height: 339rpx;
}

.ratio-square.columns-1 .item-image-wrap {
  height: 694rpx;
}

.ratio-natural .item-image-wrap {
  height: auto;
  min-height: 260rpx;
}

.item-image {
  width: 100%;
  height: 100%;
}

.ratio-natural .item-image {
  height: auto;
}

.series-badge {
  position: absolute;
  top: 14rpx;
  right: 14rpx;
  display: flex;
  align-items: center;
  gap: 7rpx;
  min-height: 42rpx;
  padding: 0 12rpx;
  background: rgba(24, 23, 21, 0.68);
  color: #fff;
  font-size: 19rpx;
  line-height: 1;
}

.item-info {
  padding: 15rpx 2rpx 0;
}

.gallery-cards .item-info {
  padding: 20rpx;
}

.item-title {
  overflow: hidden;
  color: var(--text-main);
  font-family: var(--title-font-family);
  font-size: 28rpx;
  font-weight: var(--title-weight);
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.columns-1 .item-title {
  font-size: 34rpx;
}

.item-meta {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 18rpx;
  margin-top: 8rpx;
  color: var(--text-muted);
  font-size: 22rpx;
}

.item-category {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.photo-count {
  display: flex;
  align-items: center;
  gap: 6rpx;
  white-space: nowrap;
}

.photo-count {
  margin-top: 10rpx;
  color: var(--text-muted);
  font-size: 21rpx;
}

.item-description {
  display: -webkit-box;
  margin-top: 12rpx;
  overflow: hidden;
  color: var(--text-muted);
  font-size: 22rpx;
  line-height: 1.55;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.item-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 16rpx;
  margin-top: 14rpx;
}

.item-tag {
  color: var(--secondary);
  font-size: 20rpx;
}

.empty-gallery {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  min-height: 320rpx;
  color: var(--text-muted);
  font-size: 24rpx;
}

.package-scroll {
  width: calc(100% + var(--page-padding));
}

.package-track {
  display: flex;
  gap: 18rpx;
  width: max-content;
  padding-right: var(--page-padding);
}

.package-card {
  box-sizing: border-box;
  width: 480rpx;
  min-height: 256rpx;
  padding: 28rpx;
  background: var(--surface);
  border: 1rpx solid var(--divider);
  border-left: 4rpx solid var(--accent);
  border-radius: var(--card-radius);
}

.package-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.package-name {
  flex: 1;
  color: var(--text-main);
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.35;
}

.package-price {
  flex: 0 0 auto;
  color: var(--primary);
  font-family: var(--title-font-family);
  font-size: 30rpx;
  font-weight: var(--title-weight);
}

.package-subtitle {
  min-height: 72rpx;
  margin-top: 18rpx;
  color: var(--text-muted);
  font-size: 23rpx;
  line-height: 1.55;
}

.package-action,
.schedule-action {
  display: flex;
  align-items: center;
  gap: 8rpx;
  width: fit-content;
  margin-top: 24rpx;
  color: var(--primary);
  font-size: 24rpx;
  font-weight: 600;
}

.schedule-section {
  margin-top: 34rpx;
  padding-top: 44rpx;
  padding-bottom: 44rpx;
  background: var(--surface-muted);
  border-top: 1rpx solid var(--divider);
  border-bottom: 1rpx solid var(--divider);
}

.schedule-label {
  color: var(--secondary);
  font-size: 22rpx;
  font-weight: 600;
}

.schedule-main {
  margin-top: 12rpx;
  color: var(--text-main);
  font-family: var(--title-font-family);
  font-size: 38rpx;
  font-weight: var(--title-weight);
  line-height: 1.3;
}

.schedule-notice {
  max-width: 620rpx;
  margin-top: 14rpx;
  color: var(--text-muted);
  font-size: 23rpx;
}

.testimonial-list {
  border-top: 1rpx solid var(--divider);
}

.testimonial-item {
  display: flex;
  gap: 22rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--divider);
}

.testimonial-mark {
  flex: 0 0 auto;
  color: var(--accent);
  font-family: serif;
  font-size: 68rpx;
  line-height: 0.8;
}

.testimonial-body {
  min-width: 0;
}

.testimonial-content {
  color: var(--text-main);
  font-size: 27rpx;
  line-height: 1.7;
}

.testimonial-meta {
  margin-top: 14rpx;
  color: var(--text-muted);
  font-size: 21rpx;
}

.flow-list {
  border-top: 1rpx solid var(--divider);
}

.flow-item {
  display: grid;
  grid-template-columns: 72rpx minmax(0, 1fr);
  gap: 22rpx;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--divider);
}

.flow-index {
  color: var(--accent);
  font-family: var(--title-font-family);
  font-size: 24rpx;
  font-weight: 600;
}

.flow-title {
  color: var(--text-main);
  font-size: 27rpx;
  font-weight: 600;
}

.flow-description {
  margin-top: 6rpx;
  color: var(--text-muted);
  font-size: 23rpx;
  line-height: 1.55;
}
