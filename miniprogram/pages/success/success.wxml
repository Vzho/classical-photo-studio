<view class="success-page theme-{{themePreset}} {{decorationClass}} skeleton-{{decoration.skeleton}} layout-{{decoration.layoutVariant}}" style="{{themeStyle}} {{decorationStyle}}">
  <block wx:for="{{decoration.sections}}" wx:key="id" wx:for-item="section">
    <block wx:if="{{section.enabled}}">
      <view class="success-header" wx:if="{{section.type === 'hero'}}">
        <view class="success-icon"><app-icon name="{{section.icon || 'circle-check'}}" size="54" tone="inverse" /></view>
        <view class="success-title">{{section.title}}</view>
        <view class="success-desc" wx:if="{{section.subtitle}}">{{section.subtitle}}</view>
      </view>

      <view class="empty-state" wx:if="{{section.type === 'summary' && !consultation}}">
        <view class="empty-title">暂无{{terminology.consultationLabel}}内容</view>
        <view class="empty-desc">请先填写预约{{terminology.consultationLabel}}，再回到这里查看生成结果。</view>
        <view class="btn-primary empty-action" bindtap="goBooking">
          <text>填写{{terminology.consultationLabel}}</text>
          <app-icon name="arrow-right" size="28" tone="inverse" />
        </view>
      </view>

      <view class="result-section" wx:if="{{section.type === 'summary' && consultation}}">
        <view class="section-title-row"><app-icon wx:if="{{section.icon}}" name="{{section.icon}}" size="30" tone="primary" /><view class="section-title">{{section.title}}</view></view>
        <view class="section-subtitle" wx:if="{{section.subtitle}}">{{section.subtitle}}</view>
        <view class="summary-list">
          <view class="summary-item" wx:for="{{summaryItems}}" wx:key="label">
            <view class="summary-label">{{item.label}}</view>
            <view class="summary-value">{{item.value}}</view>
          </view>
        </view>
      </view>

      <view class="result-section" wx:if="{{section.type === 'content' && consultation}}">
        <view class="section-title-row"><app-icon wx:if="{{section.icon}}" name="{{section.icon}}" size="30" tone="primary" /><view class="section-title">{{section.title}}</view></view>
        <view class="section-subtitle" wx:if="{{section.subtitle}}">{{section.subtitle}}</view>
        <view class="consultation-text">{{consultation.text}}</view>
      </view>

      <view class="contact-row" wx:if="{{section.type === 'contact' && consultation && consultation.photographerWechat}}">
        <view class="contact-copy">
          <view class="section-title-row"><app-icon wx:if="{{section.icon}}" name="{{section.icon}}" size="26" tone="primary" /><view class="contact-label">{{section.title}}</view></view>
          <view class="contact-value">{{consultation.photographerWechat}}</view>
        </view>
        <view class="copy-control" bindtap="copyWechat">
          <app-icon name="copy" size="27" />
          <text>复制</text>
        </view>
      </view>

      <view class="result-actions" wx:if="{{section.type === 'actions' && consultation}}">
        <view class="btn-primary action-button" bindtap="copyConsultation">
          <app-icon name="copy" size="29" tone="inverse" />
          <text>{{section.actionText}}</text>
        </view>
        <view wx:if="{{consultation.photographerWechat}}" class="btn-secondary action-button" bindtap="contactPhotographer">
          <app-icon name="message-circle" size="29" />
          <text>联系{{terminology.customerServiceLabel}}确定日期</text>
        </view>
        <view class="secondary-links">
          <view bindtap="goPackages">查看{{terminology.packageLabel}}</view>
          <view bindtap="goHome">返回{{quickJump.portfolioText}}</view>
        </view>
      </view>

      <decoration-block wx:if="{{section.type === 'richText' || section.type === 'image' || section.type === 'gallery' || section.type === 'action' || section.type === 'divider' || section.type === 'spacer'}}" module="{{section}}" />
    </block>
  </block>

  <quick-jump wx:if="{{quickJumpVisible}}" current="success" booking-text="{{quickJump.bookingText}}" portfolio-text="{{quickJump.portfolioText}}" appearance="{{quickJump.appearance}}" trigger-icon="{{quickJump.triggerIcon}}" booking-icon="{{quickJump.bookingIcon}}" portfolio-icon="{{quickJump.portfolioIcon}}" />
</view>
