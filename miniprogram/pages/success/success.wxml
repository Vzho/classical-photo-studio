<!-- 咨询结果页面 -->
<view class="success-page">
  <view class="success-icon-wrap">
    <view class="icon-pulse"></view>
    <view class="success-icon">
      <text class="check-mark">✓</text>
    </view>
  </view>

  <view class="success-info">
    <view class="success-title">咨询信息已生成</view>
    <view class="success-desc">
      咨询内容已生成，请发送给摄影师。最终拍摄时间和方案以双方沟通确认为准。
    </view>
  </view>

  <view class="empty-card" wx:if="{{!consultation}}">
    <view class="empty-title">暂无咨询内容</view>
    <view class="empty-desc">请先填写预约咨询表单，生成咨询内容后再查看。</view>
    <button class="btn-primary" bindtap="goBooking">去填写咨询</button>
  </view>

  <view wx:else class="result-content">
    <view class="summary-card">
      <view class="card-title">咨询摘要</view>
      <view class="summary-list">
        <view class="summary-item" wx:for="{{summaryItems}}" wx:key="label">
          <view class="summary-label">{{item.label}}</view>
          <view class="summary-value">{{item.value}}</view>
        </view>
      </view>
    </view>

    <view class="text-card">
      <view class="card-title">可复制咨询内容</view>
      <view class="consultation-text">{{consultation.text}}</view>
    </view>

    <view class="wechat-card" wx:if="{{consultation.photographerWechat}}">
      <view>
        <view class="wechat-label">摄影师微信</view>
        <view class="wechat-value">{{consultation.photographerWechat}}</view>
      </view>
      <button class="mini-copy-btn" bindtap="copyWechat">复制</button>
    </view>
  </view>

  <view class="bottom-actions">
    <button wx:if="{{consultation}}" class="btn-primary" bindtap="copyConsultation">复制咨询内容</button>
    <button wx:if="{{consultation}}" class="btn-secondary" bindtap="contactPhotographer">联系摄影师确认档期</button>
    <button class="btn-secondary" bindtap="goPackages">查看套餐</button>
    <button class="btn-plain" bindtap="goHome">返回作品集</button>
  </view>
</view>
