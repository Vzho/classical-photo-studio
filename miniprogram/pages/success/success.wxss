.success-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 52rpx var(--page-padding) 110rpx;
  background: var(--bg-light);
  color: var(--text-main);
  font-family: var(--font-family);
}

.success-header {
  max-width: 620rpx;
  margin: 0 auto 44rpx;
  text-align: center;
}

.success-icon {
  display: flex;
  width: 94rpx;
  height: 94rpx;
  margin: 0 auto 22rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--secondary);
}

.success-title {
  font-family: var(--title-font-family);
  font-size: 42rpx;
  font-weight: var(--title-weight);
  line-height: 1.25;
}

.success-desc,
.empty-desc,
.summary-label,
.contact-label {
  color: var(--text-muted);
  font-size: 25rpx;
  line-height: 1.65;
}

.success-desc {
  margin-top: 12rpx;
}

.empty-state {
  display: flex;
  min-height: 440rpx;
  padding: 48rpx 0;
  align-items: center;
  flex-direction: column;
  text-align: center;
  border-top: 1rpx solid var(--divider);
}

.empty-title {
  font-size: 31rpx;
  font-weight: 600;
}

.empty-desc {
  margin-top: 10rpx;
}

.empty-action {
  gap: 9rpx;
  width: 280rpx;
  margin-top: 28rpx;
}

.result-section {
  padding: 34rpx 0;
  border-top: 1rpx solid var(--divider);
}

.section-title {
  margin-bottom: 22rpx;
  font-size: 31rpx;
}

.summary-list {
  display: flex;
  flex-direction: column;
}

.summary-item {
  display: grid;
  grid-template-columns: 170rpx minmax(0, 1fr);
  gap: 18rpx;
  padding: 14rpx 0;
  border-top: 1rpx solid var(--divider);
}

.summary-item:first-child {
  padding-top: 0;
  border-top: 0;
}

.summary-value {
  min-width: 0;
  font-size: 26rpx;
  line-height: 1.6;
  word-break: break-all;
}

.consultation-text {
  padding: 24rpx;
  border-left: 4rpx solid var(--secondary);
  background: var(--surface);
  color: var(--text-main);
  font-size: 25rpx;
  line-height: 1.8;
  white-space: pre-wrap;
}

.contact-row {
  display: flex;
  padding: 26rpx 0;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  border-top: 1rpx solid var(--divider);
  border-bottom: 1rpx solid var(--divider);
}

.contact-copy {
  min-width: 0;
}

.contact-value {
  margin-top: 4rpx;
  font-size: 29rpx;
  font-weight: 600;
  word-break: break-all;
}

.copy-control {
  display: flex;
  min-height: 64rpx;
  padding: 0 18rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border: 1rpx solid var(--divider);
  border-radius: var(--button-radius);
  font-size: 24rpx;
  font-weight: 600;
}

.result-actions {
  display: flex;
  padding-top: 36rpx;
  flex-direction: column;
  gap: 14rpx;
}

.action-button {
  gap: 10rpx;
  width: 100%;
}

.secondary-links {
  display: flex;
  padding-top: 10rpx;
  justify-content: center;
  gap: 44rpx;
  color: var(--text-muted);
  font-size: 25rpx;
}

.layout-compact .success-header {
  display: grid;
  max-width: none;
  margin-bottom: 30rpx;
  grid-template-columns: 76rpx minmax(0, 1fr);
  column-gap: 20rpx;
  text-align: left;
}

.layout-compact .success-icon {
  width: 76rpx;
  height: 76rpx;
  margin: 0;
  grid-row: 1 / 3;
}

.layout-compact .success-title {
  align-self: end;
  font-size: 34rpx;
}

.layout-compact .success-desc {
  margin-top: 4rpx;
}

.layout-compact .result-section {
  padding: 26rpx 0;
}
