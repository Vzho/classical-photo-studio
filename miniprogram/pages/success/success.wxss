/* 咨询结果页 */
.success-page {
  min-height: 100vh;
  padding: 56rpx 32rpx 320rpx;
  background: #fafaf9;
  box-sizing: border-box;
}

.success-icon-wrap {
  position: relative;
  width: 168rpx;
  height: 168rpx;
  margin: 0 auto 36rpx;
}

.icon-pulse {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 168rpx;
  height: 168rpx;
  background: rgba(124,106,93,0.12);
  border-radius: 50%;
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { transform: translate(-50%, -50%) scale(1); opacity: 1; }
  50% { transform: translate(-50%, -50%) scale(1.12); opacity: 0.55; }
}

.success-icon {
  position: relative;
  width: 132rpx;
  height: 132rpx;
  margin: 18rpx;
  background: var(--primary);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 24rpx 52rpx rgba(124,106,93,0.28);
}

.check-mark {
  font-size: 62rpx;
  color: #fff;
  font-weight: bold;
}

.success-info {
  text-align: center;
  margin-bottom: 36rpx;
}

.success-title {
  font-size: 44rpx;
  font-weight: bold;
  color: var(--text-main);
  margin-bottom: 18rpx;
}

.success-desc {
  font-size: 26rpx;
  color: var(--text-muted);
  line-height: 1.8;
}

.result-content {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.summary-card,
.text-card,
.wechat-card,
.empty-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  border: 2rpx solid #f5f5f4;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.03);
}

.card-title,
.empty-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-main);
  margin-bottom: 22rpx;
}

.empty-card {
  text-align: center;
}

.empty-desc {
  margin-bottom: 28rpx;
  font-size: 26rpx;
  color: var(--text-muted);
  line-height: 1.7;
}

.summary-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.summary-item {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  font-size: 26rpx;
}

.summary-label {
  flex-shrink: 0;
  color: var(--text-muted);
}

.summary-value {
  color: var(--text-main);
  text-align: right;
  word-break: break-all;
}

.consultation-text {
  padding: 24rpx;
  border-radius: 18rpx;
  background: #fafaf9;
  color: #44403c;
  font-size: 25rpx;
  line-height: 1.8;
  white-space: pre-wrap;
}

.wechat-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.wechat-label {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-bottom: 6rpx;
}

.wechat-value {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-main);
}

.mini-copy-btn {
  flex-shrink: 0;
  height: 72rpx;
  padding: 0 28rpx;
  border: none;
  border-radius: 16rpx;
  background: rgba(124,106,93,0.1);
  color: var(--primary);
  font-size: 26rpx;
  font-weight: bold;
}

.mini-copy-btn::after {
  border: none;
}

.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  background: rgba(255,255,255,0.96);
  box-shadow: 0 -8rpx 32rpx rgba(0,0,0,0.05);
  z-index: 10;
}

.btn-primary,
.btn-secondary,
.btn-plain {
  width: 100%;
  height: 92rpx;
  border-radius: 22rpx;
  border: none;
  font-size: 30rpx;
  font-weight: bold;
}

.btn-primary {
  background: var(--primary);
  color: #fff;
}

.btn-secondary {
  background: #f5f5f4;
  color: #57534e;
}

.btn-plain {
  background: transparent;
  color: #78716c;
}

.btn-primary::after,
.btn-secondary::after,
.btn-plain::after {
  border: none;
}
