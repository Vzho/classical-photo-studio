/* 成功页面样式 */
.success-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 64rpx 48rpx;
  background: #fff;
}

/* 成功图标 */
.success-icon-wrap {
  position: relative;
  margin-bottom: 48rpx;
}

.icon-pulse {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 280rpx;
  height: 280rpx;
  background: rgba(124,106,93,0.1);
  border-radius: 50%;
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { transform: translate(-50%, -50%) scale(1); opacity: 1; }
  50% { transform: translate(-50%, -50%) scale(1.1); opacity: 0.5; }
}

.success-icon {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  background: var(--primary);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 32rpx 64rpx rgba(124,106,93,0.4);
}

.check-mark {
  font-size: 80rpx;
  color: #fff;
  font-weight: bold;
}

/* 成功信息 */
.success-info {
  text-align: center;
  margin-bottom: 48rpx;
  max-width: 500rpx;
}

.success-title {
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 24rpx;
}

.success-desc {
  font-size: 28rpx;
  color: #78716c;
  line-height: 1.8;
}

.highlight {
  color: var(--primary);
  font-weight: bold;
}

/* 流程卡片 */
.steps-card {
  width: 100%;
  background: #fafaf9;
  border-radius: 32rpx;
  padding: 40rpx;
  border: 2rpx solid #f5f5f4;
}

.steps-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 32rpx;
}

.steps-icon {
  font-size: 32rpx;
}

.steps-title {
  font-size: 30rpx;
  font-weight: bold;
}

.steps-list {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.step-item {
  display: flex;
  gap: 20rpx;
}

.step-number {
  width: 40rpx;
  height: 40rpx;
  background: rgba(124,106,93,0.2);
  color: var(--primary);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: bold;
  flex-shrink: 0;
}

.step-content {
  flex: 1;
}

.step-title {
  font-size: 26rpx;
  font-weight: bold;
  margin-bottom: 4rpx;
}

.step-desc {
  font-size: 22rpx;
  color: #78716c;
}

/* 底部按钮 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 48rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.btn-secondary {
  width: 100%;
  height: 96rpx;
  background: #f5f5f4;
  color: #57534e;
  font-size: 30rpx;
  font-weight: bold;
  border-radius: 24rpx;
  border: none;
}

.btn-secondary::after {
  border: none;
}
