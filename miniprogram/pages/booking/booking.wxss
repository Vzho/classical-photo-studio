/* 预约页面样式 */
.booking-page {
  min-height: 100vh;
  background: var(--bg-light);
  padding-bottom: 280rpx;
}

.booking-banner {
  position: relative;
  height: 320rpx;
  overflow: hidden;
}

.banner-img {
  width: 100%;
  height: 100%;
  opacity: 0.7;
}

.banner-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 32rpx;
  background: linear-gradient(to top, rgba(0,0,0,0.6), transparent);
}

.banner-tag {
  display: inline-block;
  background: rgba(124,106,93,0.8);
  color: #fff;
  font-size: 20rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  margin-bottom: 12rpx;
}

.banner-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
}

.banner-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255,255,255,0.9);
  line-height: 1.6;
}

.notice-card,
.info-card,
.content-module {
  margin: 28rpx 32rpx 0;
  padding: var(--card-padding, 28rpx);
  background: #fff;
  border: 2rpx solid var(--card-border, #f5f5f4);
  border-radius: var(--card-radius, 20rpx);
  box-shadow: var(--card-shadow, none);
}

.notice-title,
.info-card-title,
.module-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-main);
  margin-bottom: 12rpx;
}

.notice-text,
.schedule-notice,
.flow-desc,
.faq-answer {
  font-size: 24rpx;
  color: var(--text-muted);
  line-height: 1.7;
}

.schedule-available {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--primary);
  margin-bottom: 10rpx;
}

.note-list {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.note-item {
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  background: #fafaf9;
  font-size: 24rpx;
  color: #57534e;
}

/* 表单区域 */
.form-section {
  padding: 32rpx;
}

.form-item {
  margin-bottom: 40rpx;
}

.form-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.label-icon {
  font-size: 32rpx;
}

.form-input {
  width: 100%;
  height: 100rpx;
  padding: 0 28rpx;
  background: #fafaf9;
  border: 2rpx solid #e7e5e4;
  border-radius: var(--button-radius, 20rpx);
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-input:focus {
  border-color: var(--primary);
}

.date-picker {
  display: flex;
  align-items: center;
}

.date-picker.placeholder {
  color: #a8a29e;
}

.form-textarea {
  width: 100%;
  height: 200rpx;
  padding: 24rpx 28rpx;
  background: #fafaf9;
  border: 2rpx solid #e7e5e4;
  border-radius: var(--button-radius, 20rpx);
  font-size: 28rpx;
  box-sizing: border-box;
}

/* 风格选择 */
.style-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--section-gap, 20rpx);
}

.style-item {
  padding: var(--card-padding, 28rpx);
  text-align: center;
  background: #fafaf9;
  border: 2rpx solid #e7e5e4;
  border-radius: var(--button-radius, 20rpx);
  font-size: 28rpx;
  color: #78716c;
}

.style-item.active {
  background: rgba(124,106,93,0.1);
  border-color: var(--primary);
  color: var(--primary);
  font-weight: bold;
}

.custom-style-input-wrap {
  margin-top: 20rpx;
  animation: fadeIn 0.3s ease;
}

.custom-style-input {
  background: #fff;
  border-color: var(--primary);
}

.flow-list,
.faq-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.flow-item {
  display: flex;
  gap: 18rpx;
}

.flow-number {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(124,106,93,0.12);
  color: var(--primary);
  font-size: 22rpx;
  font-weight: bold;
}

.flow-title,
.faq-question {
  font-size: 26rpx;
  font-weight: bold;
  color: var(--text-main);
  margin-bottom: 6rpx;
}

.faq-item {
  padding: 20rpx;
  border-radius: var(--card-radius, 16rpx);
  background: #fafaf9;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(-10rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* 底部提交 */
.submit-section {
  position: fixed;
  bottom: calc(120rpx + env(safe-area-inset-bottom)); /* 抬高以避开自定义 TabBar */
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  /* 移除原本的 padding-bottom，因为已经在 bottom 中处理了 safe-area */
  background: #fff;
  box-shadow: 0 -8rpx 32rpx rgba(0,0,0,0.05);
  z-index: 100; 
  transform: translateY(100%);
  opacity: 0;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  pointer-events: none;
}

.submit-section.show {
  transform: translateY(0);
  opacity: 1;
  pointer-events: auto;
}

.tips-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.tip-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 20rpx;
  color: var(--text-muted);
}

.tip-icon {
  color: var(--primary);
}

.submit-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  height: 112rpx;
  background: var(--primary);
  color: #fff;
  font-size: 34rpx;
  font-weight: bold;
  border-radius: var(--button-radius, 24rpx);
  box-shadow: var(--card-shadow, 0 16rpx 40rpx rgba(124,106,93,0.2));
  border: none;
}

.submit-btn::after {
  border: none;
}

.btn-arrow {
  font-size: 36rpx;
}
