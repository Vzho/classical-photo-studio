.booking-page {
  min-height: 100vh;
  padding-bottom: calc(var(--tab-bar-height, 108rpx) + env(safe-area-inset-bottom) + 56rpx);
  background: var(--bg-light);
  color: var(--text-main);
  font-family: var(--font-family);
}

.booking-hero {
  position: relative;
  height: 500rpx;
  overflow: hidden;
  background: var(--surface-muted);
}

.header-image .booking-hero {
  height: 620rpx;
}

.header-compact .booking-hero {
  height: 360rpx;
}

.booking-hero-image,
.booking-hero-fallback {
  width: 100%;
  height: 100%;
}

.booking-hero-fallback {
  background: var(--surface-muted);
}

.booking-hero-shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: linear-gradient(180deg, rgba(20, 19, 17, 0.12) 0%, rgba(20, 19, 17, 0.74) 100%);
}

.booking-hero-content {
  position: absolute;
  right: var(--page-padding);
  bottom: 52rpx;
  left: var(--page-padding);
  color: var(--on-media);
}

.booking-kicker {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 14rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.booking-kicker::before {
  width: 36rpx;
  height: 2rpx;
  background: var(--accent);
  content: '';
}

.booking-title {
  max-width: 620rpx;
  font-family: var(--title-font-family);
  font-size: 50rpx;
  font-weight: var(--title-weight);
  line-height: 1.15;
}

.booking-description {
  max-width: 620rpx;
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
  line-height: 1.55;
}

.header-compact .booking-description {
  display: none;
}

.header-compact .booking-title {
  font-size: 42rpx;
}

.booking-section {
  box-sizing: border-box;
  width: 100%;
  padding: 54rpx var(--page-padding) 28rpx;
}

.booking-section + .booking-section {
  border-top: 1rpx solid var(--divider);
}

.notice-section {
  display: grid;
  grid-template-columns: 48rpx minmax(0, 1fr);
  gap: 18rpx;
  padding-top: 30rpx;
  padding-bottom: 30rpx;
  background: var(--surface-muted);
}

.notice-icon {
  padding-top: 2rpx;
}

.notice-title {
  color: var(--text-main);
  font-size: 25rpx;
  font-weight: 600;
}

.notice-text {
  margin-top: 6rpx;
  color: var(--text-muted);
  font-size: 22rpx;
  line-height: 1.55;
}

.schedule-available {
  color: var(--text-main);
  font-family: var(--title-font-family);
  font-size: 34rpx;
  font-weight: var(--title-weight);
  line-height: 1.35;
}

.schedule-notice {
  margin-top: 12rpx;
  color: var(--text-muted);
  font-size: 23rpx;
  line-height: 1.55;
}

.schedule-notes {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx 20rpx;
  margin-top: 18rpx;
}

.schedule-note {
  color: var(--secondary);
  font-size: 21rpx;
}

.form-fields {
  border-top: 1rpx solid var(--divider);
}

.form-item {
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--divider);
}

.form-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 14rpx;
}

.label-main {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: var(--text-main);
  font-size: 25rpx;
  font-weight: 600;
}

.required-mark {
  color: var(--secondary);
  font-size: 19rpx;
}

.form-input,
.form-textarea {
  box-sizing: border-box;
  width: 100%;
  background: transparent;
  border: none;
  color: var(--text-main);
  font-size: 28rpx;
  line-height: 1.45;
}

.form-input {
  height: 78rpx;
  padding: 0;
}

.form-textarea {
  min-height: 190rpx;
  padding: 12rpx 0;
}

.form-soft .form-input,
.form-soft .form-textarea {
  padding-right: 20rpx;
  padding-left: 20rpx;
  background: var(--surface-muted);
  border-radius: var(--button-radius);
}

.form-soft .form-textarea {
  padding-top: 20rpx;
  padding-bottom: 20rpx;
}

.picker-input {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.picker-input.placeholder {
  color: var(--text-muted);
}

.style-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0 26rpx;
}

.style-item {
  position: relative;
  min-height: 76rpx;
  padding: 23rpx 4rpx 18rpx;
  overflow: hidden;
  color: var(--text-muted);
  font-size: 25rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
  border-bottom: 1rpx solid var(--divider);
}

.style-item::after {
  position: absolute;
  right: 0;
  bottom: -1rpx;
  left: 0;
  height: 3rpx;
  background: transparent;
  content: '';
}

.style-item.active {
  color: var(--text-main);
  font-weight: 600;
}

.style-item.active::after {
  background: var(--primary);
}

.custom-style-input {
  margin-top: 18rpx;
  border-bottom: 1rpx solid var(--divider);
}

.form-assurance {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 28rpx;
  color: var(--text-muted);
  font-size: 20rpx;
}

.form-assurance > view {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  min-width: 0;
}

.submit-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  width: 100%;
  height: var(--button-height);
  margin-top: 30rpx;
  padding: 0 var(--button-padding-x);
  background: var(--button-bg);
  border: var(--button-border);
  border-color: var(--button-bg);
  border-radius: var(--button-radius);
  color: var(--button-text);
  font-size: 29rpx;
  font-weight: var(--button-font-weight);
  line-height: 1.2;
}

.flow-list,
.faq-list {
  border-top: 1rpx solid var(--divider);
}

.flow-item {
  display: grid;
  grid-template-columns: 58rpx minmax(0, 1fr);
  gap: 18rpx;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--divider);
}

.flow-index {
  color: var(--accent);
  font-size: 21rpx;
  font-weight: 600;
}

.flow-title,
.faq-question {
  color: var(--text-main);
  font-size: 27rpx;
  font-weight: 600;
}

.flow-description,
.faq-answer {
  margin-top: 7rpx;
  color: var(--text-muted);
  font-size: 22rpx;
  line-height: 1.6;
}

.faq-item {
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--divider);
}
