<view
  class="booking-page theme-{{themePreset}} {{decorationClass}} header-{{bookingDecoration.headerVariant}} form-{{bookingDecoration.formVariant}}"
  style="{{themeStyle}} {{decorationStyle}}"
>
  <block wx:for="{{bookingSections}}" wx:for-item="section" wx:key="id">
    <view wx:if="{{section.enabled && section.type === 'hero'}}" class="booking-hero">
      <image wx:if="{{bannerUrl}}" class="booking-hero-image" src="{{bannerUrl}}" mode="aspectFill" binderror="onBannerError" />
      <view wx:else class="booking-hero-fallback"></view>
      <view class="booking-hero-shade"></view>
      <view class="booking-hero-content">
        <view class="booking-kicker">预约{{terminology.consultationLabel}}</view>
        <view class="booking-title">{{consultation.title}}</view>
        <view class="booking-description">{{consultation.description}}</view>
      </view>
    </view>

    <view wx:elif="{{section.enabled && section.type === 'notice' && consultation.privacyTip}}" class="booking-section notice-section">
      <view class="notice-icon"><app-icon name="{{section.icon || 'circle-check'}}" size="30" tone="primary" /></view>
      <view class="notice-copy">
        <view class="notice-title">{{section.title}}</view>
        <view class="notice-text">{{consultation.privacyTip}}</view>
      </view>
    </view>

    <view wx:elif="{{section.enabled && section.type === 'schedule' && schedule.enabled}}" class="booking-section schedule-section">
      <view class="section-heading">
        <view class="section-heading-main">
          <view class="section-title-row">
            <app-icon wx:if="{{section.icon}}" name="{{section.icon}}" size="30" tone="primary" />
            <view class="section-title">{{section.title || schedule.title}}</view>
          </view>
          <view class="section-subtitle" wx:if="{{section.subtitle}}">{{section.subtitle}}</view>
        </view>
        <app-icon wx:if="{{!section.icon}}" name="calendar-days" size="34" tone="primary" />
      </view>
      <view class="schedule-available">{{schedule.availableText}}</view>
      <view class="schedule-notice">{{schedule.notice}}</view>
      <view class="schedule-notes" wx:if="{{schedule.specialNotes.length}}">
        <view class="schedule-note" wx:for="{{schedule.specialNotes}}" wx:for-item="note" wx:key="*this">{{note}}</view>
      </view>
    </view>

    <view wx:elif="{{section.enabled && section.type === 'form'}}" class="booking-section form-section">
      <view class="section-heading">
        <view class="section-heading-main">
          <view class="section-title-row">
            <app-icon wx:if="{{section.icon}}" name="{{section.icon}}" size="30" tone="primary" />
            <view class="section-title">{{section.title}}</view>
          </view>
          <view class="section-subtitle" wx:if="{{section.subtitle}}">{{section.subtitle}}</view>
        </view>
      </view>

      <view class="form-fields">
        <block wx:for="{{bookingFields}}" wx:for-item="field" wx:key="id">
          <view wx:if="{{field.enabled && field.id === 'name'}}" class="form-item">
            <view class="form-label">
              <view class="label-main"><app-icon name="{{field.icon}}" size="28" tone="muted" /><text>{{field.label}}</text></view>
              <text wx:if="{{field.required}}" class="required-mark">必填</text>
            </view>
            <input class="form-input" placeholder="{{field.placeholder}}" value="{{formData.name}}" bindinput="onInputChange" data-field="name" />
          </view>

          <view wx:elif="{{field.enabled && field.id === 'contact'}}" class="form-item">
            <view class="form-label">
              <view class="label-main"><app-icon name="{{field.icon}}" size="28" tone="muted" /><text>{{field.label}}</text></view>
              <text wx:if="{{field.required}}" class="required-mark">必填</text>
            </view>
            <input class="form-input" placeholder="{{field.placeholder}}" value="{{formData.contact}}" bindinput="onInputChange" data-field="contact" />
          </view>

          <view wx:elif="{{field.enabled && field.id === 'style'}}" class="form-item">
            <view class="form-label">
              <view class="label-main"><app-icon name="{{field.icon}}" size="28" tone="muted" /><text>{{field.label}}</text></view>
              <text wx:if="{{field.required}}" class="required-mark">必填</text>
            </view>
            <view class="style-list">
              <view
                wx:for="{{styleOptions}}"
                wx:for-item="styleItem"
                wx:key="*this"
                class="style-item {{formData.style === styleItem ? 'active' : ''}}"
                bindtap="onStyleSelect"
                data-style="{{styleItem}}"
              >{{styleItem}}</view>
            </view>
            <input
              wx:if="{{formData.style === '其他'}}"
              class="form-input custom-style-input"
              placeholder="请输入{{field.label}}"
              value="{{formData.customStyle}}"
              bindinput="onInputChange"
              data-field="customStyle"
            />
          </view>

          <view wx:elif="{{field.enabled && field.id === 'package' && packages.length}}" class="form-item">
            <view class="form-label">
              <view class="label-main"><app-icon name="{{field.icon}}" size="28" tone="muted" /><text>{{field.label}}</text></view>
              <text wx:if="{{field.required}}" class="required-mark">必填</text>
            </view>
            <picker range="{{packagePickerRange}}" value="{{selectedPackageIndex}}" bindchange="onPackageChange">
              <view class="form-input picker-input {{selectedPackageName ? '' : 'placeholder'}}">
                <text>{{selectedPackageName || field.placeholder}}</text>
                <app-icon name="chevron-right" size="26" tone="muted" />
              </view>
            </picker>
          </view>

          <view wx:elif="{{field.enabled && field.id === 'date'}}" class="form-item">
            <view class="form-label">
              <view class="label-main"><app-icon name="{{field.icon}}" size="28" tone="muted" /><text>{{field.label}}</text></view>
              <text wx:if="{{field.required}}" class="required-mark">必填</text>
            </view>
            <picker mode="date" value="{{formData.date}}" start="{{minDate}}" bindchange="onDateChange">
              <view class="form-input picker-input {{formData.date ? '' : 'placeholder'}}">
                <text>{{formData.date || field.placeholder}}</text>
                <app-icon name="chevron-right" size="26" tone="muted" />
              </view>
            </picker>
          </view>

          <view wx:elif="{{field.enabled && field.id === 'store' && stores.length}}" class="form-item">
            <view class="form-label">
              <view class="label-main"><app-icon name="{{field.icon}}" size="28" tone="muted" /><text>{{field.label}}</text></view>
              <text wx:if="{{field.required}}" class="required-mark">必填</text>
            </view>
            <picker range="{{storePickerRange}}" value="{{selectedStoreIndex}}" bindchange="onStoreChange">
              <view class="form-input picker-input {{selectedStoreName ? '' : 'placeholder'}}">
                <text>{{selectedStoreName || field.placeholder}}</text>
                <app-icon name="chevron-right" size="26" tone="muted" />
              </view>
            </picker>
          </view>

          <view wx:elif="{{field.enabled && field.id === 'photographer' && photographers.length}}" class="form-item">
            <view class="form-label">
              <view class="label-main"><app-icon name="{{field.icon}}" size="28" tone="muted" /><text>{{field.label}}</text></view>
              <text wx:if="{{field.required}}" class="required-mark">必填</text>
            </view>
            <picker range="{{photographerPickerRange}}" value="{{selectedPhotographerIndex}}" bindchange="onPhotographerChange">
              <view class="form-input picker-input {{selectedPhotographerName ? '' : 'placeholder'}}">
                <text>{{selectedPhotographerName || field.placeholder}}</text>
                <app-icon name="chevron-right" size="26" tone="muted" />
              </view>
            </picker>
          </view>

          <view wx:elif="{{field.enabled && field.id === 'notes'}}" class="form-item">
            <view class="form-label">
              <view class="label-main"><app-icon name="{{field.icon}}" size="28" tone="muted" /><text>{{field.label}}</text></view>
              <text wx:if="{{field.required}}" class="required-mark">必填</text>
            </view>
            <textarea
              class="form-textarea"
              placeholder="{{field.placeholder}}"
              value="{{formData.notes}}"
              bindinput="onInputChange"
              data-field="notes"
              maxlength="500"
            />
          </view>
        </block>
      </view>

      <view class="form-assurance">
        <view><app-icon name="circle-check" size="24" tone="primary" /><text>不会自动上传客户信息</text></view>
        <view><app-icon name="clock-3" size="24" tone="primary" /><text>最终{{terminology.serviceLabel}}时间以沟通为准</text></view>
      </view>
      <button class="submit-btn" bindtap="onSubmit" loading="{{submitting}}">
        <text wx:if="{{section.actionText}}">{{section.actionText}}</text>
        <text wx:else>生成{{terminology.consultationLabel}}内容</text>
        <app-icon name="arrow-right" size="30" tone="inverse" />
      </button>
    </view>

    <view wx:elif="{{section.enabled && section.type === 'serviceFlow' && serviceFlow.enabled && serviceFlow.steps.length}}" class="booking-section flow-section">
      <view class="section-heading"><view class="section-title-row"><app-icon wx:if="{{section.icon}}" name="{{section.icon}}" size="30" tone="primary" /><view class="section-title">{{section.title}}</view></view></view>
      <view class="flow-list">
        <view class="flow-item" wx:for="{{serviceFlow.steps}}" wx:for-item="flowItem" wx:key="title">
          <view class="flow-index">0{{index + 1}}</view>
          <view>
            <view class="flow-title">{{flowItem.title}}</view>
            <view class="flow-description">{{flowItem.description}}</view>
          </view>
        </view>
      </view>
    </view>

    <view wx:elif="{{section.enabled && section.type === 'faq' && faq.enabled && faq.items.length}}" class="booking-section faq-section">
      <view class="section-heading"><view class="section-title-row"><app-icon wx:if="{{section.icon}}" name="{{section.icon}}" size="30" tone="primary" /><view class="section-title">{{section.title}}</view></view></view>
      <view class="faq-list">
        <view class="faq-item" wx:for="{{faq.items}}" wx:for-item="faqItem" wx:key="question">
          <view class="faq-question">{{faqItem.question}}</view>
          <view class="faq-answer">{{faqItem.answer}}</view>
        </view>
      </view>
    </view>
  </block>

  <quick-jump
    wx:if="{{quickJumpVisible}}"
    current="booking"
    booking-text="{{quickJump.bookingText}}"
    portfolio-text="{{quickJump.portfolioText}}"
    appearance="{{quickJump.appearance}}"
    trigger-icon="{{quickJump.triggerIcon}}"
    booking-icon="{{quickJump.bookingIcon}}"
    portfolio-icon="{{quickJump.portfolioIcon}}"
  />
</view>
