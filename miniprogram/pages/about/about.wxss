.about-page {
  min-height: 100vh;
  padding-bottom: calc(var(--tab-bar-height, 108rpx) + env(safe-area-inset-bottom) + 52rpx);
  background: var(--bg-light);
  color: var(--text-main);
  font-family: var(--font-family);
}

.profile-section {
  overflow: hidden;
}

.profile-media {
  position: relative;
  height: 430rpx;
  overflow: hidden;
  background: var(--surface-muted);
}

.header-portrait .profile-media {
  height: 540rpx;
}

.header-minimal .profile-media {
  height: 280rpx;
}

.profile-cover,
.profile-cover-fallback {
  width: 100%;
  height: 100%;
}

.profile-cover-fallback {
  background: var(--surface-muted);
}

.profile-cover-shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(20, 19, 17, 0.12);
}

.profile-card {
  position: relative;
  z-index: 2;
  margin: -76rpx var(--page-padding) 0;
  padding: 0 0 34rpx;
  background: var(--bg-light);
}

.header-minimal .profile-card {
  margin-top: -52rpx;
}

.avatar-wrap {
  position: relative;
  width: 152rpx;
  height: 152rpx;
}

.header-portrait .avatar-wrap {
  width: 176rpx;
  height: 176rpx;
}

.avatar {
  width: 100%;
  height: 100%;
  border: 6rpx solid var(--bg-light);
  border-radius: 50%;
  background: var(--surface-muted);
}

.verified-badge {
  position: absolute;
  right: 0;
  bottom: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  background: var(--accent);
  border: 4rpx solid var(--bg-light);
  border-radius: 50%;
}

.profile-copy {
  margin-top: 24rpx;
}

.profile-name {
  color: var(--text-main);
  font-family: var(--title-font-family);
  font-size: 50rpx;
  font-weight: var(--title-weight);
  line-height: 1.2;
}

.profile-title {
  margin-top: 10rpx;
  color: var(--secondary);
  font-size: 27rpx;
  line-height: 1.5;
}

.profile-location {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-top: 14rpx;
  color: var(--text-muted);
  font-size: 23rpx;
  line-height: 1.5;
}

.stats-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin-top: 36rpx;
  padding: 28rpx 0;
  border-top: 1rpx solid var(--divider);
  border-bottom: 1rpx solid var(--divider);
}

.stat-item {
  min-width: 0;
  padding: 0 12rpx;
  text-align: center;
}

.stat-item + .stat-item {
  border-left: 1rpx solid var(--divider);
}

.stat-value {
  overflow: hidden;
  color: var(--text-main);
  font-family: var(--title-font-family);
  font-size: 36rpx;
  font-weight: var(--title-weight);
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stat-label {
  margin-top: 8rpx;
  display: -webkit-box;
  min-height: 54rpx;
  overflow: hidden;
  color: var(--text-muted);
  font-size: 20rpx;
  line-height: 1.35;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.about-section {
  box-sizing: border-box;
  width: 100%;
  padding: 58rpx var(--page-padding) 28rpx;
}

.about-section + .about-section {
  border-top: 1rpx solid var(--divider);
}

.bio-layout {
  display: grid;
  grid-template-columns: 5rpx minmax(0, 1fr);
  gap: 24rpx;
}

.bio-mark {
  min-height: 100%;
  background: var(--accent);
}

.bio-text {
  color: var(--text-main);
  font-family: var(--title-font-family);
  font-size: 29rpx;
  line-height: 1.9;
}

.skills-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx 28rpx;
}

.skill-item {
  display: flex;
  align-items: center;
  min-width: 0;
  gap: 12rpx;
  color: var(--text-main);
  font-size: 25rpx;
}

.skill-line {
  flex: 0 0 auto;
  width: 22rpx;
  height: 2rpx;
  background: var(--accent);
}

.contact-list,
.store-list,
.about-package-list,
.flow-list,
.faq-list,
.review-list {
  border-top: 1rpx solid var(--divider);
}

.contact-row {
  display: grid;
  grid-template-columns: 58rpx minmax(0, 1fr) auto;
  align-items: center;
  gap: 18rpx;
  min-height: 112rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--divider);
}

.contact-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
}

.contact-copy {
  min-width: 0;
}

.contact-label {
  color: var(--text-muted);
  font-size: 21rpx;
}

.contact-value {
  margin-top: 4rpx;
  overflow: hidden;
  color: var(--text-main);
  font-size: 27rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.contact-note {
  margin-top: 5rpx;
  color: var(--text-muted);
  font-size: 21rpx;
  line-height: 1.45;
}

.contact-row-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.row-divider {
  width: 1rpx;
  height: 28rpx;
  background: var(--divider);
}

.store-item {
  display: grid;
  grid-template-columns: 58rpx minmax(0, 1fr) 28rpx;
  align-items: start;
  gap: 18rpx;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--divider);
}

.store-index {
  color: var(--accent);
  font-size: 21rpx;
  font-weight: 600;
}

.store-main {
  min-width: 0;
}

.store-name {
  color: var(--text-main);
  font-size: 28rpx;
  font-weight: 600;
}

.store-address,
.store-meta {
  margin-top: 8rpx;
  color: var(--text-muted);
  font-size: 22rpx;
  line-height: 1.5;
}

.team-scroll {
  width: calc(100% + var(--page-padding));
}

.team-track {
  display: flex;
  gap: 18rpx;
  width: max-content;
  padding-right: var(--page-padding);
}

.team-item {
  box-sizing: border-box;
  width: 310rpx;
  padding-bottom: 22rpx;
  border-bottom: 2rpx solid var(--divider);
}

.team-avatar,
.team-avatar-placeholder {
  width: 310rpx;
  height: 380rpx;
  background: var(--surface-muted);
  border-radius: var(--image-radius);
}

.team-avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.team-name {
  margin-top: 18rpx;
  color: var(--text-main);
  font-size: 28rpx;
  font-weight: 600;
}

.team-title,
.team-bio {
  margin-top: 6rpx;
  color: var(--text-muted);
  font-size: 21rpx;
  line-height: 1.5;
}

.team-bio {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.about-package-item {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(150rpx, auto);
  gap: 22rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--divider);
}

.about-package-copy {
  min-width: 0;
}

.about-package-name {
  color: var(--text-main);
  font-size: 28rpx;
  font-weight: 600;
}

.about-package-description {
  margin-top: 8rpx;
  color: var(--text-muted);
  font-size: 22rpx;
  line-height: 1.5;
}

.about-package-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx 18rpx;
  margin-top: 12rpx;
  color: var(--secondary);
  font-size: 21rpx;
}

.about-package-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.about-package-price {
  color: var(--primary);
  font-family: var(--title-font-family);
  font-size: 28rpx;
  font-weight: var(--title-weight);
  text-align: right;
}

.about-package-action {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-top: auto;
  padding-top: 22rpx;
  color: var(--primary);
  font-size: 23rpx;
  font-weight: 600;
}

.flow-item {
  display: grid;
  grid-template-columns: 58rpx minmax(0, 1fr);
  gap: 18rpx;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--divider);
}

.flow-index {
  color: var(--accent);
  font-size: 21rpx;
  font-weight: 600;
}

.flow-title,
.faq-question {
  color: var(--text-main);
  font-size: 27rpx;
  font-weight: 600;
}

.flow-description,
.faq-answer {
  margin-top: 7rpx;
  color: var(--text-muted);
  font-size: 22rpx;
  line-height: 1.6;
}

.faq-item,
.review-item {
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--divider);
}

.review-content {
  color: var(--text-main);
  font-family: var(--title-font-family);
  font-size: 27rpx;
  line-height: 1.7;
}

.review-meta {
  margin-top: 12rpx;
  color: var(--text-muted);
  font-size: 21rpx;
}

.bottom-action {
  position: fixed;
  z-index: 800;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 20rpx var(--page-padding) calc(20rpx + env(safe-area-inset-bottom));
  background: var(--surface);
  border-top: 1rpx solid var(--divider);
}

.booking-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: var(--button-height);
  background: var(--button-bg);
  border-radius: var(--button-radius);
  color: var(--button-text);
  font-size: 28rpx;
  font-weight: var(--button-font-weight);
}

.store-modal-mask {
  position: fixed;
  z-index: 1200;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(24, 23, 21, 0.48);
}

.store-modal {
  box-sizing: border-box;
  width: 100%;
  padding: 32rpx var(--page-padding) calc(30rpx + env(safe-area-inset-bottom));
  background: var(--surface);
  border-radius: 16rpx 16rpx 0 0;
}

.store-modal-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid var(--divider);
}

.store-modal-title {
  color: var(--text-main);
  font-family: var(--title-font-family);
  font-size: 34rpx;
  font-weight: var(--title-weight);
}

.store-modal-subtitle {
  margin-top: 6rpx;
  color: var(--text-muted);
  font-size: 22rpx;
}

.store-modal-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
}

.store-modal-row {
  display: grid;
  grid-template-columns: 120rpx minmax(0, 1fr);
  gap: 18rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--divider);
}

.store-modal-label {
  color: var(--text-muted);
  font-size: 22rpx;
}

.store-modal-value {
  color: var(--text-main);
  font-size: 24rpx;
  line-height: 1.55;
}

.store-modal-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 28rpx;
}

.store-modal-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: var(--button-height);
  border: 1rpx solid var(--divider);
  border-radius: var(--button-radius);
  color: var(--text-main);
  font-size: 26rpx;
}

.store-modal-btn.primary {
  background: var(--button-bg);
  border-color: var(--button-bg);
  color: var(--button-text);
}
.dark-about-page {
  min-height: 100vh;
  padding-bottom: calc(var(--tab-bar-height, 108rpx) + env(safe-area-inset-bottom));
  color: #f5f4ef;
  background: #202020;
  box-sizing: border-box;
}

.dark-about-landing {
  display: flex;
  min-height: calc(100vh - var(--dark-header-bar-height, 88rpx) - var(--tab-bar-height, 108rpx) - env(safe-area-inset-top) - env(safe-area-inset-bottom));
  flex-direction: column;
  box-sizing: border-box;
}

.dark-about-profile {
  padding: 126rpx 40rpx 0;
  text-align: center;
}

.dark-about-avatar {
  width: 168rpx;
  height: 168rpx;
  border: 6rpx solid #ffffff;
  border-radius: 50%;
}

.dark-about-name {
  margin-top: 42rpx;
  font-size: 39rpx;
  font-weight: 600;
}

.dark-about-title {
  margin-top: 18rpx;
  color: #f1eee7;
  font-size: 27rpx;
}

.dark-about-location {
  margin-top: 14rpx;
  color: #efefef;
  font-size: 25rpx;
}

.dark-about-quote {
  position: relative;
  min-height: 196rpx;
  margin: 94rpx 58rpx 62rpx;
  padding: 30rpx 20rpx;
  color: #ffffff;
  font-size: 29rpx;
  line-height: 1.75;
  text-align: center;
}

.dark-about-quote-open,
.dark-about-quote-close {
  position: absolute;
  color: #ffffff;
  font-size: 78rpx;
  font-weight: 600;
  line-height: 1;
}

.dark-about-quote-open {
  top: -10rpx;
  left: -14rpx;
}

.dark-about-quote-close {
  right: -14rpx;
  bottom: -28rpx;
}

.dark-about-contact {
  display: flex;
  margin-bottom: 50rpx;
  justify-content: center;
  gap: 44rpx;
}

.dark-about-contact > view {
  display: flex;
  width: 90rpx;
  height: 90rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #505050;
}

.dark-about-action {
  width: 210rpx;
  height: 78rpx;
  margin: auto auto 84rpx;
  overflow: hidden;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 78rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
  background: var(--primary, #69d7d8);
}

.dark-about-wall {
  display: grid;
  padding: 0 42rpx 120rpx;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
}

.dark-about-wall image {
  width: 100%;
  height: 210rpx;
}

.dark-about-wall.columns-1 { grid-template-columns: minmax(0, 1fr); }
.dark-about-wall.columns-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.dark-about-wall.columns-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
.dark-about-wall.columns-1 image { height: 760rpx; }
.dark-about-wall.columns-2 image { height: 430rpx; }
.dark-about-wall.columns-4 image { height: 160rpx; }

.dark-about-section {
  padding: 56rpx 42rpx;
  border-top: 1rpx solid #343434;
  background: #202020;
}

.dark-about-section.dark-about-quote {
  box-sizing: border-box;
  min-height: 260rpx;
  margin: 0;
  padding: 82rpx 72rpx;
}

.dark-about-section-title {
  margin-bottom: 32rpx;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
}

.dark-about-skill-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.dark-about-skill-list text {
  padding: 12rpx 20rpx;
  color: #d4d4d4;
  font-size: 23rpx;
  border: 1rpx solid #494949;
}

.dark-about-team {
  display: flex;
  width: max-content;
  gap: 24rpx;
}

.dark-about-team > view {
  width: 178rpx;
  flex: 0 0 178rpx;
}

.dark-about-team image {
  display: block;
  width: 178rpx;
  height: 220rpx;
  margin-bottom: 18rpx;
}

.dark-about-team view view {
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 600;
}

.dark-about-team text,
.dark-about-list-row text,
.dark-about-faq text,
.dark-about-review text {
  display: block;
  margin-top: 8rpx;
  color: #9f9f9f;
  font-size: 22rpx;
  line-height: 1.6;
}

.dark-about-list-row {
  display: flex;
  min-height: 92rpx;
  padding: 20rpx 0;
  align-items: flex-start;
  justify-content: space-between;
  gap: 28rpx;
  color: #eeeeee;
  border-top: 1rpx solid #373737;
  font-size: 25rpx;
  box-sizing: border-box;
}

.dark-about-list-row > view {
  min-width: 0;
  flex: 1;
}

.dark-about-faq {
  padding: 24rpx 0;
  color: #eeeeee;
  border-top: 1rpx solid #373737;
  font-size: 25rpx;
}

.dark-about-review > view:not(.dark-about-section-title) {
  color: #dedede;
  font-size: 28rpx;
  line-height: 1.8;
}

.dark-about-location-section {
  padding: 0 36rpx 100rpx;
}

.dark-about-map,
.dark-about-map-placeholder {
  width: 100%;
  height: 430rpx;
  background: #ffffff;
}

.dark-about-map-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.dark-about-address {
  position: relative;
  min-height: 126rpx;
  padding: 28rpx 80rpx 28rpx 26rpx;
  color: #3e3e3e;
  background: #ffffff;
  box-sizing: border-box;
}

.dark-about-address view {
  font-size: 27rpx;
  font-weight: 600;
}

.dark-about-address text {
  display: block;
  margin-top: 9rpx;
  color: #666666;
  font-size: 23rpx;
  line-height: 1.5;
}

.dark-about-address app-icon {
  position: absolute;
  top: 50%;
  right: 26rpx;
  transform: translateY(-50%);
}

.dark-about-footer {
  position: relative;
  min-height: 420rpx;
  overflow: hidden;
}

.dark-about-footer-image,
.dark-about-footer-shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.dark-about-footer-shade {
  background: rgba(0, 0, 0, 0.58);
}

.dark-about-footer-copy {
  position: relative;
  z-index: 1;
  padding: 82rpx 42rpx 0;
  color: #ffffff;
  font-size: 25rpx;
  line-height: 2;
}

.dark-about-footer-copy view {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dark-about-footer-icons {
  position: relative;
  z-index: 1;
  display: flex;
  margin: 44rpx 42rpx 0;
  gap: 28rpx;
}

.dark-about-footer-icons > view {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.44);
}

.dark-about-footer .dark-about-action {
  position: relative;
  z-index: 1;
  margin: 36rpx 42rpx 64rpx;
}

.dark-about-page.skeleton-brand-studio .dark-about-landing {
  min-height: 680rpx;
}

.dark-about-page.skeleton-store-service .dark-about-landing {
  min-height: 560rpx;
}

/* V3 page skeletons */
.skeleton-brand-studio .profile-media {
  height: 620rpx;
}

.skeleton-brand-studio .profile-card {
  margin-top: -132rpx;
  padding: 34rpx;
  border: 1rpx solid var(--divider);
  background: var(--surface);
}

.skeleton-brand-studio .avatar-wrap {
  width: 184rpx;
  height: 220rpx;
}

.skeleton-brand-studio .avatar,
.skeleton-brand-studio .verified-badge {
  border-radius: 2rpx;
}

.skeleton-brand-studio .about-section {
  padding-top: 58rpx;
  padding-bottom: 58rpx;
}

.skeleton-store-service .profile-media {
  height: 300rpx;
}

.skeleton-store-service .profile-card {
  display: grid;
  margin-top: -48rpx;
  grid-template-columns: 132rpx minmax(0, 1fr);
  column-gap: 24rpx;
}

.skeleton-store-service .avatar-wrap {
  width: 132rpx;
  height: 132rpx;
}

.skeleton-store-service .profile-copy {
  margin-top: 54rpx;
}

.skeleton-store-service .stats-row {
  grid-column: 1 / -1;
}

.skeleton-store-service .about-section {
  border-bottom: 1rpx solid var(--divider);
}
