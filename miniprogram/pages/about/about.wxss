/* 摄影师简介页面样式 */
.about-page {
  min-height: 100vh;
  background: var(--bg-light);
  padding-bottom: 200rpx;
}

/* 头部区域 */
.profile-header {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 32rpx 48rpx;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 320rpx;
  background: linear-gradient(135deg, rgba(124,106,93,0.15), rgba(166,124,82,0.1));
  opacity: var(--decoration-opacity, 1);
}

.header-bg-img {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 400rpx;
  width: 100%;
  z-index: 0;
}

.header-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 400rpx;
  background: linear-gradient(to bottom, rgba(255,255,255,0) 0%, rgba(245,245,244,1) 90%);
  z-index: 1;
  pointer-events: none;
}

.header-bg-img::after {
  display: none;
}

/* 头像 */
.avatar-wrap {
  position: relative;
  z-index: 10;
  margin-top: 100rpx;
}

.avatar {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  border: 8rpx solid #fff;
  box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.15);
}

.verified-badge {
  position: absolute;
  bottom: 8rpx;
  right: 8rpx;
  width: 48rpx;
  height: 48rpx;
  background: var(--accent);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  border: 6rpx solid #fff;
}

/* 基本信息 */
.profile-info {
  text-align: center;
  margin-top: 24rpx;
}

.name {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--text-main);
}

.title {
  font-size: 26rpx;
  color: var(--primary);
  margin-top: 8rpx;
}

.location {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 12rpx;
}

.location-icon {
  font-size: 28rpx;
}

/* 数据统计 */
.stats-row {
  display: flex;
  justify-content: center;
  gap: 80rpx;
  margin-top: 40rpx;
  padding: 32rpx 0;
  border-top: 1rpx solid rgba(0,0,0,0.05);
  border-bottom: 1rpx solid rgba(0,0,0,0.05);
  width: 100%;
}

.stat-item {
  text-align: center;
}

.stat-value {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--primary);
}

.stat-label {
  font-size: 20rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
  text-transform: uppercase;
  letter-spacing: 2rpx;
}

/* 内容区域 */
.content-section {
  padding: 32rpx;
}

/* 艺术见解卡片 */
.bio-card {
  margin-bottom: 32rpx;
}

.card-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.card-icon {
  font-size: 32rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
}

.bio-text {
  font-size: 28rpx;
  color: rgba(41,37,36,0.8);
  line-height: 1.8;
}

/* 专业技能 */
.skills-section {
  margin-bottom: 32rpx;
}

.skills-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.skill-tag {
  padding: 16rpx 24rpx;
  background: #f5f5f4;
  border-radius: var(--button-radius, 20rpx);
  font-size: 24rpx;
  color: #57534e;
}

/* 联系方式 */
.contact-section {
  margin-bottom: 32rpx;
}

.contact-item {
  display: flex;
  align-items: center;
  padding: var(--card-padding, 28rpx);
  background: #fff;
  border-radius: var(--card-radius, 24rpx);
  margin-bottom: 20rpx;
  box-shadow: var(--card-shadow, 0 4rpx 16rpx rgba(0,0,0,0.04));
}

.studio-item {
  align-items: flex-start;
}

.contact-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  background: rgba(124,106,93,0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.contact-icon {
  font-size: 32rpx;
}

.contact-info {
  flex: 1;
  margin-left: 20rpx;
}

.contact-label {
  font-size: 20rpx;
  color: var(--text-muted);
}

.contact-value {
  font-size: 28rpx;
  font-weight: 600;
  margin-top: 4rpx;
}

.studio-name {
  margin-bottom: 8rpx;
}

.studio-address {
  font-size: 24rpx;
  color: #57534e;
  line-height: 1.6;
}

.contact-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-left: 16rpx;
}

.copy-btn {
  padding: 12rpx 24rpx;
  background: #f5f5f4;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: bold;
  color: var(--text-muted);
}

.nav-btn {
  background: rgba(124,106,93,0.12);
  color: var(--primary);
}

/* 底部预约按钮 */
.bottom-action {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #fff;
}

.booking-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  height: 100rpx;
  background: var(--primary);
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: var(--button-radius, 24rpx);
  box-shadow: var(--card-shadow, 0 16rpx 40rpx rgba(124,106,93,0.3));
  border: none;
}

.booking-btn::after {
  border: none;
}

.btn-icon {
  font-size: 36rpx;
}

.content-section-card {
  margin-top: 32rpx;
  padding: var(--card-padding, 32rpx);
  background: #fff;
  border-radius: var(--card-radius, 24rpx);
  border: 2rpx solid var(--card-border, #f5f5f4);
  box-shadow: var(--card-shadow, 0 8rpx 24rpx rgba(0,0,0,0.03));
}

.store-card,
.team-card,
.review-card,
.faq-item {
  padding: 24rpx;
  border-radius: var(--card-radius, 18rpx);
  background: #fafaf9;
  margin-bottom: 18rpx;
}

.store-card {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  align-items: flex-start;
}

.store-main {
  flex: 1;
}

.store-name,
.team-name,
.flow-title,
.faq-question {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-main);
  margin-bottom: 8rpx;
}

.store-address,
.store-meta,
.team-title,
.team-bio,
.flow-desc,
.faq-answer,
.review-meta {
  font-size: 24rpx;
  color: var(--text-muted);
  line-height: 1.7;
}

.store-action-list {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.store-copy-btn {
  flex-shrink: 0;
  height: 68rpx;
  padding: 0 22rpx;
  border: none;
  border-radius: 16rpx;
  background: rgba(124,106,93,0.1);
  color: var(--primary);
  font-size: 24rpx;
  font-weight: bold;
}

.store-copy-btn::after {
  border: none;
}

.store-copy-btn.muted {
  background: #f5f5f4;
  color: #57534e;
}

.team-card {
  display: flex;
  gap: 20rpx;
}

.team-avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #e7e5e4;
}

.team-info {
  flex: 1;
}

.about-package-card {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx;
  border-radius: var(--card-radius, 18rpx);
  background: #fafaf9;
  margin-bottom: 18rpx;
}

.about-package-main {
  flex: 1;
}

.about-package-name {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-main);
  margin-bottom: 8rpx;
}

.about-package-desc,
.about-package-meta {
  font-size: 24rpx;
  color: var(--text-muted);
  line-height: 1.65;
}

.about-package-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 8rpx;
}

.about-package-side {
  width: 160rpx;
  flex-shrink: 0;
}

.about-package-price {
  color: var(--primary);
  font-size: 26rpx;
  font-weight: bold;
  text-align: right;
  margin-bottom: 10rpx;
}

.about-package-btn {
  width: 100%;
  height: 58rpx;
  margin-bottom: 10rpx;
  border: none;
  border-radius: var(--button-radius, 14rpx);
  background: #f5f5f4;
  color: #57534e;
  font-size: 23rpx;
  font-weight: bold;
}

.about-package-btn.primary {
  background: var(--primary);
  color: #fff;
}

.about-package-btn::after {
  border: none;
}

.store-modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 200;
  display: flex;
  align-items: flex-end;
  background: rgba(0,0,0,0.35);
}

.store-modal {
  width: 100%;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  box-sizing: border-box;
}

.store-modal-header {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 26rpx;
}

.store-modal-title {
  font-size: 34rpx;
  font-weight: bold;
  color: var(--text-main);
}

.store-modal-subtitle,
.store-modal-label {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: var(--text-muted);
}

.store-modal-close {
  width: 64rpx;
  height: 64rpx;
  padding: 0;
  border: none;
  border-radius: 50%;
  background: #f5f5f4;
  color: #57534e;
  font-size: 36rpx;
  line-height: 64rpx;
}

.store-modal-close::after {
  border: none;
}

.store-modal-row {
  margin-bottom: 20rpx;
}

.store-modal-value {
  margin-top: 6rpx;
  font-size: 27rpx;
  color: var(--text-main);
  line-height: 1.65;
}

.store-modal-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 30rpx;
}

.store-modal-btn {
  height: 82rpx;
  border: none;
  border-radius: var(--button-radius, 18rpx);
  background: #f5f5f4;
  color: #57534e;
  font-size: 27rpx;
  font-weight: bold;
}

.store-modal-btn.primary {
  background: var(--primary);
  color: #fff;
}

.store-modal-btn::after {
  border: none;
}

.flow-item {
  display: flex;
  gap: 18rpx;
  margin-bottom: 22rpx;
}

.flow-number {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(124,106,93,0.12);
  color: var(--primary);
  font-size: 22rpx;
  font-weight: bold;
}

.review-content {
  font-size: 26rpx;
  line-height: 1.8;
  color: var(--text-main);
  margin-bottom: 10rpx;
}
