<view class="about-page theme-{{themePreset}} header-{{aboutDecoration.headerVariant}}" style="{{themeStyle}}">
  <block wx:for="{{aboutSections}}" wx:for-item="section" wx:key="id">
    <view wx:if="{{section.enabled && section.type === 'profile'}}" class="profile-section">
      <view class="profile-media">
        <image wx:if="{{bannerUrl}}" class="profile-cover" src="{{bannerUrl}}" mode="aspectFill" binderror="onBannerError" />
        <view wx:else class="profile-cover-fallback"></view>
        <view class="profile-cover-shade"></view>
      </view>
      <view class="profile-card">
        <view class="avatar-wrap">
          <image class="avatar" src="{{avatarUrl}}" mode="aspectFill" />
          <view class="verified-badge">
            <app-icon name="circle-check" size="30" tone="inverse" />
          </view>
        </view>
        <view class="profile-copy">
          <view class="profile-name">{{photographer.name}}</view>
          <view class="profile-title">{{photographer.title}}</view>
          <view class="profile-location" wx:if="{{photographer.location}}">
            <app-icon name="{{icons.contact.location}}" size="24" tone="muted" />
            <text>{{photographer.location}}</text>
          </view>
        </view>
        <view class="stats-row" wx:if="{{photographer.stats && photographer.stats.length}}">
          <view class="stat-item" wx:for="{{photographer.stats}}" wx:for-item="stat" wx:key="label">
            <view class="stat-value">{{stat.value}}</view>
            <view class="stat-label">{{stat.label}}</view>
          </view>
        </view>
      </view>
    </view>

    <view wx:elif="{{section.enabled && section.type === 'bio' && photographer.bio}}" class="about-section bio-section">
      <view class="section-heading">
        <view class="section-heading-main">
          <view class="section-title-row">
            <app-icon wx:if="{{section.icon}}" name="{{section.icon}}" size="30" tone="primary" />
            <view class="section-title">{{section.title}}</view>
          </view>
          <view class="section-subtitle" wx:if="{{section.subtitle}}">{{section.subtitle}}</view>
        </view>
      </view>
      <view class="bio-layout">
        <view class="bio-mark"></view>
        <view class="bio-text">{{photographer.bio}}</view>
      </view>
    </view>

    <view wx:elif="{{section.enabled && section.type === 'skills' && photographer.skills && photographer.skills.length}}" class="about-section skills-section">
      <view class="section-heading">
        <view class="section-title-row"><app-icon wx:if="{{section.icon}}" name="{{section.icon}}" size="30" tone="primary" /><view class="section-title">{{section.title}}</view></view>
      </view>
      <view class="skills-list">
        <view class="skill-item" wx:for="{{photographer.skills}}" wx:for-item="skill" wx:key="*this">
          <view class="skill-line"></view>
          <text>{{skill}}</text>
        </view>
      </view>
    </view>

    <view wx:elif="{{section.enabled && section.type === 'contact'}}" class="about-section contact-section">
      <view class="section-heading">
        <view class="section-title-row"><app-icon wx:if="{{section.icon}}" name="{{section.icon}}" size="30" tone="primary" /><view class="section-title">{{section.title}}</view></view>
      </view>
      <view class="contact-list">
        <view wx:if="{{photographer.contact.wechat}}" class="contact-row" bindtap="copyWechat">
          <view class="contact-icon"><app-icon name="{{icons.contact.wechat}}" size="34" tone="primary" /></view>
          <view class="contact-copy">
            <view class="contact-label">微信</view>
            <view class="contact-value">{{photographer.contact.wechat}}</view>
          </view>
          <app-icon name="copy" size="28" tone="muted" />
        </view>
        <view wx:if="{{photographer.contact.email}}" class="contact-row" bindtap="copyEmail">
          <view class="contact-icon"><app-icon name="{{icons.contact.email}}" size="34" tone="primary" /></view>
          <view class="contact-copy">
            <view class="contact-label">邮箱</view>
            <view class="contact-value">{{photographer.contact.email}}</view>
          </view>
          <app-icon name="copy" size="28" tone="muted" />
        </view>
        <view wx:if="{{photographer.studio.name || photographer.studio.address}}" class="contact-row studio-row" bindtap="openStudioLocation">
          <view class="contact-icon"><app-icon name="{{icons.contact.location}}" size="34" tone="primary" /></view>
          <view class="contact-copy">
            <view class="contact-label">到店地址</view>
            <view class="contact-value">{{photographer.studio.name || '门店地址'}}</view>
            <view class="contact-note">{{photographer.studio.address}}</view>
          </view>
          <view class="contact-row-actions">
            <app-icon name="navigation" size="28" tone="muted" />
            <view class="row-divider"></view>
            <view catchtap="copyStudioAddress"><app-icon name="copy" size="28" tone="muted" /></view>
          </view>
        </view>
      </view>
    </view>

    <view wx:elif="{{section.enabled && section.type === 'stores' && stores.length}}" class="about-section stores-section">
      <view class="section-heading">
        <view class="section-title-row"><app-icon wx:if="{{section.icon}}" name="{{section.icon}}" size="30" tone="primary" /><view class="section-title">{{section.title}}</view></view>
      </view>
      <view class="store-list">
        <view class="store-item" wx:for="{{stores}}" wx:for-item="store" wx:key="id" bindtap="openStoreDetail" data-index="{{index}}">
          <view class="store-index">0{{index + 1}}</view>
          <view class="store-main">
            <view class="store-name">{{store.name}}</view>
            <view class="store-address">{{store.address}}</view>
            <view class="store-meta" wx:if="{{store.businessHours}}">{{store.businessHours}}</view>
          </view>
          <app-icon name="chevron-right" size="28" tone="muted" />
        </view>
      </view>
    </view>

    <view wx:elif="{{section.enabled && section.type === 'team' && photographers.length}}" class="about-section team-section">
      <view class="section-heading">
        <view class="section-title-row"><app-icon wx:if="{{section.icon}}" name="{{section.icon}}" size="30" tone="primary" /><view class="section-title">{{section.title}}</view></view>
      </view>
      <scroll-view class="team-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="team-track">
          <view class="team-item" wx:for="{{photographers}}" wx:for-item="member" wx:key="id">
            <image wx:if="{{member.avatar}}" class="team-avatar" src="{{member.avatar}}" mode="aspectFill" />
            <view wx:else class="team-avatar-placeholder"><app-icon name="user-round" size="42" tone="muted" /></view>
            <view class="team-name">{{member.name}}</view>
            <view class="team-title">{{member.title}}</view>
            <view class="team-bio">{{member.bio}}</view>
          </view>
        </view>
      </scroll-view>
    </view>

    <view wx:elif="{{section.enabled && section.type === 'packages' && packages.length}}" class="about-section packages-section">
      <view class="section-heading">
        <view class="section-title-row"><app-icon wx:if="{{section.icon}}" name="{{section.icon}}" size="30" tone="primary" /><view class="section-title">{{section.title}}</view></view>
      </view>
      <view class="about-package-list">
        <view class="about-package-item" wx:for="{{packages}}" wx:for-item="packageItem" wx:key="id">
          <view class="about-package-copy" bindtap="openPackageDetail" data-id="{{packageItem.id}}">
            <view class="about-package-name">{{packageItem.name}}</view>
            <view class="about-package-description">{{packageItem.subtitle}}</view>
            <view class="about-package-meta">
              <text wx:if="{{packageItem.duration}}">{{packageItem.duration}}</text>
              <text wx:if="{{packageItem.retouchCount}}">{{packageItem.retouchCount}}</text>
            </view>
          </view>
          <view class="about-package-side">
            <view class="about-package-price">{{packageItem.priceText}}</view>
            <view class="about-package-action" bindtap="consultPackage" data-id="{{packageItem.id}}">
              <text>{{section.actionText || terminology.consultationLabel}}</text>
              <app-icon name="arrow-right" size="24" tone="primary" />
            </view>
          </view>
        </view>
      </view>
    </view>

    <view wx:elif="{{section.enabled && section.type === 'serviceFlow' && serviceFlow.enabled && serviceFlow.steps.length}}" class="about-section flow-section">
      <view class="section-heading"><view class="section-title-row"><app-icon wx:if="{{section.icon}}" name="{{section.icon}}" size="30" tone="primary" /><view class="section-title">{{section.title}}</view></view></view>
      <view class="flow-list">
        <view class="flow-item" wx:for="{{serviceFlow.steps}}" wx:for-item="flowItem" wx:key="title">
          <view class="flow-index">0{{index + 1}}</view>
          <view>
            <view class="flow-title">{{flowItem.title}}</view>
            <view class="flow-description">{{flowItem.description}}</view>
          </view>
        </view>
      </view>
    </view>

    <view wx:elif="{{section.enabled && section.type === 'faq' && faq.enabled && faq.items.length}}" class="about-section faq-section">
      <view class="section-heading"><view class="section-title-row"><app-icon wx:if="{{section.icon}}" name="{{section.icon}}" size="30" tone="primary" /><view class="section-title">{{section.title}}</view></view></view>
      <view class="faq-list">
        <view class="faq-item" wx:for="{{faq.items}}" wx:for-item="faqItem" wx:key="question">
          <view class="faq-question">{{faqItem.question}}</view>
          <view class="faq-answer">{{faqItem.answer}}</view>
        </view>
      </view>
    </view>

    <view wx:elif="{{section.enabled && section.type === 'testimonials' && testimonials.length}}" class="about-section review-section">
      <view class="section-heading"><view class="section-title-row"><app-icon wx:if="{{section.icon}}" name="{{section.icon}}" size="30" tone="primary" /><view class="section-title">{{section.title}}</view></view></view>
      <view class="review-list">
        <view class="review-item" wx:for="{{testimonials}}" wx:for-item="review" wx:key="id">
          <view class="review-content">“{{review.content}}”</view>
          <view class="review-meta">{{review.name}} · {{review.shootType}} {{review.dateText}}</view>
        </view>
      </view>
    </view>
  </block>

  <view wx:if="{{consultButtonVisible && !quickJumpVisible}}" class="bottom-action">
    <view class="booking-btn" bindtap="goBooking">
      <app-icon name="calendar-days" size="30" tone="inverse" />
      <text wx:if="{{consultButton.text}}">{{consultButton.text}}</text>
      <text wx:else>发起{{terminology.serviceLabel}}{{terminology.consultationLabel}}</text>
    </view>
  </view>

  <view wx:if="{{selectedStore}}" class="store-modal-mask" bindtap="closeStoreDetail">
    <view class="store-modal" catchtap="noop">
      <view class="store-modal-header">
        <view>
          <view class="store-modal-title">{{selectedStore.name}}</view>
          <view class="store-modal-subtitle">{{selectedStore.businessHours}}</view>
        </view>
        <view class="store-modal-close" bindtap="closeStoreDetail"><app-icon name="x" size="30" tone="muted" /></view>
      </view>
      <view class="store-modal-row" wx:if="{{selectedStore.address}}">
        <view class="store-modal-label section-title-row"><app-icon name="{{icons.contact.location}}" size="24" tone="primary" /><text>地址</text></view>
        <view class="store-modal-value">{{selectedStore.address}}</view>
      </view>
      <view class="store-modal-row" wx:if="{{selectedStore.phone}}">
        <view class="store-modal-label section-title-row"><app-icon name="{{icons.contact.phone}}" size="24" tone="primary" /><text>电话</text></view>
        <view class="store-modal-value">{{selectedStore.phone}}</view>
      </view>
      <view class="store-modal-row" wx:if="{{selectedStore.transportTips}}">
        <view class="store-modal-label">交通提示</view>
        <view class="store-modal-value">{{selectedStore.transportTips}}</view>
      </view>
      <view class="store-modal-actions">
        <view class="store-modal-btn" bindtap="copySelectedStoreAddress">复制地址</view>
        <view class="store-modal-btn primary" bindtap="closeStoreDetail">知道了</view>
      </view>
    </view>
  </view>

  <quick-jump
    wx:if="{{quickJumpVisible}}"
    current="about"
    booking-text="{{quickJump.bookingText}}"
    portfolio-text="{{quickJump.portfolioText}}"
    appearance="{{quickJump.appearance}}"
    trigger-icon="{{quickJump.triggerIcon}}"
    booking-icon="{{quickJump.bookingIcon}}"
    portfolio-icon="{{quickJump.portfolioIcon}}"
  />
</view>
