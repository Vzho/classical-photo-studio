<!-- 摄影师简介页面 -->
<view class="about-page" style="{{themeStyle}}">
  <!-- 头部背景 -->
  <view class="profile-header">
    <image wx:if="{{bannerUrl}}" class="header-bg-img" src="{{bannerUrl}}" mode="aspectFill" binderror="onBannerError" />
    <view wx:if="{{bannerUrl}}" class="header-overlay"></view>
    <view wx:else class="header-bg"></view>
    
    <!-- 头像 -->
    <view class="avatar-wrap">
      <image class="avatar" src="{{avatarUrl}}" mode="aspectFill" />
      <view class="verified-badge">✓</view>
    </view>

    <!-- 基本信息 -->
    <view class="profile-info">
      <view class="name">{{photographer.name}}</view>
      <view class="title">{{photographer.title}}</view>
      <view class="location">
        <text class="location-icon">📍</text>
        <text>{{photographer.location}}</text>
      </view>
    </view>

    <!-- 数据统计 -->
    <view class="stats-row">
      <view class="stat-item" wx:for="{{photographer.stats}}" wx:key="label">
        <view class="stat-value">{{item.value}}</view>
        <view class="stat-label">{{item.label}}</view>
      </view>
    </view>
  </view>

  <!-- 内容区域 -->
  <view class="content-section">
    <!-- 艺术见解 -->
    <view class="card bio-card">
      <view class="card-header">
        <text class="card-icon">✨</text>
        <text class="card-title">艺术见解</text>
      </view>
      <view class="bio-text">{{photographer.bio}}</view>
    </view>

    <!-- 专业技能 -->
    <view class="skills-section">
      <view class="section-title">专业技能</view>
      <view class="skills-list">
        <view class="skill-tag" wx:for="{{photographer.skills}}" wx:key="*this">
          {{item}}
        </view>
      </view>
    </view>

    <!-- 联系方式 -->
    <view class="contact-section">
      <view class="section-title">联系我</view>
      
      <view class="contact-item" bindtap="copyWechat">
        <view class="contact-icon-wrap">
          <text class="contact-icon">💬</text>
        </view>
        <view class="contact-info">
          <view class="contact-label">WeChat</view>
          <view class="contact-value">{{photographer.contact.wechat}}</view>
        </view>
        <view class="copy-btn">复制</view>
      </view>

      <view class="contact-item" bindtap="copyEmail">
        <view class="contact-icon-wrap">
          <text class="contact-icon">📧</text>
        </view>
        <view class="contact-info">
          <view class="contact-label">Email</view>
          <view class="contact-value">{{photographer.contact.email}}</view>
        </view>
        <view class="copy-btn">复制</view>
      </view>
    </view>

    <!-- 到店地址 -->
    <view class="contact-section" wx:if="{{photographer.studio.name || photographer.studio.address}}">
      <view class="section-title">到店地址</view>

      <view class="contact-item studio-item" bindtap="openStudioLocation">
        <view class="contact-icon-wrap">
          <text class="contact-icon">📍</text>
        </view>
        <view class="contact-info">
          <view class="contact-label">Studio</view>
          <view class="contact-value studio-name">{{photographer.studio.name || '门店地址'}}</view>
          <view class="studio-address">{{photographer.studio.address || '请在后台补充完整门店地址'}}</view>
        </view>
        <view class="contact-actions">
          <view class="copy-btn nav-btn">{{canOpenStudioLocation ? '导航' : '未配置'}}</view>
          <view class="copy-btn" catchtap="copyStudioAddress">复制</view>
        </view>
      </view>
    </view>

    <view class="content-section-card" wx:if="{{stores.length > 1}}">
      <view class="section-title">门店信息</view>
      <view class="store-card" wx:for="{{stores}}" wx:key="id" bindtap="openStoreDetail" data-index="{{index}}">
        <view class="store-main">
          <view class="store-name">{{item.name}}</view>
          <view class="store-address">{{item.address}}</view>
          <view class="store-meta" wx:if="{{item.phone}}">{{item.phone}}</view>
          <view class="store-meta" wx:if="{{item.businessHours}}">{{item.businessHours}}</view>
          <view class="store-meta" wx:if="{{item.transportTips}}">{{item.transportTips}}</view>
        </view>
        <view class="store-action-list">
          <button class="store-copy-btn" wx:if="{{item.phone}}" catchtap="callStorePhone" data-index="{{index}}">电话</button>
          <button class="store-copy-btn" catchtap="openStoreLocation" data-index="{{index}}">导航</button>
          <button class="store-copy-btn muted" catchtap="copyStoreAddress" data-index="{{index}}">复制</button>
        </view>
      </view>
    </view>

    <view class="content-section-card" wx:if="{{photographers.length}}">
      <view class="section-title">摄影师团队</view>
      <view class="team-card" wx:for="{{photographers}}" wx:key="id">
        <image wx:if="{{item.avatar}}" class="team-avatar" src="{{item.avatar}}" mode="aspectFill" />
        <view class="team-info">
          <view class="team-name">{{item.name}}</view>
          <view class="team-title">{{item.title}}</view>
          <view class="team-bio">{{item.bio}}</view>
        </view>
      </view>
    </view>

    <view class="content-section-card" wx:if="{{packages.length}}">
      <view class="section-title">服务价格</view>
      <view class="about-package-card" wx:for="{{packages}}" wx:key="id">
        <view class="about-package-main">
          <view class="about-package-name">{{item.name}}</view>
          <view class="about-package-desc">{{item.subtitle}}</view>
          <view class="about-package-meta">
            <text wx:if="{{item.duration}}">{{item.duration}}</text>
            <text wx:if="{{item.retouchCount}}">{{item.retouchCount}}</text>
          </view>
        </view>
        <view class="about-package-side">
          <view class="about-package-price">{{item.priceText}}</view>
          <button class="about-package-btn" bindtap="openPackageDetail" data-id="{{item.id}}">详情</button>
          <button class="about-package-btn primary" bindtap="consultPackage" data-id="{{item.id}}">咨询</button>
        </view>
      </view>
    </view>

    <view class="content-section-card" wx:if="{{serviceFlow.enabled && serviceFlow.steps.length}}">
      <view class="section-title">服务流程</view>
      <view class="flow-item" wx:for="{{serviceFlow.steps}}" wx:key="title">
        <view class="flow-number">{{index + 1}}</view>
        <view>
          <view class="flow-title">{{item.title}}</view>
          <view class="flow-desc">{{item.description}}</view>
        </view>
      </view>
    </view>

    <view class="content-section-card" wx:if="{{faq.enabled && faq.items.length}}">
      <view class="section-title">常见问题</view>
      <view class="faq-item" wx:for="{{faq.items}}" wx:key="question">
        <view class="faq-question">{{item.question}}</view>
        <view class="faq-answer">{{item.answer}}</view>
      </view>
    </view>

    <view class="content-section-card" wx:if="{{testimonials.length}}">
      <view class="section-title">客户评价</view>
      <view class="review-card" wx:for="{{testimonials}}" wx:key="id">
        <view class="review-content">“{{item.content}}”</view>
        <view class="review-meta">{{item.name}} · {{item.shootType}} {{item.dateText}}</view>
      </view>
    </view>
  </view>

  <!-- 底部预约按钮 -->
  <view wx:if="{{consultButtonVisible}}" class="bottom-action">
    <button class="booking-btn" bindtap="goBooking">
      <text class="btn-icon">📅</text>
      <text>{{consultButton.text || '发起拍摄咨询'}}</text>
    </button>
  </view>

  <view wx:if="{{selectedStore}}" class="store-modal-mask" bindtap="closeStoreDetail">
    <view class="store-modal" catchtap="noop">
      <view class="store-modal-header">
        <view>
          <view class="store-modal-title">{{selectedStore.name}}</view>
          <view class="store-modal-subtitle">{{selectedStore.businessHours}}</view>
        </view>
        <button class="store-modal-close" bindtap="closeStoreDetail">×</button>
      </view>
      <view class="store-modal-row" wx:if="{{selectedStore.address}}">
        <view class="store-modal-label">地址</view>
        <view class="store-modal-value">{{selectedStore.address}}</view>
      </view>
      <view class="store-modal-row" wx:if="{{selectedStore.phone}}">
        <view class="store-modal-label">电话</view>
        <view class="store-modal-value">{{selectedStore.phone}}</view>
      </view>
      <view class="store-modal-row" wx:if="{{selectedStore.transportTips}}">
        <view class="store-modal-label">交通提示</view>
        <view class="store-modal-value">{{selectedStore.transportTips}}</view>
      </view>
      <view class="store-modal-actions">
        <button class="store-modal-btn" bindtap="copySelectedStoreAddress">复制地址</button>
        <button class="store-modal-btn primary" bindtap="closeStoreDetail">知道了</button>
      </view>
    </view>
  </view>
</view>
