<view wx:if="{{siteTemplate === 'dark-gallery'}}" class="dark-series-page" style="{{themeStyle}}">
  <dark-site-header title="{{seriesTitle}}" show-back="{{true}}" />
  <view wx:if="{{images.length}}" class="dark-series-cover-wrap">
    <image class="dark-series-cover" src="{{images[0].imageUrl}}" mode="aspectFill" bindtap="onImageTap" data-index="0" />
    <button class="dark-series-share" open-type="share">分享</button>
  </view>
  <view class="dark-series-intro">
    <view class="dark-series-heading">
      <view class="dark-series-title">{{seriesTitle}}</view>
      <view class="dark-series-layout-icons">
        <app-icon name="images" size="34" tone="muted" />
        <app-icon name="grid-2x2" size="34" tone="muted" />
      </view>
    </view>
    <view class="dark-series-tags">
      <text wx:if="{{seriesCategory}}">{{seriesCategory}}</text>
      <block wx:if="{{seriesInfo && seriesInfo.tags}}">
        <text wx:for="{{seriesInfo.tags}}" wx:key="*this">{{item}}</text>
      </block>
    </view>
    <view wx:if="{{seriesInfo && seriesInfo.description}}" class="dark-series-description">{{seriesInfo.description}}</view>
  </view>
  <view class="dark-series-images">
    <image wx:for="{{images}}" wx:key="id" wx:if="{{index > 0}}" src="{{item.imageUrl}}" mode="widthFix" lazy-load bindtap="onImageTap" data-index="{{index}}" binderror="onSeriesImageError" data-id="{{item.id}}" />
  </view>
  <view class="dark-series-dock">
    <view class="dark-series-brand">
      <app-icon name="sparkles" size="34" tone="primary" />
      <view><text class="dark-series-brand-name">{{brandName}}</text><text>记录值得珍藏的瞬间</text></view>
    </view>
    <button class="dark-series-dock-share" open-type="share" aria-label="分享"><app-icon name="navigation" size="30" tone="muted" /></button>
    <view wx:if="{{consultButtonVisible}}" class="dark-series-action" bindtap="consultSameStyle">{{showcase.seriesActionText || consultButton.text}}</view>
  </view>
</view>

<view wx:else class="series-page theme-{{themePreset}} gallery-{{decoration.galleryVariant}}" style="{{themeStyle}}">
  <block wx:for="{{decoration.sections}}" wx:key="id" wx:for-item="section">
    <block wx:if="{{section.enabled}}">
      <view class="series-header" wx:if="{{section.type === 'hero'}}">
        <view class="series-category">{{seriesCategory}}</view>
        <view class="series-title">{{seriesTitle}}</view>
        <view class="series-count">共 {{images.length}} 张{{terminology.workLabel}}</view>
        <view wx:if="{{seriesInfo && seriesInfo.description}}" class="series-description">{{seriesInfo.description}}</view>
      </view>

      <view
        wx:if="{{section.type === 'profile' && seriesInfo && (seriesInfo.suitableFor.length || seriesInfo.scenes.length || seriesInfo.tags.length)}}"
        class="series-profile"
      >
        <view class="section-title-row" wx:if="{{section.title}}"><app-icon wx:if="{{section.icon}}" name="{{section.icon}}" size="30" tone="primary" /><view class="section-title">{{section.title}}</view></view>
        <view class="section-subtitle" wx:if="{{section.subtitle}}">{{section.subtitle}}</view>
        <view wx:if="{{seriesInfo.suitableFor.length}}" class="profile-block">
          <view class="profile-label">适合</view>
          <view class="profile-tags"><text wx:for="{{seriesInfo.suitableFor}}" wx:key="*this" class="profile-tag">{{item}}</text></view>
        </view>
        <view wx:if="{{seriesInfo.scenes.length}}" class="profile-block">
          <view class="profile-label">场景</view>
          <view class="profile-tags"><text wx:for="{{seriesInfo.scenes}}" wx:key="*this" class="profile-tag">{{item}}</text></view>
        </view>
        <view wx:if="{{seriesInfo.tags.length}}" class="profile-block">
          <view class="profile-label">风格</view>
          <view class="profile-tags"><text wx:for="{{seriesInfo.tags}}" wx:key="*this" class="profile-tag">{{item}}</text></view>
        </view>
      </view>

      <view class="images-list" wx:if="{{section.type === 'gallery'}}">
        <view class="section-title-row" wx:if="{{section.title}}"><app-icon wx:if="{{section.icon}}" name="{{section.icon}}" size="30" tone="primary" /><view class="section-title">{{section.title}}</view></view>
        <view class="section-subtitle" wx:if="{{section.subtitle}}">{{section.subtitle}}</view>
        <view wx:for="{{images}}" wx:key="id" wx:for-item="imageItem" class="image-item" bindtap="onImageTap" data-index="{{index}}">
          <image class="image" src="{{imageItem.imageUrl}}" mode="widthFix" lazy-load binderror="onSeriesImageError" data-id="{{imageItem.id}}" />
          <view class="image-number">{{index + 1}} / {{images.length}}</view>
        </view>
      </view>

      <view class="detail-module" wx:if="{{section.type === 'packages' && packages.length}}">
        <view class="section-title-row"><app-icon wx:if="{{section.icon}}" name="{{section.icon}}" size="30" tone="primary" /><view class="section-title">{{section.title}}</view></view>
        <view class="section-subtitle" wx:if="{{section.subtitle}}">{{section.subtitle}}</view>
        <view class="related-package" wx:for="{{packages}}" wx:key="id" wx:for-item="packageItem">
          <view class="related-package-main">
            <view class="related-package-name">{{packageItem.name}}</view>
            <view class="related-package-desc">{{packageItem.subtitle}}</view>
          </view>
          <view class="related-package-side">
            <view class="related-package-price">{{packageItem.priceText}}</view>
            <view class="small-action" bindtap="consultPackage" data-id="{{packageItem.id}}">
              <app-icon name="message-circle" size="25" tone="inverse" />
              <text>{{terminology.consultationLabel}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="detail-module" wx:if="{{section.type === 'team' && photographers.length}}">
        <view class="section-title-row"><app-icon wx:if="{{section.icon}}" name="{{section.icon}}" size="30" tone="primary" /><view class="section-title">{{section.title}}</view></view>
        <view class="section-subtitle" wx:if="{{section.subtitle}}">{{section.subtitle}}</view>
        <view class="person-item" wx:for="{{photographers}}" wx:key="id">
          <view class="person-name">{{item.name}}</view>
          <view class="person-title">{{item.title}}</view>
          <view class="person-bio">{{item.bio}}</view>
        </view>
      </view>

      <view class="detail-module" wx:if="{{section.type === 'testimonials' && testimonials.length}}">
        <view class="section-title-row"><app-icon wx:if="{{section.icon}}" name="{{section.icon}}" size="30" tone="primary" /><view class="section-title">{{section.title}}</view></view>
        <view class="section-subtitle" wx:if="{{section.subtitle}}">{{section.subtitle}}</view>
        <view class="testimonial-item" wx:for="{{testimonials}}" wx:key="id">
          <view class="testimonial-content">“{{item.content}}”</view>
          <view class="testimonial-meta">{{item.name}} · {{item.shootType}} {{item.dateText}}</view>
        </view>
      </view>

      <view wx:if="{{section.type === 'action' && consultButtonVisible}}" class="series-action">
        <view class="btn-primary" bindtap="consultSameStyle">
          <app-icon name="message-circle" size="30" tone="inverse" />
          <text>{{section.actionText || consultButton.text || terminology.consultationLabel}}</text>
        </view>
      </view>
    </block>
  </block>

</view>
<quick-jump wx:if="{{siteTemplate !== 'dark-gallery' && quickJumpVisible}}" current="series" booking-text="{{quickJump.bookingText}}" portfolio-text="{{quickJump.portfolioText}}" appearance="{{quickJump.appearance}}" trigger-icon="{{quickJump.triggerIcon}}" booking-icon="{{quickJump.bookingIcon}}" portfolio-icon="{{quickJump.portfolioIcon}}" />
