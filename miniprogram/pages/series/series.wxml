<!-- 系列详情页 -->
<view class="series-page" style="{{themeStyle}}">
  <!-- 头部信息 -->
  <view class="series-header">
    <view class="series-title">{{seriesTitle}}</view>
    <view class="series-meta">
      <text class="series-category">{{seriesCategory}}</text>
      <text class="series-count">共 {{images.length}} 张</text>
    </view>
    <view wx:if="{{seriesInfo && seriesInfo.description}}" class="series-description">{{seriesInfo.description}}</view>
  </view>

  <view
    wx:if="{{seriesInfo && (seriesInfo.suitableFor.length || seriesInfo.scenes.length || seriesInfo.tags.length)}}"
    class="series-profile"
  >
    <view wx:if="{{seriesInfo.suitableFor.length}}" class="profile-block">
      <view class="profile-label">适合人群</view>
      <view class="profile-tags">
        <text wx:for="{{seriesInfo.suitableFor}}" wx:key="*this" class="profile-tag">{{item}}</text>
      </view>
    </view>
    <view wx:if="{{seriesInfo.scenes.length}}" class="profile-block">
      <view class="profile-label">拍摄场景</view>
      <view class="profile-tags">
        <text wx:for="{{seriesInfo.scenes}}" wx:key="*this" class="profile-tag muted">{{item}}</text>
      </view>
    </view>
    <view wx:if="{{seriesInfo.tags.length}}" class="profile-block">
      <view class="profile-label">风格标签</view>
      <view class="profile-tags">
        <text wx:for="{{seriesInfo.tags}}" wx:key="*this" class="profile-tag outline">{{item}}</text>
      </view>
    </view>
  </view>

  <!-- 图片列表 -->
  <view class="images-grid">
    <view 
      wx:for="{{images}}" 
      wx:key="id" 
      class="image-item"
      bindtap="onImageTap"
      data-index="{{index}}"
    >
      <image class="image" src="{{item.imageUrl}}" mode="aspectFill" lazy-load binderror="onSeriesImageError" data-id="{{item.id}}" />
      <view class="image-number">{{index + 1}}/{{images.length}}</view>
    </view>
  </view>

  <view class="detail-module" wx:if="{{packages.length}}">
    <view class="module-title">推荐套餐</view>
    <view class="related-package" wx:for="{{packages}}" wx:key="id">
      <view class="related-package-main">
        <view class="related-package-name">{{item.name}}</view>
        <view class="related-package-desc">{{item.subtitle}}</view>
      </view>
      <view class="related-package-side">
        <view class="related-package-price">{{item.priceText}}</view>
        <button class="small-consult-btn" bindtap="consultPackage" data-id="{{item.id}}">咨询此套餐</button>
      </view>
    </view>
  </view>

  <view class="detail-module" wx:if="{{photographers.length}}">
    <view class="module-title">关联摄影师</view>
    <view class="photographer-card" wx:for="{{photographers}}" wx:key="id">
      <view class="photographer-name">{{item.name}}</view>
      <view class="photographer-title">{{item.title}}</view>
      <view class="photographer-bio">{{item.bio}}</view>
    </view>
  </view>

  <view class="detail-module" wx:if="{{testimonials.length}}">
    <view class="module-title">相关评价</view>
    <view class="testimonial-card" wx:for="{{testimonials}}" wx:key="id">
      <view class="testimonial-content">“{{item.content}}”</view>
      <view class="testimonial-meta">{{item.name}} · {{item.shootType}} {{item.dateText}}</view>
    </view>
  </view>

  <view wx:if="{{consultButtonVisible}}" class="series-consult-bar">
    <button class="series-consult-btn" bindtap="consultSameStyle">{{consultButton.text || '咨询同款风格'}}</button>
  </view>
</view>
