.series-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 104rpx;
  background: var(--bg-light);
  color: var(--text-main);
  font-family: var(--font-family);
}

.series-header {
  padding: 48rpx var(--page-padding) 36rpx;
  background: var(--surface);
  border-bottom: 1rpx solid var(--divider);
}

.series-category {
  color: var(--secondary);
  font-size: 23rpx;
  font-weight: 600;
}

.series-title {
  margin-top: 8rpx;
  font-family: var(--title-font-family);
  font-size: 46rpx;
  font-weight: var(--title-weight);
  line-height: 1.2;
}

.series-count {
  margin-top: 12rpx;
  color: var(--text-muted);
  font-size: 24rpx;
}

.series-description {
  max-width: 650rpx;
  margin-top: 20rpx;
  color: var(--text-muted);
  font-size: 26rpx;
  line-height: 1.7;
}

.series-profile {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx 32rpx;
  padding: 24rpx var(--page-padding);
  background: var(--surface);
  border-bottom: 1rpx solid var(--divider);
}

.profile-block {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.profile-label {
  color: var(--text-muted);
  font-size: 22rpx;
}

.profile-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.profile-tag {
  padding: 6rpx 10rpx;
  background: var(--surface-muted);
  border-radius: 4rpx;
  color: var(--text-main);
  font-size: 22rpx;
}

.images-list {
  display: flex;
  padding: 24rpx var(--page-padding) 0;
  flex-direction: column;
  gap: 22rpx;
}

.image-item {
  position: relative;
  width: 100%;
  overflow: hidden;
  background: var(--surface-muted);
  border-radius: var(--image-radius);
}

.image {
  width: 100%;
  height: auto;
}

.image-number {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  padding: 6rpx 12rpx;
  border-radius: 6rpx;
  background: rgba(20, 19, 17, 0.68);
  color: var(--on-media);
  font-size: 21rpx;
}

.detail-module,
.series-action {
  margin: 48rpx var(--page-padding) 0;
  padding-top: 34rpx;
  border-top: 1rpx solid var(--divider);
}

.section-title {
  margin-bottom: 20rpx;
  font-size: 31rpx;
}

.related-package,
.person-item,
.testimonial-item {
  padding: 20rpx 0;
  border-top: 1rpx solid var(--divider);
}

.related-package:first-of-type,
.person-item:first-of-type,
.testimonial-item:first-of-type {
  padding-top: 0;
  border-top: 0;
}

.related-package {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.related-package-main {
  min-width: 0;
  flex: 1;
}

.related-package-name,
.person-name {
  font-size: 28rpx;
  font-weight: 600;
}

.related-package-desc,
.person-title,
.person-bio,
.testimonial-meta {
  margin-top: 5rpx;
  color: var(--text-muted);
  font-size: 24rpx;
  line-height: 1.6;
}

.related-package-side {
  display: flex;
  flex: 0 0 auto;
  align-items: flex-end;
  flex-direction: column;
  gap: 10rpx;
}

.related-package-price {
  color: var(--primary);
  font-size: 27rpx;
  font-weight: 650;
}

.small-action {
  display: flex;
  min-width: 112rpx;
  min-height: 58rpx;
  padding: 0 14rpx;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
  border-radius: var(--button-radius);
  background: var(--primary);
  color: var(--button-text);
  font-size: 23rpx;
  font-weight: 600;
}

.testimonial-content {
  font-family: var(--title-font-family);
  font-size: 27rpx;
  line-height: 1.75;
}

.series-action .btn-primary {
  gap: 10rpx;
  width: 100%;
}

.gallery-immersive .images-list {
  padding-right: 0;
  padding-left: 0;
  gap: 8rpx;
}

.gallery-immersive .image-item {
  border-radius: 0;
}

.gallery-framed .images-list {
  gap: 34rpx;
}

.gallery-framed .image-item {
  box-sizing: border-box;
  padding: 14rpx;
  border: 1rpx solid var(--divider);
  border-radius: var(--card-radius);
  background: var(--surface);
  box-shadow: var(--card-shadow);
}

.gallery-framed .image {
  border-radius: 4rpx;
}

.gallery-framed .image-number {
  right: 28rpx;
  bottom: 28rpx;
}

.skeleton-continuous .series-header {
  padding-bottom: 36rpx;
}

.skeleton-continuous .images-list {
  padding: 0;
}

.skeleton-continuous .image-item {
  margin: 0;
  border-radius: 0;
}

.skeleton-continuous .image-number {
  display: none;
}

.skeleton-editorial-album .images-list {
  padding: 36rpx 28rpx;
  background: var(--surface, #ffffff);
}

.skeleton-editorial-album .image-item:nth-child(2n) {
  width: 82%;
  margin-left: auto;
}

.skeleton-editorial-album .image-item:nth-child(2n + 1) {
  width: 92%;
}

.images-list.ratio-1-1 .image,
.images-list.ratio-3-4 .image,
.images-list.ratio-4-5 .image,
.images-list.ratio-16-9 .image {
  width: 100%;
}

.images-list.ratio-1-1 .image { aspect-ratio: 1 / 1; }
.images-list.ratio-3-4 .image { aspect-ratio: 3 / 4; }
.images-list.ratio-4-5 .image { aspect-ratio: 4 / 5; }
.images-list.ratio-16-9 .image { aspect-ratio: 16 / 9; }
.dark-series-page {
  min-height: 100vh;
  padding-bottom: calc(108rpx + env(safe-area-inset-bottom));
  color: #f4f3ef;
  background: #202020;
}

.dark-series-cover-wrap {
  position: relative;
  width: 100%;
  overflow: hidden;
  background: #181818;
}

.dark-series-cover {
  display: block;
  width: 100%;
  height: 1000rpx;
}

.dark-series-share {
  position: absolute;
  top: 116rpx;
  right: 0;
  display: flex;
  width: 120rpx;
  height: 58rpx;
  margin: 0;
  padding: 0;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 25rpx;
  line-height: 58rpx;
  border: 0;
  border-radius: 30rpx 0 0 30rpx;
  background: var(--primary, #69d7d8);
}

.dark-series-share::after,
.dark-series-dock-share::after {
  border: 0;
}

.dark-series-intro {
  padding: 42rpx 38rpx 50rpx;
  color: #3d3d3d;
  background: #ffffff;
}

.dark-series-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.dark-series-title {
  min-width: 0;
  overflow: hidden;
  font-size: 37rpx;
  font-weight: 600;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dark-series-layout-icons {
  display: flex;
  flex: 0 0 auto;
  gap: 26rpx;
}

.dark-series-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 26rpx;
}

.dark-series-tags text {
  padding: 7rpx 14rpx;
  color: #8a8a8a;
  font-size: 22rpx;
  background: #f3f3f3;
}

.dark-series-description {
  margin-top: 30rpx;
  color: #666666;
  font-size: 27rpx;
  line-height: 1.8;
}

.dark-series-images {
  background: #202020;
}

.dark-series-gallery-scroll {
  width: 100%;
  background: #202020;
}

.dark-series-images image {
  display: block;
  width: 100%;
  margin-top: 6rpx;
}

.dark-series-images.ratio-1-1 image,
.dark-series-images.ratio-3-4 image,
.dark-series-images.ratio-4-5 image,
.dark-series-images.ratio-16-9 image {
  height: auto;
  aspect-ratio: 3 / 4;
}

.dark-series-images.ratio-1-1 image { aspect-ratio: 1 / 1; }
.dark-series-images.ratio-4-5 image { aspect-ratio: 4 / 5; }
.dark-series-images.ratio-16-9 image { aspect-ratio: 16 / 9; }

.dark-series-images.columns-2,
.dark-series-images.columns-3,
.dark-series-images.columns-4 {
  display: grid;
  gap: 6rpx;
}

.dark-series-images.columns-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.dark-series-images.columns-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.dark-series-images.columns-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
.dark-series-images.columns-2 image,
.dark-series-images.columns-3 image,
.dark-series-images.columns-4 image { margin: 0; }
.dark-series-images.gap-airy { gap: 20rpx; padding: 20rpx; }
.dark-series-images.gap-tight { gap: 2rpx; }
.dark-series-images.mode-stack { display: block; padding: 0; }
.dark-series-images.mode-stack image + image { margin-top: 4rpx; }

.dark-series-images.mode-horizontal {
  display: flex;
  width: max-content;
  padding: 12rpx;
  gap: 12rpx;
}

.dark-series-images.mode-horizontal image { width: 520rpx; flex: 0 0 520rpx; }
.dark-series-images.mode-horizontal.columns-1 image { width: 650rpx; flex-basis: 650rpx; }
.dark-series-images.mode-horizontal.columns-3 image { width: 390rpx; flex-basis: 390rpx; }
.dark-series-images.mode-horizontal.columns-4 image { width: 300rpx; flex-basis: 300rpx; }
.dark-series-images.mode-mixed:not(.columns-1) image:first-child { grid-column: 1 / -1; aspect-ratio: 16 / 9; }

.dark-series-page.skeleton-editorial-album .dark-series-images {
  padding: 12rpx;
  gap: 12rpx;
}

.dark-series-page.skeleton-editorial-album .dark-series-images.ratio-natural image {
  height: 520rpx;
  margin: 0;
}

.dark-series-support {
  padding: 52rpx 38rpx;
  color: #eeeeee;
  border-top: 1rpx solid #343434;
  background: #202020;
}

.dark-series-support-title {
  margin-bottom: 28rpx;
  font-size: 31rpx;
  font-weight: 600;
}

.dark-series-support-row {
  display: flex;
  padding: 20rpx 0;
  justify-content: space-between;
  gap: 24rpx;
  color: #bdbdbd;
  border-top: 1rpx solid #383838;
  font-size: 25rpx;
}

.dark-series-team {
  display: flex;
  overflow: hidden;
  gap: 24rpx;
}

.dark-series-team > view {
  width: 150rpx;
  flex: 0 0 150rpx;
  text-align: center;
}

.dark-series-team image {
  display: block;
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 14rpx;
  border-radius: 50%;
}

.dark-series-team text,
.dark-series-quote {
  color: #bdbdbd;
  font-size: 24rpx;
  line-height: 1.7;
}

.dark-series-inline-action {
  display: flex;
  box-sizing: border-box;
  width: 300rpx;
  height: 74rpx;
  margin: 48rpx auto;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
  border: 1rpx solid rgba(255, 255, 255, 0.6);
}

.dark-series-dock {
  position: fixed;
  z-index: 900;
  right: 0;
  bottom: 0;
  left: 0;
  display: grid;
  box-sizing: content-box;
  height: 108rpx;
  padding-bottom: env(safe-area-inset-bottom);
  grid-template-columns: minmax(0, 1fr) 96rpx 156rpx;
  align-items: stretch;
  color: #252525;
  background: rgba(255, 255, 255, 0.98);
  border-top: 1rpx solid #eeeeee;
}

.dark-series-brand {
  display: flex;
  min-width: 0;
  padding: 0 20rpx;
  align-items: center;
  gap: 12rpx;
}

.dark-series-brand view {
  min-width: 0;
}

.dark-series-brand-name,
.dark-series-brand text {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dark-series-brand-name {
  font-size: 23rpx;
  font-weight: 600;
}

.dark-series-brand text {
  margin-top: 4rpx;
  color: var(--primary, #69d7d8);
  font-size: 16rpx;
}

.dark-series-dock-share {
  display: flex;
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 0;
  background: #ffffff;
}

.dark-series-action {
  display: flex;
  box-sizing: border-box;
  min-width: 0;
  height: 100%;
  padding: 0 18rpx;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
  background: var(--secondary, #f3a8b2);
}
