/* 系列详情页样式 */
.series-page {
  min-height: 100vh;
  background: var(--bg-light);
  padding-bottom: 40rpx;
}

/* 头部信息 */
.series-header {
  padding: 48rpx 32rpx 32rpx;
  background: #fff;
  border-bottom: 1rpx solid #f5f5f4;
}

.series-title {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--text-main);
  margin-bottom: 16rpx;
}

.series-meta {
  display: flex;
  align-items: center;
  gap: 24rpx;
  font-size: 26rpx;
  color: var(--text-muted);
}

.series-category {
  padding: 8rpx 20rpx;
  background: rgba(124,106,93,0.1);
  color: var(--primary);
  border-radius: 8rpx;
  font-weight: 500;
}

.series-count {
  color: var(--text-muted);
}

/* 图片网格 */
.images-grid {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.image-item {
  position: relative;
  width: 100%;
  height: 900rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #f5f5f4;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.08);
}

.image {
  width: 100%;
  height: 100%;
}

.image-number {
  position: absolute;
  bottom: 24rpx;
  right: 24rpx;
  padding: 12rpx 20rpx;
  background: rgba(0,0,0,0.6);
  color: #fff;
  font-size: 24rpx;
  border-radius: 20rpx;
  backdrop-filter: blur(10rpx);
}
