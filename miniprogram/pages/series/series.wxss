.series-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 104rpx;
  background: var(--bg-light);
  color: var(--text-main);
  font-family: var(--font-family);
}

.series-header {
  padding: 48rpx var(--page-padding) 36rpx;
  background: var(--surface);
  border-bottom: 1rpx solid var(--divider);
}

.series-category {
  color: var(--secondary);
  font-size: 23rpx;
  font-weight: 600;
}

.series-title {
  margin-top: 8rpx;
  font-family: var(--title-font-family);
  font-size: 46rpx;
  font-weight: var(--title-weight);
  line-height: 1.2;
}

.series-count {
  margin-top: 12rpx;
  color: var(--text-muted);
  font-size: 24rpx;
}

.series-description {
  max-width: 650rpx;
  margin-top: 20rpx;
  color: var(--text-muted);
  font-size: 26rpx;
  line-height: 1.7;
}

.series-profile {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx 32rpx;
  padding: 24rpx var(--page-padding);
  background: var(--surface);
  border-bottom: 1rpx solid var(--divider);
}

.profile-block {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.profile-label {
  color: var(--text-muted);
  font-size: 22rpx;
}

.profile-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.profile-tag {
  padding: 6rpx 10rpx;
  background: var(--surface-muted);
  border-radius: 4rpx;
  color: var(--text-main);
  font-size: 22rpx;
}

.images-list {
  display: flex;
  padding: 24rpx var(--page-padding) 0;
  flex-direction: column;
  gap: 22rpx;
}

.image-item {
  position: relative;
  width: 100%;
  overflow: hidden;
  background: var(--surface-muted);
  border-radius: var(--image-radius);
}

.image {
  width: 100%;
  height: auto;
}

.image-number {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  padding: 6rpx 12rpx;
  border-radius: 6rpx;
  background: rgba(20, 19, 17, 0.68);
  color: var(--on-media);
  font-size: 21rpx;
}

.detail-module,
.series-action {
  margin: 48rpx var(--page-padding) 0;
  padding-top: 34rpx;
  border-top: 1rpx solid var(--divider);
}

.section-title {
  margin-bottom: 20rpx;
  font-size: 31rpx;
}

.related-package,
.person-item,
.testimonial-item {
  padding: 20rpx 0;
  border-top: 1rpx solid var(--divider);
}

.related-package:first-of-type,
.person-item:first-of-type,
.testimonial-item:first-of-type {
  padding-top: 0;
  border-top: 0;
}

.related-package {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.related-package-main {
  min-width: 0;
  flex: 1;
}

.related-package-name,
.person-name {
  font-size: 28rpx;
  font-weight: 600;
}

.related-package-desc,
.person-title,
.person-bio,
.testimonial-meta {
  margin-top: 5rpx;
  color: var(--text-muted);
  font-size: 24rpx;
  line-height: 1.6;
}

.related-package-side {
  display: flex;
  flex: 0 0 auto;
  align-items: flex-end;
  flex-direction: column;
  gap: 10rpx;
}

.related-package-price {
  color: var(--primary);
  font-size: 27rpx;
  font-weight: 650;
}

.small-action {
  display: flex;
  min-width: 112rpx;
  min-height: 58rpx;
  padding: 0 14rpx;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
  border-radius: var(--button-radius);
  background: var(--primary);
  color: var(--button-text);
  font-size: 23rpx;
  font-weight: 600;
}

.testimonial-content {
  font-family: var(--title-font-family);
  font-size: 27rpx;
  line-height: 1.75;
}

.series-action .btn-primary {
  gap: 10rpx;
  width: 100%;
}

.gallery-immersive .images-list {
  padding-right: 0;
  padding-left: 0;
  gap: 8rpx;
}

.gallery-immersive .image-item {
  border-radius: 0;
}

.gallery-framed .images-list {
  gap: 34rpx;
}

.gallery-framed .image-item {
  box-sizing: border-box;
  padding: 14rpx;
  border: 1rpx solid var(--divider);
  border-radius: var(--card-radius);
  background: var(--surface);
  box-shadow: var(--card-shadow);
}

.gallery-framed .image {
  border-radius: 4rpx;
}

.gallery-framed .image-number {
  right: 28rpx;
  bottom: 28rpx;
}
.dark-series-page {
  min-height: 100vh;
  padding-bottom: calc(108rpx + env(safe-area-inset-bottom));
  color: #f4f3ef;
  background: #202020;
}

.dark-series-cover-wrap {
  position: relative;
  width: 100%;
  overflow: hidden;
  background: #181818;
}

.dark-series-cover {
  display: block;
  width: 100%;
  height: 1000rpx;
}

.dark-series-share {
  position: absolute;
  top: 116rpx;
  right: 0;
  display: flex;
  width: 120rpx;
  height: 58rpx;
  margin: 0;
  padding: 0;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 25rpx;
  line-height: 58rpx;
  border: 0;
  border-radius: 30rpx 0 0 30rpx;
  background: var(--primary, #69d7d8);
}

.dark-series-share::after,
.dark-series-dock-share::after {
  border: 0;
}

.dark-series-intro {
  padding: 42rpx 38rpx 50rpx;
  color: #3d3d3d;
  background: #ffffff;
}

.dark-series-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.dark-series-title {
  min-width: 0;
  overflow: hidden;
  font-size: 37rpx;
  font-weight: 600;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dark-series-layout-icons {
  display: flex;
  flex: 0 0 auto;
  gap: 26rpx;
}

.dark-series-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 26rpx;
}

.dark-series-tags text {
  padding: 7rpx 14rpx;
  color: #8a8a8a;
  font-size: 22rpx;
  background: #f3f3f3;
}

.dark-series-description {
  margin-top: 30rpx;
  color: #666666;
  font-size: 27rpx;
  line-height: 1.8;
}

.dark-series-images {
  background: #202020;
}

.dark-series-images image {
  display: block;
  width: 100%;
  margin-top: 6rpx;
}

.dark-series-dock {
  position: fixed;
  z-index: 900;
  right: 0;
  bottom: 0;
  left: 0;
  display: grid;
  box-sizing: content-box;
  height: 108rpx;
  padding-bottom: env(safe-area-inset-bottom);
  grid-template-columns: minmax(0, 1fr) 96rpx 156rpx;
  align-items: stretch;
  color: #252525;
  background: rgba(255, 255, 255, 0.98);
  border-top: 1rpx solid #eeeeee;
}

.dark-series-brand {
  display: flex;
  min-width: 0;
  padding: 0 20rpx;
  align-items: center;
  gap: 12rpx;
}

.dark-series-brand view {
  min-width: 0;
}

.dark-series-brand-name,
.dark-series-brand text {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dark-series-brand-name {
  font-size: 23rpx;
  font-weight: 600;
}

.dark-series-brand text {
  margin-top: 4rpx;
  color: var(--primary, #69d7d8);
  font-size: 16rpx;
}

.dark-series-dock-share {
  display: flex;
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 0;
  background: #ffffff;
}

.dark-series-action {
  display: flex;
  box-sizing: border-box;
  min-width: 0;
  height: 100%;
  padding: 0 18rpx;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
  background: var(--secondary, #f3a8b2);
}
