.series-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 104rpx;
  background: var(--bg-light);
  color: var(--text-main);
  font-family: var(--font-family);
}

.series-header {
  padding: 48rpx var(--page-padding) 36rpx;
  background: var(--surface);
  border-bottom: 1rpx solid var(--divider);
}

.series-category {
  color: var(--secondary);
  font-size: 23rpx;
  font-weight: 600;
}

.series-title {
  margin-top: 8rpx;
  font-family: var(--title-font-family);
  font-size: 46rpx;
  font-weight: var(--title-weight);
  line-height: 1.2;
}

.series-count {
  margin-top: 12rpx;
  color: var(--text-muted);
  font-size: 24rpx;
}

.series-description {
  max-width: 650rpx;
  margin-top: 20rpx;
  color: var(--text-muted);
  font-size: 26rpx;
  line-height: 1.7;
}

.series-profile {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx 32rpx;
  padding: 24rpx var(--page-padding);
  background: var(--surface);
  border-bottom: 1rpx solid var(--divider);
}

.profile-block {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.profile-label {
  color: var(--text-muted);
  font-size: 22rpx;
}

.profile-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.profile-tag {
  padding: 6rpx 10rpx;
  background: var(--surface-muted);
  border-radius: 4rpx;
  color: var(--text-main);
  font-size: 22rpx;
}

.images-list {
  display: flex;
  padding: 24rpx var(--page-padding) 0;
  flex-direction: column;
  gap: 22rpx;
}

.image-item {
  position: relative;
  width: 100%;
  overflow: hidden;
  background: var(--surface-muted);
  border-radius: var(--image-radius);
}

.image {
  width: 100%;
  height: auto;
}

.image-number {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  padding: 6rpx 12rpx;
  border-radius: 6rpx;
  background: rgba(20, 19, 17, 0.68);
  color: var(--on-media);
  font-size: 21rpx;
}

.detail-module,
.series-action {
  margin: 48rpx var(--page-padding) 0;
  padding-top: 34rpx;
  border-top: 1rpx solid var(--divider);
}

.section-title {
  margin-bottom: 20rpx;
  font-size: 31rpx;
}

.related-package,
.person-item,
.testimonial-item {
  padding: 20rpx 0;
  border-top: 1rpx solid var(--divider);
}

.related-package:first-of-type,
.person-item:first-of-type,
.testimonial-item:first-of-type {
  padding-top: 0;
  border-top: 0;
}

.related-package {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.related-package-main {
  min-width: 0;
  flex: 1;
}

.related-package-name,
.person-name {
  font-size: 28rpx;
  font-weight: 600;
}

.related-package-desc,
.person-title,
.person-bio,
.testimonial-meta {
  margin-top: 5rpx;
  color: var(--text-muted);
  font-size: 24rpx;
  line-height: 1.6;
}

.related-package-side {
  display: flex;
  flex: 0 0 auto;
  align-items: flex-end;
  flex-direction: column;
  gap: 10rpx;
}

.related-package-price {
  color: var(--primary);
  font-size: 27rpx;
  font-weight: 650;
}

.small-action {
  display: flex;
  min-width: 112rpx;
  min-height: 58rpx;
  padding: 0 14rpx;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
  border-radius: var(--button-radius);
  background: var(--primary);
  color: var(--button-text);
  font-size: 23rpx;
  font-weight: 600;
}

.testimonial-content {
  font-family: var(--title-font-family);
  font-size: 27rpx;
  line-height: 1.75;
}

.series-action .btn-primary {
  gap: 10rpx;
  width: 100%;
}

.gallery-immersive .images-list {
  padding-right: 0;
  padding-left: 0;
  gap: 8rpx;
}

.gallery-immersive .image-item {
  border-radius: 0;
}

.gallery-framed .images-list {
  gap: 34rpx;
}

.gallery-framed .image-item {
  box-sizing: border-box;
  padding: 14rpx;
  border: 1rpx solid var(--divider);
  border-radius: var(--card-radius);
  background: var(--surface);
  box-shadow: var(--card-shadow);
}

.gallery-framed .image {
  border-radius: 4rpx;
}

.gallery-framed .image-number {
  right: 28rpx;
  bottom: 28rpx;
}
