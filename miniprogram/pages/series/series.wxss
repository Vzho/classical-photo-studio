/* 系列详情页样式 */
.series-page {
  min-height: 100vh;
  background: var(--bg-light);
  padding-bottom: 180rpx;
}

/* 头部信息 */
.series-header {
  padding: 48rpx 32rpx 32rpx;
  background: #fff;
  border-bottom: 1rpx solid #f5f5f4;
}

.series-title {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--text-main);
  margin-bottom: 16rpx;
}

.series-meta {
  display: flex;
  align-items: center;
  gap: 24rpx;
  font-size: 26rpx;
  color: var(--text-muted);
}

.series-category {
  padding: 8rpx 20rpx;
  background: rgba(124,106,93,0.1);
  color: var(--primary);
  border-radius: 8rpx;
  font-weight: 500;
}

.series-count {
  color: var(--text-muted);
}

.series-description {
  margin-top: 22rpx;
  color: var(--text-muted);
  font-size: 26rpx;
  line-height: 1.75;
}

.series-profile {
  margin: 24rpx 24rpx 0;
  padding: var(--card-padding, 28rpx);
  background: #fff;
  border-radius: var(--card-radius, 24rpx);
  border: 2rpx solid var(--card-border, #f5f5f4);
  box-shadow: var(--card-shadow, 0 8rpx 24rpx rgba(0,0,0,0.03));
}

.profile-block {
  margin-bottom: 24rpx;
}

.profile-block:last-child {
  margin-bottom: 0;
}

.profile-label {
  margin-bottom: 14rpx;
  color: var(--text-main);
  font-size: 26rpx;
  font-weight: bold;
}

.profile-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.profile-tag {
  padding: 10rpx 18rpx;
  border-radius: 12rpx;
  background: rgba(124,106,93,0.1);
  color: var(--primary);
  font-size: 24rpx;
  line-height: 1.2;
}

.profile-tag.muted {
  background: #f5f5f4;
  color: var(--text-muted);
}

.profile-tag.outline {
  background: #fff;
  border: 1rpx solid #e7e5e4;
  color: var(--text-main);
}

/* 图片网格 */
.images-grid {
  padding: var(--page-padding, 24rpx);
  display: flex;
  flex-direction: column;
  gap: var(--section-gap, 24rpx);
}

.image-item {
  position: relative;
  width: 100%;
  height: 900rpx;
  border-radius: var(--image-radius, 24rpx);
  overflow: hidden;
  background: #f5f5f4;
  box-shadow: var(--card-shadow, 0 8rpx 32rpx rgba(0,0,0,0.08));
}

.image {
  width: 100%;
  height: 100%;
}

.image-number {
  position: absolute;
  bottom: 24rpx;
  right: 24rpx;
  padding: 12rpx 20rpx;
  background: rgba(0,0,0,0.6);
  color: #fff;
  font-size: 24rpx;
  border-radius: 20rpx;
  backdrop-filter: blur(10rpx);
}

.detail-module {
  margin: 0 24rpx var(--section-gap, 24rpx);
  padding: var(--card-padding, 28rpx);
  background: #fff;
  border-radius: var(--card-radius, 24rpx);
  border: 2rpx solid var(--card-border, #f5f5f4);
  box-shadow: var(--card-shadow, 0 8rpx 24rpx rgba(0,0,0,0.03));
}

.module-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-main);
  margin-bottom: 20rpx;
}

.related-package,
.photographer-card,
.testimonial-card {
  padding: var(--card-padding, 22rpx);
  border-radius: var(--card-radius, 18rpx);
  background: #fafaf9;
  margin-bottom: 16rpx;
}

.related-package {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.related-package-main {
  flex: 1;
}

.related-package-name,
.photographer-name {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-main);
  margin-bottom: 8rpx;
}

.related-package-desc,
.photographer-title,
.photographer-bio,
.testimonial-meta {
  font-size: 24rpx;
  color: var(--text-muted);
  line-height: 1.6;
}

.related-package-side {
  width: 190rpx;
  flex-shrink: 0;
  text-align: right;
}

.related-package-price {
  color: var(--primary);
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.small-consult-btn {
  height: 62rpx;
  padding: 0 18rpx;
  border: none;
  border-radius: var(--button-radius, 16rpx);
  background: var(--primary);
  color: #fff;
  font-size: 23rpx;
  font-weight: bold;
}

.small-consult-btn::after {
  border: none;
}

.testimonial-content {
  font-size: 26rpx;
  color: var(--text-main);
  line-height: 1.8;
  margin-bottom: 10rpx;
}

.series-consult-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(255,255,255,0.96);
  box-shadow: 0 -8rpx 32rpx rgba(0,0,0,0.05);
}

.series-consult-btn {
  width: 100%;
  height: 96rpx;
  border: none;
  border-radius: var(--button-radius, 24rpx);
  background: var(--primary);
  color: #fff;
  font-size: 30rpx;
  font-weight: bold;
}

.series-consult-btn::after {
  border: none;
}
