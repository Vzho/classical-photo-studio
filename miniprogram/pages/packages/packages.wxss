.packages-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 44rpx var(--page-padding) 112rpx;
  background: var(--bg-light);
  color: var(--text-main);
  font-family: var(--font-family);
}

.page-header {
  max-width: 640rpx;
  margin-bottom: 36rpx;
}

.page-title {
  font-family: var(--title-font-family);
  font-size: 50rpx;
  font-weight: var(--title-weight);
  line-height: 1.15;
}

.page-desc,
.schedule-desc,
.empty-desc,
.testimonial-meta {
  color: var(--text-muted);
  font-size: 25rpx;
  line-height: 1.65;
}

.page-desc {
  margin-top: 14rpx;
}

.schedule-notice {
  display: flex;
  gap: 18rpx;
  padding: 22rpx 0;
  margin-bottom: 32rpx;
  border-top: 1rpx solid var(--divider);
  border-bottom: 1rpx solid var(--divider);
}

.schedule-copy {
  min-width: 0;
}

.schedule-title {
  font-size: 23rpx;
  font-weight: 600;
  color: var(--secondary);
}

.schedule-main {
  margin-top: 4rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.schedule-desc {
  margin-top: 4rpx;
}

.empty-state {
  display: flex;
  min-height: 520rpx;
  padding: 72rpx 28rpx;
  align-items: center;
  flex-direction: column;
  text-align: center;
}

.empty-title {
  margin-top: 20rpx;
  font-size: 32rpx;
  font-weight: var(--title-weight);
}

.empty-desc {
  max-width: 520rpx;
  margin-top: 12rpx;
}

.empty-action {
  gap: 10rpx;
  width: 300rpx;
  margin-top: 30rpx;
}

.package-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.package-card {
  padding: 30rpx 28rpx;
  background: var(--surface);
  border: 1rpx solid var(--divider);
  border-radius: var(--card-radius);
  box-shadow: var(--card-shadow);
}

.package-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.package-heading-main {
  min-width: 0;
}

.package-badge {
  display: inline-block;
  margin-bottom: 10rpx;
  color: var(--secondary);
  font-size: 22rpx;
  font-weight: 600;
}

.package-name {
  font-family: var(--title-font-family);
  font-size: 34rpx;
  font-weight: var(--title-weight);
  line-height: 1.3;
}

.package-price {
  flex: 0 0 auto;
  color: var(--primary);
  font-size: 33rpx;
  font-weight: 650;
  line-height: 1.3;
}

.package-subtitle {
  margin-top: 10rpx;
  color: var(--text-muted);
  font-size: 25rpx;
  line-height: 1.6;
}

.package-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 24rpx;
  padding: 22rpx 0;
  margin-top: 20rpx;
  border-top: 1rpx solid var(--divider);
  border-bottom: 1rpx solid var(--divider);
}

.meta-item,
.include-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: var(--text-muted);
  font-size: 24rpx;
  line-height: 1.5;
}

.package-block {
  margin-top: 24rpx;
}

.package-block-title {
  margin-bottom: 12rpx;
  font-size: 25rpx;
  font-weight: 600;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.tag {
  padding: 8rpx 14rpx;
  background: var(--surface-muted);
  border-radius: 6rpx;
  color: var(--text-muted);
  font-size: 23rpx;
}

.include-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx 20rpx;
}

.package-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 28rpx;
}

.package-action {
  gap: 8rpx;
  min-width: 0;
  padding: 0 16rpx;
  font-size: 25rpx;
}

.package-detail-link {
  display: flex;
  align-items: center;
  gap: 4rpx;
  min-height: 64rpx;
  color: var(--text-main);
  font-size: 24rpx;
  font-weight: 600;
}

.package-consult-action {
  width: auto;
  min-width: 230rpx;
  max-width: 360rpx;
  flex: 0 1 auto;
}

.testimonial-section {
  margin-top: 56rpx;
}

.testimonial-item {
  padding: 24rpx 0;
  border-top: 1rpx solid var(--divider);
}

.testimonial-content {
  font-family: var(--title-font-family);
  font-size: 28rpx;
  line-height: 1.75;
}

.testimonial-meta {
  margin-top: 10rpx;
}

.layout-list .package-list {
  gap: 0;
  border-top: 1rpx solid var(--divider);
}

.layout-list .package-card {
  padding: 30rpx 0;
  border: 0;
  border-bottom: 1rpx solid var(--divider);
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.layout-list .package-meta {
  padding: 16rpx 0;
  margin-top: 14rpx;
}

.layout-list .package-block {
  margin-top: 18rpx;
}

.layout-list .package-actions {
  margin-top: 22rpx;
}
