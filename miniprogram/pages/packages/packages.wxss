.packages-page {
  min-height: 100vh;
  padding: 36rpx 32rpx 80rpx;
  background: #fafaf9;
  box-sizing: border-box;
}

.page-header {
  margin-bottom: 28rpx;
}

.page-kicker {
  font-size: 22rpx;
  color: var(--primary);
  font-weight: bold;
  letter-spacing: 0;
  margin-bottom: 8rpx;
}

.page-title {
  font-size: 48rpx;
  font-weight: bold;
  color: var(--text-main);
  margin-bottom: 14rpx;
}

.page-desc,
.schedule-notice,
.empty-desc,
.testimonial-meta {
  font-size: 25rpx;
  color: var(--text-muted);
  line-height: 1.7;
}

.schedule-card,
.empty-card,
.package-card,
.testimonial-card {
  background: #fff;
  border: 2rpx solid #f5f5f4;
  border-radius: 22rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.03);
}

.schedule-card,
.empty-card {
  margin-bottom: 24rpx;
}

.schedule-title,
.empty-title,
.module-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-main);
  margin-bottom: 12rpx;
}

.schedule-main {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--primary);
  margin-bottom: 8rpx;
}

.package-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.package-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 20rpx;
}

.package-badge {
  display: inline-flex;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(124,106,93,0.12);
  color: var(--primary);
  font-size: 22rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.package-name {
  font-size: 34rpx;
  font-weight: bold;
  color: var(--text-main);
}

.package-subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-muted);
  line-height: 1.6;
}

.package-price {
  flex-shrink: 0;
  font-size: 34rpx;
  font-weight: bold;
  color: var(--primary);
}

.package-meta {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
  margin-bottom: 22rpx;
}

.package-meta view {
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  background: #fafaf9;
  color: #57534e;
  font-size: 24rpx;
}

.section-block {
  margin-top: 22rpx;
}

.section-title {
  margin-bottom: 12rpx;
  color: var(--text-main);
  font-size: 26rpx;
  font-weight: bold;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #f5f5f4;
  color: #57534e;
  font-size: 23rpx;
}

.include-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.include-item {
  color: #57534e;
  font-size: 25rpx;
  line-height: 1.6;
}

.include-item::before {
  content: "✓ ";
  color: var(--primary);
  font-weight: bold;
}

.consult-btn {
  width: 100%;
  height: 92rpx;
  margin-top: 28rpx;
  border: none;
  border-radius: 22rpx;
  background: var(--primary);
  color: #fff;
  font-size: 30rpx;
  font-weight: bold;
}

.consult-btn::after {
  border: none;
}

.testimonial-section {
  margin-top: 36rpx;
}

.testimonial-section .module-title {
  margin-bottom: 18rpx;
}

.testimonial-card {
  margin-bottom: 16rpx;
}

.testimonial-content {
  font-size: 27rpx;
  line-height: 1.8;
  color: var(--text-main);
  margin-bottom: 12rpx;
}
