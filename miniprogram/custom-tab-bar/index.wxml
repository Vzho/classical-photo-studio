<view class="tab-bar nav-style-{{navigationStyle}} theme-{{themePreset}}" style="{{themeStyle}}">
  <view 
    wx:for="{{list}}" 
    wx:key="index" 
    class="tab-item {{selected === index ? 'active' : ''}}"
    bindtap="switchTab"
    data-path="{{item.pagePath}}"
    data-index="{{index}}"
  >
    <view class="tab-indicator"></view>
    <view class="tab-icon-shell">
      <app-icon
        name="{{item.icon}}"
        src="{{item.customIcon}}"
        size="38"
        tone="{{themePreset === 'oriental-premium' || themePreset === 'editorial-studio' || themePreset === 'cinematic-story' ? 'inverse' : (selected === index ? 'primary' : 'muted')}}"
      />
    </view>
    <view class="tab-text">{{item.text}}</view>
  </view>
</view>
