.tab-bar {
  position: fixed;
  z-index: 900;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: stretch;
  height: 108rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: var(--surface, #fff);
  border-top: 1rpx solid var(--divider, #dedad1);
  color: var(--text-main, #242321);
  font-family: var(--font-family, -apple-system, BlinkMacSystemFont, Helvetica Neue, Arial, sans-serif);
}

.tab-item {
  position: relative;
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
  padding: 10rpx 0 8rpx;
}

.tab-indicator {
  position: absolute;
  top: 0;
  left: 50%;
  width: 40rpx;
  height: 3rpx;
  background: transparent;
  transform: translateX(-50%);
}

.tab-icon-shell {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
}

.tab-text {
  max-width: 180rpx;
  margin-top: 2rpx;
  overflow: hidden;
  color: var(--text-muted, #706d66);
  font-size: 20rpx;
  font-weight: 400;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tab-item.active .tab-indicator {
  background: var(--primary, #242321);
}

.tab-item.active .tab-text {
  color: var(--text-main, #242321);
  font-weight: 600;
}

.nav-style-quiet .tab-indicator {
  top: auto;
  bottom: 12rpx;
  width: 5rpx;
  height: 5rpx;
  border-radius: 50%;
}

.theme-oriental-premium.tab-bar {
  background: #fffdf8;
  border-top: 2rpx solid var(--accent);
}

.theme-oriental-premium .tab-indicator {
  width: 52rpx;
  height: 3rpx;
  background: transparent;
}

.theme-oriental-premium .tab-item.active .tab-indicator {
  background: var(--accent);
}

.theme-oriental-premium .tab-text {
  font-family: var(--title-font-family);
}

.theme-editorial-studio.tab-bar {
  height: 104rpx;
  background: #ffffff;
  border-top: 4rpx solid #111111;
}

.theme-editorial-studio .tab-indicator {
  width: calc(100% - 34rpx);
  height: 7rpx;
}

.theme-editorial-studio .tab-item.active .tab-indicator {
  background: var(--accent);
}

.theme-editorial-studio .tab-text {
  color: #686862;
  font-size: 19rpx;
  font-weight: 650;
}

.theme-editorial-studio .tab-item.active .tab-text {
  color: #111111;
  font-weight: 750;
}

.theme-luminous-portrait.tab-bar {
  background: rgba(255, 255, 255, 0.96);
  border-top-color: var(--divider);
}

.theme-luminous-portrait .tab-indicator {
  display: none;
}

.theme-luminous-portrait .tab-icon-shell {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
}

.theme-luminous-portrait .tab-item.active .tab-icon-shell {
  background: var(--surface-muted);
}

.theme-luminous-portrait .tab-text {
  margin-top: 4rpx;
}
