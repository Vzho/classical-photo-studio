.tab-bar {
  position: fixed;
  z-index: 900;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: stretch;
  height: calc(var(--tab-bar-height, 108rpx) + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: var(--surface, #fff);
  border-top: 1rpx solid var(--divider, #dedad1);
  color: var(--text-main, #242321);
  font-family: var(--font-family, -apple-system, BlinkMacSystemFont, Helvetica Neue, Arial, sans-serif);
}

.tab-item {
  position: relative;
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
  padding: 10rpx 0 8rpx;
}

.tab-indicator {
  position: absolute;
  top: 0;
  left: 50%;
  width: 40rpx;
  height: 3rpx;
  background: transparent;
  transform: translateX(-50%);
}

.tab-icon-shell {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
}

.tab-text {
  max-width: 180rpx;
  margin-top: 2rpx;
  overflow: hidden;
  color: var(--text-muted, #706d66);
  font-size: 20rpx;
  font-weight: 400;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tab-item.active .tab-indicator {
  background: var(--primary, #242321);
}

.tab-item.active .tab-text {
  color: var(--text-main, #242321);
  font-weight: 600;
}

.nav-style-quiet .tab-indicator {
  top: auto;
  bottom: 12rpx;
  width: 5rpx;
  height: 5rpx;
  border-radius: 50%;
}

.theme-oriental-premium.tab-bar {
  background: var(--secondary);
  border-top: 2rpx solid var(--accent);
}

.theme-oriental-premium .tab-indicator {
  width: 52rpx;
  height: 3rpx;
  background: transparent;
}

.theme-oriental-premium .tab-item.active .tab-indicator {
  background: var(--accent);
}

.theme-oriental-premium .tab-text {
  color: rgba(252, 251, 247, 0.64);
  font-family: var(--title-font-family);
}

.theme-oriental-premium .tab-item.active .tab-text {
  color: #fcfbf7;
}

.theme-editorial-studio.tab-bar {
  height: 104rpx;
  background: #101010;
  border-top: 6rpx solid var(--secondary);
}

.theme-editorial-studio .tab-indicator {
  width: calc(100% - 34rpx);
  height: 7rpx;
}

.theme-editorial-studio .tab-item.active .tab-indicator {
  background: var(--accent);
}

.theme-editorial-studio .tab-text {
  color: rgba(255, 255, 255, 0.56);
  font-size: 19rpx;
  font-weight: 650;
}

.theme-editorial-studio .tab-item.active .tab-text {
  color: #ffffff;
  font-weight: 750;
}

.theme-luminous-portrait.tab-bar {
  background: #ffffff;
  border-top-color: var(--divider);
}

.theme-luminous-portrait .tab-indicator {
  display: block;
  width: 52rpx;
  height: 3rpx;
}

.theme-luminous-portrait .tab-icon-shell {
  width: 48rpx;
  height: 48rpx;
  border-radius: 0;
}

.theme-luminous-portrait .tab-item.active .tab-icon-shell {
  background: transparent;
}

.theme-luminous-portrait .tab-item.active .tab-indicator {
  background: var(--accent);
}

.theme-luminous-portrait .tab-text {
  margin-top: 4rpx;
}

.theme-cinematic-story.tab-bar {
  height: 106rpx;
  border-top: 4rpx solid var(--primary);
  background: #080a09;
}

.theme-cinematic-story .tab-indicator {
  width: 56rpx;
  height: 4rpx;
  background: transparent;
}

.theme-cinematic-story .tab-item.active .tab-indicator {
  background: var(--accent);
}

.theme-cinematic-story .tab-text {
  color: rgba(242, 239, 231, 0.56);
  font-family: var(--title-font-family);
  font-size: 19rpx;
}

.theme-cinematic-story .tab-item.active .tab-text {
  color: #f2efe7;
}

.theme-gallery-monograph.tab-bar {
  border-top: 2rpx solid var(--text-main);
  background: var(--surface);
}

.theme-gallery-monograph .tab-indicator {
  width: 58rpx;
  height: 6rpx;
  border-radius: 0;
}

.theme-gallery-monograph .tab-item.active .tab-indicator {
  background: var(--primary);
}

.theme-gallery-monograph .tab-icon-shell {
  border-radius: 0;
}

.theme-gallery-monograph .tab-text {
  font-size: 19rpx;
  font-weight: 500;
}
