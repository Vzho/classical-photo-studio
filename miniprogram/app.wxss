/* 全局样式 */
page {
  --primary: #7c6a5d;
  --secondary: #a67c52;
  --accent: #c9a86c;
  --text-main: #292524;
  --text-muted: #78716c;
  --bg-light: #fafaf9;
  --surface: #ffffff;
  
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  background-color: var(--bg-light);
  color: var(--text-main);
  font-size: 28rpx;
  line-height: 1.5;
}

.container {
  padding: 32rpx;
}

.btn-primary {
  background-color: var(--primary);
  color: #fff;
  border-radius: 24rpx;
  padding: 28rpx 0;
  text-align: center;
  font-weight: bold;
  font-size: 32rpx;
}

.btn-primary:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.card {
  background: var(--surface);
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 24rpx;
}
