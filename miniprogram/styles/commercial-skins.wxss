.theme-editorial-studio .section-heading,
.theme-luminous-portrait .section-heading {
  align-items: flex-start;
}

.theme-oriental-premium .section-link,
.theme-editorial-studio .section-link,
.theme-luminous-portrait .section-link {
  min-height: 48rpx;
}

