.v3-hero {
  position: relative;
  overflow: hidden;
  background: var(--v3-color-surface-muted, #efece7);
}

.v3-hero-swiper,
.v3-hero-cover {
  width: 100%;
  height: 100%;
}

.v3-hero-slide,
.v3-hero-cover {
  position: relative;
  width: 100%;
  height: 100%;
}

.v3-hero-media {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.v3-hero-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, transparent 32%, var(--v3-hero-overlay, rgba(0, 0, 0, 0.32)) 100%);
}

.v3-hero-copy {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 12%;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 12rpx;
  padding: 0 var(--v3-space-page, 40rpx);
  color: var(--v3-color-on-media, #ffffff);
}

.v3-hero--minimal-cover .v3-hero-copy {
  align-items: center;
  text-align: center;
}

.v3-hero-category {
  font-size: 24rpx;
  letter-spacing: var(--v3-letter-spacing, 0.08em);
  opacity: 0.86;
}

.v3-hero-title {
  font-family: var(--v3-font-display, serif);
  font-weight: var(--v3-heading-weight, 600);
  font-size: 56rpx;
  letter-spacing: var(--v3-letter-spacing, 0.08em);
  line-height: 1.25;
}
