.v3-team {
  display: flex;
  gap: 32rpx;
  padding: var(--v3-space-section, 88rpx) var(--v3-space-page, 40rpx);
  overflow-x: auto;
}

.v3-team--portrait-grid {
  flex-wrap: wrap;
  overflow-x: hidden;
}

.v3-team-card {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 0 0 auto;
  width: 260rpx;
}

.v3-team--portrait-grid .v3-team-card {
  width: calc(50% - 16rpx);
}

.v3-team-media-wrap {
  position: relative;
  width: 100%;
  overflow: hidden;
  border-radius: var(--v3-radius-image, 12rpx);
  background: var(--v3-color-surface-muted, #efece7);
}

.v3-team--portrait .v3-team-media-wrap { padding-top: 133%; }
.v3-team--square .v3-team-media-wrap { padding-top: 100%; }

.v3-team-media {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.v3-team-media-empty {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--v3-font-display, serif);
  font-size: 48rpx;
  color: var(--v3-color-muted, #78716c);
}

.v3-team-name {
  margin-top: 12rpx;
  font-size: 28rpx;
  font-weight: var(--v3-heading-weight, 600);
  letter-spacing: var(--v3-letter-spacing, 0.04em);
}

.v3-team-role {
  font-size: 22rpx;
  color: var(--v3-color-muted, #78716c);
}

.v3-team-bio {
  font-size: 22rpx;
  color: var(--v3-color-muted, #78716c);
  line-height: 1.6;
}
