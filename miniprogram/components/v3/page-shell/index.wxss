/* page-shell：主题变量消费层（方案 §6.2）。所有区块通过 --v3-* 变量取色取距。 */
.v3-shell {
  min-height: 100vh;
  background: var(--v3-color-bg, #ffffff);
  color: var(--v3-color-text, #1c1917);
  font-family: var(--v3-font-body, -apple-system, "PingFang SC", sans-serif);
  font-size: 28rpx;
  line-height: 1.6;
}

.v3-shell-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 40vh;
  gap: 20rpx;
}

.v3-shell-loading-dot {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid var(--v3-color-divider, #e7e5e4);
  border-top-color: var(--v3-color-accent, #111111);
  border-radius: 50%;
  animation: v3-shell-spin 0.9s linear infinite;
}

.v3-shell-loading-text {
  font-size: 24rpx;
  color: var(--v3-color-muted, #78716c);
  letter-spacing: var(--v3-letter-spacing, 0.02em);
}

@keyframes v3-shell-spin {
  to { transform: rotate(360deg); }
}

/* 按钮风格档位（受控：仅 solid / outline / text 三档） */
.v3-shell .v3-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 18rpx 48rpx;
  border-radius: var(--v3-radius-button, 4rpx);
  font-size: 26rpx;
  letter-spacing: var(--v3-letter-spacing, 0.02em);
  background: var(--v3-color-accent, #111111);
  color: var(--v3-color-on-media, #ffffff);
  border: 2rpx solid var(--v3-color-accent, #111111);
}

.v3-shell--outline .v3-btn {
  background: transparent;
  color: var(--v3-color-accent, #111111);
}

.v3-shell--textbtn .v3-btn {
  background: transparent;
  border-color: transparent;
  color: var(--v3-color-accent, #111111);
  padding: 12rpx 8rpx;
}
