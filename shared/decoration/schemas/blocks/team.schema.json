{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "blocks/team.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "mediaRatio": { "type": "string", "enum": ["square", "portrait"], "default": "portrait", "label": "头像比例" },
