{
  "id": "modern-gallery",
  "name": "Modern Gallery",
  "displayName": "现代生活方式画廊",
  "version": "1.0.0",
  "description": "白底、大留白、杂志网格，跨人像、亲子、婚礼适用",
  "minEngineVersion": "3.1.0",
  "internal": false,
  "industryTags": [
    "wedding",
    "portrait",
    "kids"
  ],
  "preview": {
    "cover": "/editor/templates/modern-gallery/preview-cover.jpg",
    "pages": {
      "portfolio": "/editor/templates/modern-gallery/preview-portfolio.jpg",
      "series": "/editor/templates/modern-gallery/preview-series.jpg",
      "about": "/editor/templates/modern-gallery/preview-about.jpg",
      "packages": "/editor/templates/modern-gallery/preview-packages.jpg"
    }
  },
  "tokens": {
    "colorScheme": "warm-natural",
    "preset": "modern-gallery",
    "primaryColor": "#f5f5f4",
    "accentColor": "#7c6a5d",
    "backgroundColor": "#ffffff",
    "surfaceColor": "#f5f5f4",
    "textColor": "#292524",
    "mutedTextColor": "#78716c",
    "borderColor": "#e7e5e4",
    "fontFamily": {
      "body": "-apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif",
      "display": "-apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif"
    },
    "fontStyle": "modern-sans",
    "layoutDensity": "spacious",
    "cardStyle": "elevated",
    "buttonStyle": "solid",
    "imageRadius": "rounded",
    "imageMask": "none",
    "spacing": {
      "page": 24,
      "section": 64,
      "card": 16,
      "element": 12
    },
    "borderRadius": {
      "image": 8,
      "card": 12,
      "button": 8
    }
  },
  "brand": {
    "name": "",
    "nameEn": "",
    "slogan": ""
  },
  "navigation": {
    "entries": [
      {
        "pageKey": "portfolio",
        "label": "作品集",
        "visible": true
      },
      {
        "pageKey": "about",
        "label": "简介",
        "visible": true
      },
      {
        "pageKey": "packages",
        "label": "套餐",
        "visible": true
      },
      {
        "pageKey": "booking",
        "label": "咨询",
        "visible": true
      }
    ]
  },
  "pages": {
    "portfolio": {
      "blocks": [
        {
          "id": "portfolio-hero",
          "type": "hero",
          "variant": "minimal-cover",
          "enabled": true,
          "dataSource": {
            "type": "featured-series",
            "limit": 5
          },
          "settings": {
            "autoplay": true,
            "overlayMask": "light"
          }
        },
        {
          "id": "portfolio-categories",
          "type": "category-nav",
          "variant": "text-tabs",
          "enabled": true,
          "dataSource": {
            "type": "categories"
          },
          "settings": {
            "showCount": false,
            "sticky": true
          }
        },
        {
          "id": "portfolio-grid",
          "type": "portfolio-grid",
          "variant": "three-column",
          "enabled": true,
          "dataSource": {
            "type": "featured-series"
          },
          "settings": {
            "mediaRatio": "natural",
            "gap": "normal",
            "textPosition": "below",
            "showCategory": true,
            "showPhotoCount": true
          }
        },
        {
          "id": "portfolio-packages",
          "type": "package-list",
          "variant": "cards",
          "enabled": true,
          "dataSource": {
            "type": "packages"
          },
          "settings": {
            "showPrice": true,
            "showDescription": true
          }
        },
        {
          "id": "portfolio-contact",
          "type": "contact-footer",
          "variant": "minimal",
          "enabled": true,
          "dataSource": {
            "type": "contact"
          },
          "settings": {}
        }
      ]
    },
    "series": {
      "blocks": [
        {
          "id": "series-hero",
          "type": "hero",
          "variant": "minimal-cover",
          "enabled": true,
          "dataSource": {
            "type": "current-series"
          },
          "settings": {}
        },
        {
          "id": "series-gallery",
          "type": "series-gallery",
          "variant": "natural-flow",
          "enabled": true,
          "dataSource": {
            "type": "current-series"
          },
          "settings": {
            "gap": "normal",
            "fullscreenPreview": true,
            "showCaption": false
          }
        }
      ]
    },
    "about": {
      "blocks": [
        {
          "id": "about-brand",
          "type": "brand-intro",
          "variant": "centered",
          "enabled": true,
          "dataSource": {
            "type": "brand"
          },
          "settings": {
            "showSlogan": true
          }
        },
        {
          "id": "about-team",
          "type": "team",
          "variant": "horizontal-cards",
          "enabled": true,
          "dataSource": {
            "type": "team"
          },
          "settings": {
            "showBio": true,
            "showRole": true
          }
        },
        {
          "id": "about-service-flow",
          "type": "service-flow",
          "variant": "numbered",
          "enabled": true,
          "dataSource": {
            "type": "service-flow"
          },
          "settings": {
            "showDescription": true
          }
        },
        {
          "id": "about-testimonials",
          "type": "testimonials",
          "variant": "cards",
          "enabled": true,
          "dataSource": {
            "type": "testimonials",
            "limit": 6
          },
          "settings": {}
        },
        {
          "id": "about-contact",
          "type": "contact-footer",
          "variant": "minimal",
          "enabled": true,
          "dataSource": {
            "type": "contact"
          },
          "settings": {}
        }
      ]
    },
    "packages": {
      "blocks": [
        {
          "id": "packages-list",
          "type": "package-list",
          "variant": "cards",
          "enabled": true,
          "dataSource": {
            "type": "packages"
          },
          "settings": {
            "showPrice": true,
            "showDescription": true
          }
        },
        {
          "id": "packages-testimonials",
          "type": "testimonials",
          "variant": "quotes",
          "enabled": true,
          "dataSource": {
            "type": "testimonials",
            "limit": 3
          },
          "settings": {}
        }
      ]
    }
  },
  "requirements": {
    "minFeaturedSeries": 3,
    "minCategories": 2,
    "needsPackages": true,
    "needsTeam": false
  }
}
